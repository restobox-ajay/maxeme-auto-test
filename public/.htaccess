# index.html too: a static folder served beside the app (the dev server's /mockup/) opens on its index.
DirectoryIndex index.php index.html

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=BASE:%1]

    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    RewriteCond %{ENV:REDIRECT_STATUS} =""
    RewriteRule ^index\.php(?:/(.*)|$) %{ENV:BASE}/$1 [R=301,L]

    # The static mockup beside the app (dev server: /mockup/ links to its own checkout) is never the
    # app's: a missing file there is Apache's 404, not a Symfony one in the Error Log.
    RewriteRule ^mockup(/|$) - [L]

    # Real files and folders are served as they are (a folder such as /mockup/ by its index.html);
    # everything else goes to Symfony.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ %{ENV:BASE}/index.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        RedirectMatch 307 ^/$ /index.php/
    </IfModule>
</IfModule>
