{% extends 'admin/_main/layout.html.twig' %}
{% block title %}Payment Methods - {{ company.name }} | Admin{% endblock %}
{% block admin_body %}

    <section class="panel compact-panel">
        <h1>Payment Methods - {{ company.name }}</h1>
    </section>

    <nav class="company-action-links" aria-label="Customer detail actions">
        <a class="button" href="{{ path('admin_company_detail_by_id', {id: company.id}) }}">View</a>
        <a class="button" href="{{ path('admin_company_update', {id: company.id}) }}">Edit Profile</a>
        <a class="button" href="{{ path('admin_company_address_book', {id: company.id}) }}">Address Book</a>
        <a class="button is-current" href="{{ path('admin_company_payment_methods_by_id', {id: company.id}) }}">Payment Methods</a>
        <a class="button" href="{{ path('admin_company_address_create', {id: company.id}) }}">Add Address</a>
        <span class="company-action-more row-action-menu">
            <button class="mini-action row-action-toggle" type="button" aria-expanded="false" aria-label="More customer actions"></button>
            <span class="row-action-dropdown company-action-dropdown">
                <a href="{{ path('admin_order_index', {OrderSearch: {company_id: company.id}}) }}">View Orders</a>
                <a href="{{ path('admin_order_create', {OrderSearch: {company_id: company.id}}) }}">Create Order</a>
            </span>
        </span>
    </nav>

    <section class="table-card">
        <div class="table-header">
            <div>
                <h2>Payment Methods</h2>
                <p>{{ rows|length }} available {{ rows|length == 1 ? 'method' : 'methods' }}. A method is enabled unless explicitly deactivated below.</p>
            </div>
        </div>
        <div class="wide-table-wrap">
            <table class="admin-grid-table data-table">
                <thead>
                    <tr>
                        <th>Payment Method</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <td>{{ row.paymentMethod.name }}</td>
                            <td><span class="badge {{ row.status == 'Inactive' ? 'danger' : '' }}">{{ row.status }}</span></td>
                            <td class="row-actions">
                                <form method="post" action="{{ path('admin_company_payment_method_toggle', {companyId: company.id, paymentMethodId: row.paymentMethod.id}) }}">
                                    {{ csrf_field() }}
                                    <input type="hidden" name="return" value="company">
                                    <button type="submit" class="link-button{{ row.status == 'Active' ? ' danger' : '' }}">
                                        {{ row.status == 'Active' ? 'Deactivate' : 'Activate' }}
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="empty-row">No payment methods are configured in the system yet.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

{% endblock %}
