{% for row in rows %}
    <tr>
        <td data-label="Name"><strong>{{ row.name }}</strong></td>
        <td data-label="Status">
            <span class="badge {{ row.status|lower in ['inactive', 'disabled'] ? 'danger-soft' : 'success' }}">{{ row.status|default('Active') }}</span>
        </td>
        <td data-label="Actions">
            <div class="row-actions">
                <a class="table-action" href="{{ path('admin_credit_memo_type_update', {id: row.id}) }}">Edit</a>
                <button class="table-action danger js-delete" type="button" data-url="{{ path('admin_credit_memo_type_delete', {id: row.id}) }}" data-token="{{ csrf_token_value() }}" data-item="{{ row.name }} credit memo type">Delete</button>
            </div>
        </td>
    </tr>
{% else %}
    <tr>
        <td colspan="3" class="empty-table-cell">
            <strong>No credit memo types found.</strong>
            <span>Add memo reason types such as Spoiled Product, Invoicing Error, or Other.</span>
        </td>
    </tr>
{% endfor %}
