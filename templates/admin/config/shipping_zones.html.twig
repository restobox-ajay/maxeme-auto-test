{% extends 'admin/_main/layout.html.twig' %}
{% block title %}Shipping Zones | Admin{% endblock %}
{% block admin_body %}
    <section class="panel compact-panel">
        <div class="panel-title-row">
            <div>
                <p class="eyebrow">Configuration</p>
                <h1>Shipping Zones</h1>
            </div>
	            <div class="panel-actions">
	                <a class="button back-button" href="{{ path('admin_settings') }}">Back</a>
	                <a class="button primary" href="{{ path('admin_shipping_zone_create') }}">Create Zone</a>
	            </div>
	        </div>
	    </section>

    {% set currentSort = currentSort|default('') %}
    {% set currentDir = currentDir|default('asc') %}
    {% set currentPage = page|default(1) %}
    {% set currentLimit = limit|default(10) %}
    {% set pageCount = max(1, (total|default(rows|length) / (currentLimit ?: 1))|round(0, 'ceil')) %}
    {% set routeQuery = {q: search|default(''), sort: currentSort, dir: currentDir, limit: currentLimit, filters: filters|default({})} %}
    {% set pageSizes = [20, 100, 200, 500] %}
    <section class="table-card shipping-zone-admin-grid no-paginate" data-current-page="{{ currentPage }}" data-per-page="{{ currentLimit }}">
        <form method="get" action="{{ path('admin_shipping_zones') }}" class="js-auto-submit-form">
            <input type="hidden" name="page" value="1">
            <input type="hidden" name="sort" value="{{ currentSort }}">
            <input type="hidden" name="dir" value="{{ currentDir }}">
            <button type="submit" hidden aria-hidden="true" tabindex="-1"></button>
        <div class="table-scroll-region">
        <div class="wide-table-wrap">
            <table class="admin-grid-table">
                <thead>
                    <tr>
                        <th class="sort-handle-column"></th>
                        <th class="is-sortable{% if currentSort == 'area_name' %} is-sorted-{{ currentDir }}{% endif %}" data-sort-field="area_name"><a href="{{ path('admin_shipping_zones', {q: search|default(''), sort: 'area_name', dir: currentSort == 'area_name' and currentDir == 'asc' ? 'desc' : 'asc', limit: limit|default(10), page: 1, filters: filters|default({})}) }}">Area Name</a></th>
                        <th class="is-sortable{% if currentSort == 'delivery_days' %} is-sorted-{{ currentDir }}{% endif %}" data-sort-field="delivery_days"><a href="{{ path('admin_shipping_zones', {q: search|default(''), sort: 'delivery_days', dir: currentSort == 'delivery_days' and currentDir == 'asc' ? 'desc' : 'asc', limit: limit|default(10), page: 1, filters: filters|default({})}) }}">Delivery Days</a></th>
                        <th class="is-sortable{% if currentSort == 'free_shipping_minimum' %} is-sorted-{{ currentDir }}{% endif %}" data-sort-field="free_shipping_minimum"><a href="{{ path('admin_shipping_zones', {q: search|default(''), sort: 'free_shipping_minimum', dir: currentSort == 'free_shipping_minimum' and currentDir == 'asc' ? 'desc' : 'asc', limit: limit|default(10), page: 1, filters: filters|default({})}) }}">Free Shipping Minimum</a></th>
                        <th class="is-sortable{% if currentSort == 'delivery_fee' %} is-sorted-{{ currentDir }}{% endif %}" data-sort-field="delivery_fee"><a href="{{ path('admin_shipping_zones', {q: search|default(''), sort: 'delivery_fee', dir: currentSort == 'delivery_fee' and currentDir == 'asc' ? 'desc' : 'asc', limit: limit|default(10), page: 1, filters: filters|default({})}) }}">Delivery Fee</a></th>
                        <th class="is-sortable{% if currentSort == 'status' %} is-sorted-{{ currentDir }}{% endif %}" data-sort-field="status"><a href="{{ path('admin_shipping_zones', {q: search|default(''), sort: 'status', dir: currentSort == 'status' and currentDir == 'asc' ? 'desc' : 'asc', limit: limit|default(10), page: 1, filters: filters|default({})}) }}">Status</a></th>
                        <th>Actions</th>
                    </tr>
                    <tr class="filter-row">
                        <th></th>
                        <th><input type="text" name="filters[area_name]" value="{{ filters.area_name|default('') }}" aria-label="Filter area"></th>
                        <th><input type="text" name="filters[delivery_days]" value="{{ filters.delivery_days|default('') }}" aria-label="Filter delivery days"></th>
                        <th><input type="text" name="filters[free_shipping_minimum]" value="{{ filters.free_shipping_minimum|default('') }}" aria-label="Filter free shipping minimum"></th>
                        <th><input type="text" name="filters[delivery_fee]" value="{{ filters.delivery_fee|default('') }}" aria-label="Filter delivery fee"></th>
                        <th><input type="text" name="filters[status]" value="{{ filters.status|default('') }}" aria-label="Filter status"></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody class="js-sortable-config" data-reorder-url="{{ path('admin_shipping_zone_reorder') }}" data-reorder-token="{{ csrf_token_value() }}">
                    {% include 'admin/config/_shipping_zone_rows.html.twig' with {rows: rows} %}
                </tbody>
            </table>
        </div>
        </div>
        <div class="table-footer">
            <label class="per-page-label">
                Per page
                <select name="limit" onchange="this.form.submit()">
                    {% for size in pageSizes %}
                        <option value="{{ size }}" {{ currentLimit == size ? 'selected' : '' }}>{{ size }}</option>
                    {% endfor %}
                </select>
            </label>
            {% include 'admin/_table_count.html.twig' with {
                count: rows|length,
                total: total|default(rows|length),
                currentPage: currentPage,
                perPage: currentLimit
            } only %}
            {% include 'admin/_pagination.html.twig' with {
                routeName: 'admin_shipping_zones',
                routeQuery: routeQuery,
                currentPage: currentPage,
                pageCount: pageCount
            } only %}
        </div>
        </form>
    </section>
{% endblock %}
