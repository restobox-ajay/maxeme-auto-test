{% extends 'admin/_main/layout.html.twig' %}
{% block title %}Sales Tax | Admin{% endblock %}
{% block admin_body %}
    <section class="panel compact-panel">
        <div class="panel-title-row">
            <div>
                <p class="eyebrow">Configuration</p>
                <h1>Sales Tax</h1>
            </div>
            <div class="panel-actions">
                <a class="button back-button" href="{{ path('admin_settings') }}">Back</a>
                <a class="button primary" href="{{ path('admin_sales_tax_create') }}">Create Tax</a>
            </div>
        </div>
    </section>

    {% set currentSort = currentSort|default('') %}
    {% set currentDir = currentDir|default('asc') %}
    {% set currentPage = page|default(1) %}
    {% set currentLimit = limit|default(10) %}
    {% set pageCount = max(1, (total|default(rows|length) / (currentLimit ?: 1))|round(0, 'ceil')) %}
    {% set routeQuery = {q: search|default(''), sort: currentSort, dir: currentDir, limit: currentLimit, filters: filters|default({})} %}
    {% set pageSizes = [20, 100, 200, 500] %}
    <section class="table-card sales-tax-admin-grid no-paginate" data-current-page="{{ currentPage }}" data-per-page="{{ currentLimit }}">
        <form method="get" action="{{ path('admin_sales_tax') }}" class="js-auto-submit-form">
            <input type="hidden" name="page" value="1">
            <input type="hidden" name="sort" value="{{ currentSort }}">
            <input type="hidden" name="dir" value="{{ currentDir }}">
            <button type="submit" hidden aria-hidden="true" tabindex="-1"></button>
        <div class="table-scroll-region">
        <div class="wide-table-wrap">
            <table class="admin-grid-table">
                <thead>
                    <tr>
                        <th class="is-sortable{% if currentSort == 'province_name' %} is-sorted-{{ currentDir }}{% endif %}" data-sort-field="province_name"><a href="{{ path('admin_sales_tax', {q: search|default(''), sort: 'province_name', dir: currentSort == 'province_name' and currentDir == 'asc' ? 'desc' : 'asc', limit: limit|default(10), page: 1, filters: filters|default({})}) }}">Province</a></th>
                        <th class="is-sortable{% if currentSort == 'abbreviation' %} is-sorted-{{ currentDir }}{% endif %}" data-sort-field="abbreviation"><a href="{{ path('admin_sales_tax', {q: search|default(''), sort: 'abbreviation', dir: currentSort == 'abbreviation' and currentDir == 'asc' ? 'desc' : 'asc', limit: limit|default(10), page: 1, filters: filters|default({})}) }}">Abbreviation</a></th>
                        <th class="is-sortable{% if currentSort == 'tax_type' %} is-sorted-{{ currentDir }}{% endif %}" data-sort-field="tax_type"><a href="{{ path('admin_sales_tax', {q: search|default(''), sort: 'tax_type', dir: currentSort == 'tax_type' and currentDir == 'asc' ? 'desc' : 'asc', limit: limit|default(10), page: 1, filters: filters|default({})}) }}">Tax Type</a></th>
                        <th class="is-sortable{% if currentSort == 'rate' %} is-sorted-{{ currentDir }}{% endif %}" data-sort-field="rate"><a href="{{ path('admin_sales_tax', {q: search|default(''), sort: 'rate', dir: currentSort == 'rate' and currentDir == 'asc' ? 'desc' : 'asc', limit: limit|default(10), page: 1, filters: filters|default({})}) }}">Rate</a></th>
                        <th class="is-sortable{% if currentSort == 'status' %} is-sorted-{{ currentDir }}{% endif %}" data-sort-field="status"><a href="{{ path('admin_sales_tax', {q: search|default(''), sort: 'status', dir: currentSort == 'status' and currentDir == 'asc' ? 'desc' : 'asc', limit: limit|default(10), page: 1, filters: filters|default({})}) }}">Status</a></th>
                        <th>Source</th>
                        <th>Actions</th>
                    </tr>
                    <tr class="filter-row">
                        <th><input type="text" name="filters[province_name]" value="{{ filters.province_name|default('') }}" aria-label="Filter province"></th>
                        <th><input type="text" name="filters[abbreviation]" value="{{ filters.abbreviation|default('') }}" aria-label="Filter abbreviation"></th>
                        <th><input type="text" name="filters[tax_type]" value="{{ filters.tax_type|default('') }}" aria-label="Filter tax type"></th>
                        <th><input type="text" name="filters[rate]" value="{{ filters.rate|default('') }}" aria-label="Filter rate"></th>
                        <th><input type="text" name="filters[status]" value="{{ filters.status|default('') }}" aria-label="Filter status"></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% include 'admin/config/_sales_tax_rows.html.twig' with {rows: rows} %}
                </tbody>
            </table>
        </div>
        </div>
        <div class="table-footer">
            <label class="per-page-label">
                Per page
                <select name="limit" onchange="this.form.submit()">
                    {% for size in pageSizes %}
                        <option value="{{ size }}" {{ currentLimit == size ? 'selected' : '' }}>{{ size }}</option>
                    {% endfor %}
                </select>
            </label>
            {% include 'admin/_table_count.html.twig' with {
                count: rows|length,
                total: total|default(rows|length),
                currentPage: currentPage,
                perPage: currentLimit
            } only %}
            {% include 'admin/_pagination.html.twig' with {
                routeName: 'admin_sales_tax',
                routeQuery: routeQuery,
                currentPage: currentPage,
                pageCount: pageCount
            } only %}
        </div>
        </form>
    </section>
{% endblock %}
