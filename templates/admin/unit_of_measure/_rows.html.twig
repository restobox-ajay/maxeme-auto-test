{% for row in rows %}
    <tr class="data-item-row">
        <td data-label="Code"><strong>{{ row.unit.code }}</strong></td>
        <td data-label="Name">{{ row.unit.name }}</td>
        <td data-label="Family">{{ row.unit.family }}</td>
        <td data-label="To family base">{{ row.unit.factorToFamilyBase }}</td>
        <td data-label="Rounding">{{ row.unit.roundingPrecision }}{% if row.unit.wholeNumbersOnly %} <small>whole numbers only</small>{% endif %}</td>
        {# `table.column (count)`, exactly as the refusal message names them — the admin who is told
           a unit is frozen can see from the grid what is holding it. #}
        <td data-label="Referenced by">{% if row.references|length == 0 %}&mdash;{% else %}{% for label, count in row.references %}{{ label }} ({{ count }}){{ loop.last ? '' : ', ' }}{% endfor %}{% endif %}</td>
        <td data-label="Actions">
            {# One control per row, opened by the browser rather than by app.js — see
               admin/_row_actions_no_js.html.twig for why this is <details> and not the
               `.row-action-toggle` the other grids use.

               The delete form is emitted in the cell: the filter form above is closed before the
               table starts, so nothing nests. #}
            <details class="row-action-menu no-js-row-actions">
                <summary class="table-action" aria-label="Actions for {{ row.unit.code }}">Actions</summary>
                <div class="row-action-dropdown">
                    <a href="{{ path('admin_product_unit_of_measure_edit', {id: row.unit.id}) }}">Edit</a>
                    {# Offered only where UnitOfMeasureService would allow it, so the menu does not
                       hold a button whose only outcome is a refusal. The service refuses it again
                       regardless — the guard is there, not here. #}
                    {% if row.references|length == 0 %}
                        <form method="post" action="{{ path('admin_product_unit_of_measure_delete', {id: row.unit.id}) }}">
                            {{ csrf_field() }}
                            <button class="danger" type="submit">Delete</button>
                        </form>
                    {% endif %}
                </div>
            </details>
        </td>
    </tr>
{% else %}
    <tr>
        <td colspan="7" class="empty-table-cell">
            <strong>No units of measure yet.</strong>
            <span>Add one to give the application's quantities something to be counted in.</span>
        </td>
    </tr>
{% endfor %}
