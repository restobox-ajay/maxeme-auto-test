{% extends 'admin/_main/layout.html.twig' %}
{% block title %}Set Password — {{ target.email }} | Admin{% endblock %}
{% block admin_body %}

    {% set backRoute = targetType == 'customer' ? 'admin_user_customer_index' : 'admin_user_staff_index' %}

    <section class="panel compact-panel">
        <div class="panel-title-row">
            <div>
                <p class="eyebrow">Users</p>
                <h1>Set Password</h1>
            </div>
            <div class="panel-actions">
                <a class="button back-button" href="{{ path(backRoute) }}">Back</a>
            </div>
        </div>
    </section>

    {% for message in app.flashes('error') %}
        <div class="alert error">{{ message }}</div>
    {% endfor %}

    {# Shown once. The controller removes it from the session as it renders, so refreshing the page
       does not put the password back on screen. #}
    {% if issued %}
        <section class="panel compact-panel issued-password-panel">
            <h2 style="margin-top:0;">Password set for {{ issued.email }}</h2>
            <p class="muted">
                {% if issued.generated %}Generated{% else %}As typed{% endif %} — shown once.
                Reloading will not show it again, and it is not stored anywhere in readable form.
            </p>
            <p class="issued-password-value"><code id="issued-password">{{ issued.password }}</code></p>
            <button class="button" type="button" id="copy-issued-password">Copy</button>
            <p class="muted" style="margin-top:10px;">
                They can sign in with this now. Any reset link previously emailed to them has been cancelled.
            </p>
        </section>
    {% endif %}

    <section class="form-card">
        <dl class="detail-grid">
            <dt>User</dt>
            <dd><strong>{{ target.email }}</strong></dd>
            <dt>Name</dt>
            <dd>{{ ((target.firstName ?: '') ~ ' ' ~ (target.lastName ?: ''))|trim ?: '-' }}</dd>
            <dt>Type</dt>
            <dd>{{ targetType == 'customer' ? 'Customer' : 'Staff' }} &mdash; {{ targetRole }}</dd>
            <dt>{{ targetType == 'customer' ? 'Customer' : 'Area' }}</dt>
            <dd>{{ targetContext }}</dd>
            <dt>Status</dt>
            <dd>{{ target.status }}</dd>
        </dl>

        <form method="post" action="{{ path('admin_user_set_password_apply') }}" class="form-grid">
            {{ csrf_field() }}
            <input type="hidden" name="type" value="{{ targetType }}">
            <input type="hidden" name="id" value="{{ target.id }}">

            <label class="span-2">
                <span>New password</span>
                {# autocomplete="off" plus the password-manager opt-outs, and a text field rather than a
                   masked one: the admin is typing someone else's password in order to read it back, so
                   a browser offering to suggest or save one would file it under the admin's own
                   credentials. #}
                <input type="text" name="password" minlength="8"
                       autocomplete="off" autocorrect="off" autocapitalize="off"
                       spellcheck="false" data-lpignore="true" data-1p-ignore data-form-type="other"
                       placeholder="At least 8 characters">
                <small>Or leave this blank and press Generate.</small>
            </label>

            <div class="form-actions">
                <button class="button primary" type="submit" name="mode" value="typed">Set Password</button>
                <button class="button" type="submit" name="mode" value="generate" formnovalidate>Generate</button>
            </div>
        </form>
    </section>

{% endblock %}

{% block body_end %}
    {{ parent() }}
    <script>
        // Copy-to-clipboard for the issued password. Inline rather than in app.js, which is shared with
        // the customer side and has no business knowing about this screen.
        (function () {
            var button = document.getElementById('copy-issued-password');
            if (!button) { return; }
            button.addEventListener('click', function () {
                var value = document.getElementById('issued-password').textContent;
                if (navigator.clipboard) {
                    navigator.clipboard.writeText(value).then(function () {
                        button.textContent = 'Copied';
                    });
                }
            });
        })();
    </script>
{% endblock %}
