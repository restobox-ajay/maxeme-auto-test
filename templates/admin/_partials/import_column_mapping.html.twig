{#
    Shared column-mapping screen for any import built on the unified import framework (see
    docs/plans/2026-09-18-unified-import-framework.md). A concrete import's controller renders this
    directly (not `{% extends %}`) with:

      heading       string  e.g. "Match columns: acme-prices.csv"
      lead          string  e.g. "Say which column answers each field. Acme Corp's choice is
                              remembered, so the next sheet from them pre-fills automatically."
      confirmPath   string  the form's POST action (result of path(...))
      cancelPath    string  "Start over" link target (result of path(...))
      rows          list    ColumnMapper::formRows()/rowsForMapping()'s return value
      headers       list<string> detected in the uploaded file
      error         string|null  why confirm() bounced the admin back here (missing required
                                   field, a whole-file rejection, ...) — rendered here, not only
                                   flashed, so it is visible without JS (see base.html.twig's
                                   `.flash-messages` div, `hidden` until app.js's showToast() reads
                                   it — a redirect-back-with-nothing-inline left a no-JS admin with
                                   no explanation at all)
      hiddenFields  array<string,string>|null  extra hidden inputs the confirm step needs
                                                 (token, filename, vendor_id, ...)
#}
{% extends 'admin/_main/layout.html.twig' %}
{% block title %}{{ heading }} | Admin{% endblock %}
{% block admin_body %}

    <section class="panel compact-panel">
        <div class="panel-title-row">
            <div>
                <p class="eyebrow">Import</p>
                <h1>{{ heading }}</h1>
            </div>
        </div>
    </section>

    {% if error is defined and error %}
        <section class="panel compact-panel panel-error">
            <p>{{ error }}</p>
        </section>
    {% endif %}

    <section class="panel compact-panel">
        <form method="post" action="{{ confirmPath }}">
            {{ csrf_field() }}
            {% for key, value in hiddenFields|default({}) %}
                <input type="hidden" name="{{ key }}" value="{{ value }}">
            {% endfor %}

            {% for row in rows %}
                <label>{{ row.label }}{{ row.required ? ' (required)' : ' (optional)' }}
                    <select name="column_map[{{ row.key }}]">
                        <option value="">&mdash; not in this file &mdash;</option>
                        {% for header in headers %}
                            {# `same as`, not `==`: a file can have a literally blank header (a
                               spreadsheet artifact column), and PHP/Twig's loose `==` treats
                               `null == ''` as true — an unmapped field (row.selected is null)
                               would then wrongly pre-select that blank column instead of leaving
                               "-- not in this file --" selected. #}
                            <option value="{{ header }}"{{ row.selected is same as(header) ? ' selected' : '' }}>{{ header }}</option>
                        {% endfor %}
                    </select>
                </label>
            {% endfor %}

            <button class="button primary" type="submit">Import</button>
            <a class="button" href="{{ cancelPath }}">Start over</a>
        </form>
    </section>

{% endblock %}
