{# The Actions cell of a QUOTE line row — see templates/admin/order/_line_actions.html.twig for why
   each document keeps its own.

   Rendered with {index, kind, showRemove, line, column, labelled}. #}
<td{% if labelled %} data-label="{{ column.label|default('') }}"{% endif %}>
    {# The same equally-sized round controls order's line rows use, rather than an icon next to a
       full-width text button — the Actions column is only wide enough for 26px pills. #}
    <div class="estimate-line-controls">
        {# No per-row "+" here on purpose. There used to be one, described as mirroring order's
           .js-order-add-after — which it did not: order's appends a BATCH SUB-ROW to the line, while
           this one cloned a whole product line. Two identical-looking glyphs in the same column doing
           unrelated things, with a comment asserting they matched. Removed rather than relabelled
           (#245); the bottom "Add Line" control already adds lines to a quote. #}
        {% if kind == 'product' %}
        {# Opens the row's currently-selected product in the product edit page. The href is rendered
           server-side here and re-synced client-side whenever the row's product changes (see the
           .js-estimate-product-select change handler in app.js), mirroring order's
           .js-order-search-product / syncOrderProductEditLink pattern. #}
        <a class="mini-action info js-estimate-search-product"
            data-product-edit-url-template="{{ path('admin_product_inventory_update', {id: '__PRODUCT_ID__'}) }}"
            {% if line.productId|default('') %}href="{{ path('admin_product_inventory_update', {id: line.productId}) }}"{% else %}hidden{% endif %}
            target="_blank" rel="noopener" aria-label="Open product in a new tab">
            <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <circle cx="8.5" cy="8.5" r="5.2"></circle>
                <path d="M12.3 12.3 17 17"></path>
            </svg>
        </a>
        {% endif %}
        <button class="mini-action danger js-estimate-remove-line js-only" type="button" aria-label="Remove line">x</button>
        {# Without JS the button above can't do anything, so the row also carries a real submit that
           posts the row's index and lets the server drop it — order's line rows pair the same two
           controls. #}
        {% if showRemove %}
            <button class="mini-action danger no-js-inline" type="submit" name="remove_line" value="{{ index }}" aria-label="Remove line">x</button>
        {% endif %}
    </div>
</td>
