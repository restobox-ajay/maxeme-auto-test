{# The invoice's own fields, on the EDIT screen for an existing standalone Draft — the sibling of
   _standalone_context.html.twig, delegated as its own template PATH rather than an `{% if %}`
   inside that one, matching the outer template's own rule for `contextTemplate`: "a different set
   of fields posting to a different save" is a path, not a flag. The fields posted are identical to
   the create screen's — this only differs in what a box shows on the way in.

   The two things a fresh create screen cannot show and this one exists to show:

     the invoice's OWN values     every box below reads {{ invoice.poNumber }} and so on, not blank
     the FROZEN addresses         invoice.getBillingAddress()/getShippingAddress(), never the
                                  company's current address book — see the footer note below for why

   Rendered with {invoice, company, order, paymentMethods, paymentTerms, fulfillmentRegions}. #}
<div class="order-workspace-grid">
    <section class="order-form-panel">
        <h2>Invoice Info</h2>
        <div class="order-field-row static">
            <label>Customer:</label>
            <strong>{{ company.name }}</strong>
        </div>
        <div class="order-field-row static">
            <label>Sales Order:</label>
            {% if order %}
                <strong><a href="{{ path('admin_order_detail', {id: order.id}) }}">{{ order.orderNumber }}</a></strong>
            {% else %}
                <strong>None — this invoice stands alone</strong>
            {% endif %}
        </div>
        <label class="order-field-row">
            <span>Invoice Date:</span>
            <input type="date" name="invoice_date" value="{{ invoice.invoiceDate }}">
        </label>
        <label class="order-field-row">
            <span>Due Date:</span>
            <input type="date" name="due_date" value="{{ invoice.dueDate }}">
        </label>
        <label class="order-field-row">
            <span>PO #:</span>
            <input type="text" name="po_number" maxlength="80" value="{{ invoice.poNumber }}">
        </label>
        <label class="order-field-row">
            <span>Payment Method:</span>
            <select name="payment_method">
                <option value=""></option>
                {% for method in paymentMethods %}
                    <option value="{{ method.name }}"{{ method.name == invoice.paymentMethod ? ' selected' : '' }}>{{ method.name }}</option>
                {% endfor %}
            </select>
        </label>
        <label class="order-field-row">
            <span>Payment Term:</span>
            <select name="payment_term">
                <option value=""></option>
                {% for term in paymentTerms %}
                    <option value="{{ term.name }}"{{ term.name == invoice.paymentTerm ? ' selected' : '' }}>{{ term.name }}</option>
                {% endfor %}
            </select>
        </label>
        <label class="order-field-row">
            <span>Fulfillment Region:</span>
            {% if fulfillmentRegions is not empty %}
                <select name="fulfillment_region">
                    {% if fulfillmentRegions|length != 1 %}<option value=""></option>{% endif %}
                    {% for region in fulfillmentRegions %}
                        <option value="{{ region }}"{{ region == invoice.fulfillmentRegion ? ' selected' : '' }}>{{ region }}</option>
                    {% endfor %}
                </select>
            {% else %}
                <input type="text" name="fulfillment_region" value="{{ invoice.fulfillmentRegion }}" placeholder="No regions configured for this customer">
            {% endif %}
        </label>
        <label class="order-field-row">
            <span>Special Instructions:</span>
            <input type="text" name="special_instructions" value="{{ invoice.specialInstructions }}">
        </label>
    </section>

    {# The addresses this invoice ALREADY FROZE, at the moment it was first raised — not the
       company's address book, which may have changed since. Read off the invoice's own address
       rows (Invoice::getBillingAddress()/getShippingAddress()) rather than the company's default,
       for the same reason the create screen's footer note gives: an invoice is the record of who
       was billed and where the goods went, and this screen must show what that record actually
       says, not what a live lookup would say today. Editing them is not offered here — the company
       and its addresses stay frozen through an edit, same as create() states in its own docblock —
       so this section is read-only exactly as it is on the create screen. #}
    <section class="order-form-panel">
        <h2>Billing Address</h2>
        {% set billingAddress = invoice.billingAddress %}
        {% if billingAddress %}
            <p class="lead" style="margin:0;">
                {{ billingAddress.companyName ?: company.name }}<br>
                {% set billingContact = (billingAddress.firstName ~ ' ' ~ billingAddress.lastName)|trim %}
                {% if billingContact %}{{ billingContact }}<br>{% endif %}
                {{ billingAddress.addressLine1 }}{% if billingAddress.addressLine2 %}<br>{{ billingAddress.addressLine2 }}{% endif %}<br>
                {{ billingAddress.city }} {{ billingAddress.province }} {{ billingAddress.postalCode }}<br>
                {{ billingAddress.country }}
            </p>
        {% else %}
            <p class="lead" style="margin:0;">This invoice was raised with no billing address.</p>
        {% endif %}
        <h2 style="margin-top:16px;">Shipping Address</h2>
        {% set shippingAddress = invoice.shippingAddress %}
        {% if shippingAddress %}
            <p class="lead" style="margin:0;">
                {{ shippingAddress.companyName ?: company.name }}<br>
                {% set shippingContact = (shippingAddress.firstName ~ ' ' ~ shippingAddress.lastName)|trim %}
                {% if shippingContact %}{{ shippingContact }}<br>{% endif %}
                {{ shippingAddress.addressLine1 }}{% if shippingAddress.addressLine2 %}<br>{{ shippingAddress.addressLine2 }}{% endif %}<br>
                {{ shippingAddress.city }} {{ shippingAddress.province }} {{ shippingAddress.postalCode }}<br>
                {{ shippingAddress.country }}
            </p>
        {% else %}
            <p class="lead" style="margin:0;">This invoice was raised with no shipping address.</p>
        {% endif %}
        <p class="lead" style="margin:12px 0 0; font-size:0.78rem;">
            Frozen when this invoice was raised. Editing lines and fields here never changes it —
            correct the customer's address book instead, before raising the next invoice.
        </p>
    </section>
</div>
