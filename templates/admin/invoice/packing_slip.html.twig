{% extends is_pdf ? 'admin/_main/pdf_layout.html.twig' : 'admin/_main/layout.html.twig' %}
{% block title %}Packing Slip: {{ invoice.documentNumber }} | Admin{% endblock %}

{#
    The packing slip, which belongs to the INVOICE (#539 stage 6).

    It lists the goods actually going out, and since #539 that is a per-invoice question: an order
    billed across three invoices ships across three deliveries, and a slip listing the whole order
    would be right at most once. It mirrors the invoice's product list on purpose — the same rows,
    without the money, which is the whole difference between the two documents.
#}

{% block admin_body %}
    {% set order = invoice.salesOrder %}
    {% if not is_pdf %}
    {# The same hero the invoice document and the invoice detail page carry. Without it this screen
       was the only one of the four that opened straight onto its tab bar, with nothing on the page
       naming which invoice you were looking at. #}
    <section class="panel compact-panel no-print" style="margin-bottom:0; border-bottom:0; border-radius:var(--radius-md) var(--radius-md) 0 0;">
        <div class="panel-title-row">
            <div>
                <p class="eyebrow">Packing slip</p>
                <h1>{{ invoice.documentNumber }}</h1>
            </div>
            <div class="panel-actions">
                <a class="button back-button" href="{{ path('admin_invoice_detail', {id: invoice.id}) }}">Back</a>
            </div>
        </div>
    </section>
    {% include 'admin/invoice/_tab_nav.html.twig' with {invoice: invoice, current: 'packing-slip', printable: true} only %}
    <div class="invoice-page-container">
    {% endif %}

        <!-- Packing Slip Document -->
        <div class="slip-document {% if not is_pdf %}shadow-lg{% endif %}">
            {# ── Header (slim by design — see issue #35: the item table must start high on
                   page 1, so the title bar is text-only with no logo tile) ── #}
            <table style="width: 100%; background: #0f172a; border-collapse: collapse; margin: 0; padding: 0;">
                <tr>
                    <td style="padding: 7px 16px; vertical-align: middle;">
                        <span style="font-size: 13px; font-weight: bold; color: #ffffff;">{{ site_name() }}</span>
                    </td>
                    <td style="padding: 7px 16px; text-align: right; vertical-align: middle; font-size: 16px; font-weight: bold; color: #ffffff;">Packing Slip</td>
                </tr>
            </table>
            <div style="height: 3px; background: #1d4ed8; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important;"></div>

            <div style="padding: 12px 16px 14px;"> <!-- Content wrapper -->

            <table style="width: 100%; margin-bottom: 8px; table-layout: fixed; border-collapse: collapse;">
                <tr>
                    <td style="vertical-align: top; padding-right: 12px; width: 33%;">
                        <div style="font-size: 8px; text-transform: uppercase; font-weight: bold; color: #1d4ed8; margin-bottom: 3px; border-bottom: 1px solid #1d4ed8; padding-bottom: 2px;">Order Info</div>
                        <table style="width: 100%; font-size: 8.5px; border-collapse: collapse;">
                            <tr><td style="color: #64748b; padding: 1px 0;">Invoice #:</td><td style="text-align: right; color: #1e293b;"><strong>{{ invoice.documentNumber }}</strong></td></tr>
                            <tr><td style="color: #64748b; padding: 1px 0;">Order #:</td><td style="text-align: right; color: #1e293b;"><strong>{{ order ? order.orderNumber : '-' }}</strong></td></tr>
                            <tr><td style="color: #64748b; padding: 1px 0;">Date:</td><td style="text-align: right; color: #1e293b;"><strong>{{ invoice.invoiceDate ?: invoice.documentDate }}</strong></td></tr>
                            <tr><td style="color: #64748b; padding: 1px 0;">PO #:</td><td style="text-align: right; color: #1e293b;"><strong>{{ invoice.poNumber|default('-') }}</strong></td></tr>
                        </table>
                    </td>
                    <td style="vertical-align: top; padding: 0 6px; width: 34%;">
                        <div style="font-size: 8px; text-transform: uppercase; font-weight: bold; color: #1d4ed8; margin-bottom: 3px; border-bottom: 1px solid #1d4ed8; padding-bottom: 2px;">Customer</div>
                        <table style="width: 100%; font-size: 8.5px; border-collapse: collapse;">
                            <tr><td style="color: #64748b; padding: 1px 0;">Name:</td><td style="text-align: right; color: #1e293b;"><strong>{{ invoice.companyIdentity.name }}</strong></td></tr>
                            <tr><td style="color: #64748b; padding: 1px 0;">Client ID:</td><td style="text-align: right; color: #1e293b;"><strong>{{ invoice.company.id }}</strong></td></tr>
                        </table>
                    </td>
                    <td style="vertical-align: top; padding-left: 12px; width: 33%;">
                        <div style="font-size: 8px; text-transform: uppercase; font-weight: bold; color: #1d4ed8; margin-bottom: 3px; border-bottom: 1px solid #1d4ed8; padding-bottom: 2px;">Shipment</div>
                        <table style="width: 100%; font-size: 8.5px; border-collapse: collapse;">
                            <tr><td style="color: #64748b; padding: 1px 0;">Method:</td><td style="text-align: right; color: #1e293b;"><strong>Standard</strong></td></tr>
                            <tr><td style="color: #64748b; padding: 1px 0;">Weight:</td><td style="text-align: right; color: #1e293b;"><strong>-</strong></td></tr>
                        </table>
                    </td>
                </tr>
            </table>

            <table style="width: 100%; margin-bottom: 8px; background: #f8fafc; border-radius: 6px; border: 1px solid #e2e8f0; border-collapse: collapse;">
                <tr>
                    <td style="width: 50%; vertical-align: top; padding: 8px 10px; border-right: 1px solid #e2e8f0;">
                        <div style="font-size: 9px; font-weight: bold; color: #1d4ed8; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.05em; border-left: 3px solid #1d4ed8; padding-left: 6px;">Bill To</div>
                        <div style="font-size: 8.5px; color: #1e293b; line-height: 1.35;">
                            {% set billing = invoice.effectiveBillingAddress %}
                            {% if billing %}
                                <strong style="color: #0f172a; font-size: 9.5px; display: block; margin-bottom: 2px;">{{ billing.companyName }}</strong>
                                {{ billing.firstName }} {{ billing.lastName }}<br>
                                {{ billing.addressLine1 }}{% if billing.addressLine2 %}, {{ billing.addressLine2 }}{% endif %}<br>
                                {{ billing.city }}, {{ province_name(billing.country, billing.province) }} {{ billing.postalCode }}<br>
                                {{ country_name(billing.country) }}<br>
                                <div style="margin-top: 3px; color: #64748b;">
                                    <strong>P:</strong> {{ billing.phone }} | <strong>E:</strong> {{ billing.emailPrimary }}
                                </div>
                            {% else %}
                                <strong style="color: #0f172a; font-size: 9.5px; display: block; margin-bottom: 2px;">{{ invoice.companyIdentity.name }}</strong>
                                {{ invoice.billingName|default('-') }}<br>
                                {{ invoice.companyIdentity.email }}
                            {% endif %}
                        </div>
                    </td>
                    <td style="width: 50%; vertical-align: top; padding: 8px 10px;">
                        <div style="font-size: 9px; font-weight: bold; color: #1d4ed8; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.05em; border-left: 3px solid #1d4ed8; padding-left: 6px;">Ship To</div>
                        <div style="font-size: 8.5px; color: #1e293b; line-height: 1.35;">
                            {% set shipping = invoice.effectiveShippingAddress %}
                            {% if shipping %}
                                <strong style="color: #0f172a; font-size: 9.5px; display: block; margin-bottom: 2px;">{{ shipping.companyName }}</strong>
                                {{ shipping.firstName }} {{ shipping.lastName }}<br>
                                {{ shipping.addressLine1 }}{% if shipping.addressLine2 %}, {{ shipping.addressLine2 }}{% endif %}<br>
                                {{ shipping.city }}, {{ province_name(shipping.country, shipping.province) }} {{ shipping.postalCode }}<br>
                                {{ country_name(shipping.country) }}<br>
                                {% if shipping.deliveryInstructions %}<strong>Delivery:</strong> {{ shipping.deliveryInstructions }}<br>{% endif %}
                                <div style="margin-top: 3px; color: #64748b;">
                                    <strong>P:</strong> {{ shipping.phone }} | <strong>E:</strong> {{ shipping.emailPrimary }}
                                </div>
                            {% else %}
                                <strong style="color: #0f172a; font-size: 9.5px; display: block; margin-bottom: 2px;">{{ invoice.shippingCompanyName|default(invoice.companyIdentity.name) }}</strong>
                                {{ invoice.shippingName|default('-') }}<br>
                                {{ invoice.companyIdentity.email }}
                            {% endif %}
                        </div>
                    </td>
                </tr>
            </table>

            <div style="font-size: 10px; font-weight: bold; color: #0f172a; margin-bottom: 5px; padding-bottom: 2px; border-bottom: 2px solid #1d4ed8;">Products</div>
            <table class="product-table" style="width: 100%; border-collapse: collapse; margin-bottom: 10px;">
                <thead>
                    <tr>
                        <th style="width: 40px; text-align: center; background: #1e293b; padding: 4px 6px; font-size: 8px; text-transform: uppercase; font-weight: bold; color: #ffffff;">Qty</th>
                        <th style="text-align: left; background: #1e293b; padding: 4px 6px; font-size: 8px; text-transform: uppercase; font-weight: bold; color: #ffffff;">Product Name &amp; Description</th>
                        <th style="width: 45px; text-align: left; background: #1e293b; padding: 4px 6px; font-size: 8px; text-transform: uppercase; font-weight: bold; color: #ffffff;">U/M</th>
                        <th style="width: 80px; text-align: left; background: #1e293b; padding: 4px 6px; font-size: 8px; text-transform: uppercase; font-weight: bold; color: #ffffff;">SKU</th>
                        <th style="width: 110px; text-align: left; background: #1e293b; padding: 4px 6px; font-size: 8px; text-transform: uppercase; font-weight: bold; color: #ffffff;">Batch</th>
                    </tr>
                </thead>
                <tbody>
                    {% for line in invoice.lines %}
                        <tr>
                            {# THE EXCEPTION (#601, settled 2026-09-09). Invoices, orders and quotes
                               print the conventional three figures and no base quantity. A packing
                               slip prints BOTH, because the warehouse counts in either denomination
                               and that is what this document is for: the picker takes 40 cases off
                               a pallet, and the person checking the delivery counts 480 eaches. #}
                            <td id="doc-line-qty-{{ line.id }}" style="text-align: center; font-weight: bold; font-size: 9px; padding: 4px 6px; border-bottom: 1px solid #e2e8f0; color: #0f172a;">{{ line.quantityEntered|qty }}</td>
                            <td style="padding: 4px 6px; border-bottom: 1px solid #e2e8f0; font-size: 8.5px; color: #0f172a;"><strong>{{ line.name }}</strong></td>
                            <td style="padding: 4px 6px; border-bottom: 1px solid #e2e8f0; font-size: 8.5px; color: #64748b;">
                                {{ line.displayUnitLabel }}
                                {% if line.unitOfMeasure %}<span style="display: block; color: #94a3b8;">{{ line.quantity|qty }} {{ line.baseUnitLabel }}</span>{% endif %}
                            </td>
                            <td style="padding: 4px 6px; border-bottom: 1px solid #e2e8f0; font-size: 8.5px; color: #1e293b; font-weight: bold;">{{ line.sku|default('-') }}</td>
                            <td style="padding: 4px 6px; border-bottom: 1px solid #e2e8f0; font-size: 8.5px; color: #64748b; white-space: normal; word-break: break-word; line-height: 1.3;">{{ line.batch|default('-') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            <div style="margin-top: 10px; padding: 8px 10px; background: #eff6ff; border-radius: 8px; color: #1d4ed8; font-weight: bold; text-align: center; border: 1px dashed #1d4ed8; font-size: 8.5px; line-height: 1.35;">
                Please notify us within 48 hours of delivery date with any discrepancies between amounts received and amounts invoiced. Thank you.
            </div>
            </div> <!-- End content wrapper -->
        </div>
    {% if not is_pdf %}
    </div>

    {# No html2pdf.js: Download goes through the ?pdf=1 route, which renders this same template
       through dompdf server-side. The client-side copy was a second renderer producing a different
       PDF from the same markup, off a CDN script. #}
    {% endif %}

    <style>
        :root {
            --teal: #1d4ed8;
            --teal-dark: #1e3a8a;
            --teal-bg: #eff6ff;
            --ink: #1e293b;
            --muted: #64748b;
            --line: #e2e8f0;
        }

        /* ~A4 wide on screen so the preview is to scale with the PDF — the document's font
           sizes are print sizes (issue #35), which looked microscopic on a 1200px sheet. */
        .invoice-page-container { padding: 30px 0; max-width: 820px; margin: 0 auto; }
        .invoice-actions { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }

        /* No padding here: the header band must run edge to edge and the inner content
           wrapper owns the body inset. A 60px pad here used to be added on top of it. */
        .slip-document {
            background: #fff;
            border-radius: 4px;
            color: var(--ink);
            border: 1px solid var(--line);
            box-shadow: var(--shadow-lg);
            overflow: hidden;
            font-family: 'DejaVu Sans', Helvetica, Arial, sans-serif;
        }

        .slip-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 40px;
            border-bottom: 2px solid var(--brand);
            padding-bottom: 20px;
        }
        .brand-section h1 {
            color: var(--brand-dark);
            margin: 0;
            font-size: 28px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: -0.02em;
        }
        .brand-section p {
            margin: 4px 0;
            color: var(--muted);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 10px;
            letter-spacing: 0.12em;
        }
        .slip-title {
            font-size: 36px;
            font-weight: 800;
            color: var(--ink);
            margin: 0;
            letter-spacing: -0.02em;
        }

        .meta-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 30px;
            margin-bottom: 40px;
        }
        .meta-group h3 {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--muted);
            margin: 0 0 12px 0;
            border-bottom: 1px solid var(--line);
            padding-bottom: 6px;
        }
        .meta-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 6px;
            font-size: 12px;
        }
        .meta-item label {
            font-weight: 600;
            color: var(--muted);
        }
        .meta-item strong {
            color: var(--ink);
        }

        .address-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            margin-bottom: 40px;
            background: #f8fafc;
            padding: 30px;
            border-radius: 12px;
            border: 1px solid var(--line);
        }
        .address-box h2 {
            font-size: 14px;
            font-weight: 800;
            color: var(--brand-dark);
            margin: 0 0 15px 0;
            text-transform: uppercase;
            letter-spacing: 0.02em;
        }
        .address-content {
            font-size: 13px;
            color: var(--ink);
            line-height: 1.6;
        }
        .address-content strong {
            display: block;
            margin-bottom: 6px;
            font-size: 15px;
            color: var(--brand-dark);
        }

        .products-section h2 {
            font-size: 18px;
            font-weight: 800;
            color: var(--brand-dark);
            margin-bottom: 20px;
            border-left: 4px solid var(--brand);
            padding-left: 15px;
        }
        .product-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 10px;
        }
        .product-table th {
            text-align: left;
            background: #f1f5f9;
            color: var(--ink);
            padding: 4px 6px;
            font-size: 8px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: bold;
            border-bottom: 2px solid var(--line);
        }
        .product-table td {
            padding: 4px 6px;
            border-bottom: 1px solid var(--line);
            font-size: 8.5px;
        }
        .product-table tr:last-child td {
            border-bottom: 2px solid var(--teal);
        }

        .footer-note {
            margin-top: 40px;
            padding: 25px;
            background: var(--brand-bg);
            border-radius: 12px;
            color: var(--brand-dark);
            font-weight: 600;
            text-align: center;
            border: 1px dashed var(--brand);
            font-size: 13px;
        }

        @media print {
            * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
            body { background: #fff !important; }
            .topbar, .site-footer, .admin-content-header, .no-print, header, footer, nav { display: none !important; }
            .app-shell, .content-frame, #main-content, .invoice-page-container {
                display: block !important;
                padding: 0 !important;
                margin: 0 !important;
                width: 100% !important;
                max-width: none !important;
            }
            .slip-document {
                box-shadow: none !important;
                border: none !important;
                padding: 0 !important;
            }
        }
    </style>
{% endblock %}
