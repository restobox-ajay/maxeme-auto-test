{% extends 'admin/_main/layout.html.twig' %}
{% block title %}Carts | Admin{% endblock %}
{% block admin_body %}
    {# In the grid model since #621: .content-frame > .table-card, so the full-height clamp at
       app.css:7764 applies and the list-screen conventions reach it. It was .panel >
       table.data-table, which they do not. #}
    {% set anyFilter = filters.session or filters.company or filters.itemCount or filters.held or filters.updatedFrom %}

    <section class="panel compact-panel">
        <div class="panel-title-row">
            <div>
                <p class="eyebrow">Customers</p>
                <h1>Carts</h1>
            </div>
            {# No create button: a cart is raised by a shopper, never by an admin. This screen is
               read-only by design — see the controller docblock. #}
        </div>
    </section>

    <section class="table-card no-paginate">
        <form method="get" id="cart-filters" action="{{ path('admin_cart_index') }}">
            <input type="hidden" name="page" value="1">
            <div class="table-scroll-region"><div class="wide-table-wrap"><table class="admin-grid-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Session</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Subtotal</th>
                        <th>Total</th>
                        <th>Hold Expires</th>
                        <th>Updated</th>
                        <th>Actions</th>
                    </tr>
                    {# Five filters, each one a way support actually arrives at a cart. ID,
                       Subtotal and Total carry none: nobody looks a cart up by its money, and the
                       id is what the row already links by. #}
                    <tr class="filter-row">
                        <th></th>
                        <th><input type="text" name="filters[session]" form="cart-filters" value="{{ filters.session }}" aria-label="Filter session id"></th>
                        <th><input type="text" name="filters[company]" form="cart-filters" value="{{ filters.company }}" aria-label="Filter customer"></th>
                        <th><input type="number" name="filters[itemCount]" form="cart-filters" min="0" step="1" value="{{ filters.itemCount }}" aria-label="Filter by number of items"></th>
                        <th></th>
                        <th></th>
                        <th>
                            <select name="filters[held]" form="cart-filters" aria-label="Filter hold status" onchange="this.form.submit()">
                                <option value="">Any</option>
                                <option value="holding"{{ filters.held == 'holding' ? ' selected' : '' }}>Holding now</option>
                                <option value="expired"{{ filters.held == 'expired' ? ' selected' : '' }}>Expired</option>
                                <option value="none"{{ filters.held == 'none' ? ' selected' : '' }}>No hold</option>
                            </select>
                        </th>
                        <th><input type="date" name="filters[updatedFrom]" form="cart-filters" value="{{ filters.updatedFrom }}" aria-label="Filter updated on or after"></th>
                        <th>
                            {# A real submit button, so the filter row applies with JavaScript off. #}
                            <button class="button" type="submit">Filter</button>
                            <a class="button" href="{{ path('admin_cart_index') }}">Reset</a>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr class="data-item-row" data-cart="{{ row.id }}">
                            <td data-label="ID">{{ row.id }}</td>
                            <td data-label="Session"><code>{{ row.sessionId|slice(0, 12) }}&hellip;</code></td>
                            <td data-label="Customer">{{ row.company ? row.company.name : '' }}</td>
                            <td data-label="Items">{{ row.itemCount }}</td>
                            <td data-label="Subtotal">${{ (row.subtotal ?? 0)|amount }}</td>
                            <td data-label="Total">${{ (row.total ?? 0)|amount }}</td>
                            <td data-label="Hold Expires">{{ row.holdExpiresAt ? row.holdExpiresAt|date('Y-m-d H:i:s') : '' }}</td>
                            <td data-label="Updated">{{ row.updatedAt|date('Y-m-d H:i:s') }}</td>
                            <td data-label="Actions" class="row-actions">
                                {# One control, collected the way every other grid collects them, so
                                   the second action this screen ever grows has somewhere to go. #}
                                <div class="row-action-menu">
                                    <button class="table-action row-action-toggle" type="button" aria-expanded="false" aria-haspopup="true" aria-label="Open cart actions"></button>
                                    <div class="row-action-dropdown">
                                        <a href="{{ path('admin_cart_detail', {id: row.id}) }}">View</a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" class="empty-table-cell">
                                {% if anyFilter %}
                                    <strong>No carts match.</strong>
                                    <span>Widen the filters, or reset them.</span>
                                {% else %}
                                    <strong>No carts on file yet.</strong>
                                    <span>A cart appears here the first time a shopper puts something in one.</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table></div></div>
            <div class="table-footer">
                {% include 'admin/_table_count.html.twig' with {count: rows|length, total: total, currentPage: page, perPage: limit, label: 'carts'} only %}
                <label class="per-page-label">Per page
                    <select name="limit" form="cart-filters" onchange="this.form.submit()">
                        {% for option in [20, 100, 200, 500] %}<option value="{{ option }}"{{ limit == option ? ' selected' : '' }}>{{ option }}</option>{% endfor %}
                    </select>
                </label>
                {% include 'admin/_pagination.html.twig' with {
                    routeName: 'admin_cart_index',
                    routeQuery: {filters: filters, limit: limit},
                    currentPage: page, pageCount: pages
                } only %}
            </div>
        </form>
    </section>
{% endblock %}
