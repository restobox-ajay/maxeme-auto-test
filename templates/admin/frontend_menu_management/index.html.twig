{% extends 'admin/_main/layout.html.twig' %}
{% block title %}Frontend Menu Management | Admin{% endblock %}
{% block admin_body %}
    <section class="panel compact-panel">
        <div class="panel-title-row">
            <div>
                <p class="eyebrow">Configuration</p>
                <h1>Frontend Menu Management</h1>
            </div>
            <div class="panel-actions">
                <a class="button primary" href="{{ path('admin_frontend_menu_management_custom_create') }}">+ Add custom menu item</a>
            </div>
        </div>
    </section>

    {% for msg in app.flashes('success') %}
        <div class="flash flash-success">{{ msg }}</div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="flash flash-error">{{ msg }}</div>
    {% endfor %}

    <section class="panel admin-flat-panel">
        <input type="hidden" id="frontend-menu-reorder-token" value="{{ csrf_token_value() }}">
        <table class="admin-grid-table data-table" id="frontend-menu-table">
            <thead>
                <tr>
                    <th></th>
                    <th>Label</th>
                    <th>Source</th>
                    <th>Bundle</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr draggable="true" data-type="{{ row.type }}" data-id="{{ row.id }}">
                        <td class="drag-handle" title="Drag to reorder">&#8942;&#8942;</td>
                        <td>{{ row.label }}</td>
                        <td>{{ row.source }}</td>
                        <td>
                            {% if row.type == 'custom' %}
                                &mdash;
                            {% else %}
                                <span class="badge {{ row.bundleActive ? '' : 'danger' }}">{{ row.bundleActive ? 'Active' : 'Inactive' }}</span>
                            {% endif %}
                        </td>
                        <td><span class="badge {{ row.status == 'Inactive' ? 'danger' : '' }}">{{ row.status }}</span></td>
                        <td class="row-actions">
                            {% if row.type == 'custom' %}
                                <a class="table-action" href="{{ path('admin_frontend_menu_management_custom_update', {id: row.id}) }}">Edit</a>
                                <form method="post" action="{{ path('admin_frontend_menu_management_custom_toggle', {id: row.id}) }}" style="display:inline">
                                    {{ csrf_field() }}
                                    <button type="submit" class="link-button{{ row.status == 'Active' ? ' danger' : '' }}">
                                        {{ row.status == 'Active' ? 'Deactivate' : 'Activate' }}
                                    </button>
                                </form>
                                <form method="post" action="{{ path('admin_frontend_menu_management_custom_delete', {id: row.id}) }}"
                                      style="display:inline"
                                      onsubmit="return confirm('Delete menu item {{ row.label|e('js') }}?')">
                                    {{ csrf_field() }}
                                    <button type="submit" class="table-action danger">Delete</button>
                                </form>
                            {% else %}
                                <form method="post" action="{{ path('admin_frontend_menu_management_toggle', {key: row.id}) }}" style="display:inline">
                                    {{ csrf_field() }}
                                    <button type="submit" class="link-button{{ row.status == 'Active' ? ' danger' : '' }}">
                                        {{ row.status == 'Active' ? 'Deactivate' : 'Activate' }}
                                    </button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="empty-row">No frontend menu items are registered yet.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    (function () {
        var table = document.getElementById('frontend-menu-table');
        if (!table) { return; }
        var tbody = table.querySelector('tbody');
        var dragged = null;

        tbody.addEventListener('dragstart', function (e) {
            var row = e.target.closest('tr[draggable="true"]');
            if (!row) { return; }
            dragged = row;
            e.dataTransfer.effectAllowed = 'move';
        });

        tbody.addEventListener('dragover', function (e) {
            e.preventDefault();
            var target = e.target.closest('tr[draggable="true"]');
            if (!target || target === dragged) { return; }
            var rect = target.getBoundingClientRect();
            var before = (e.clientY - rect.top) < rect.height / 2;
            tbody.insertBefore(dragged, before ? target : target.nextSibling);
        });

        tbody.addEventListener('drop', function (e) {
            e.preventDefault();
            persistOrder();
        });

        function persistOrder() {
            var order = Array.prototype.map.call(tbody.querySelectorAll('tr[draggable="true"]'), function (row) {
                return { type: row.getAttribute('data-type'), id: row.getAttribute('data-id') };
            });

            var tokenField = document.getElementById('frontend-menu-reorder-token');
            var body = new URLSearchParams();
            body.set('_token', tokenField ? tokenField.value : '');
            body.set('order', JSON.stringify(order));

            fetch('{{ path('admin_frontend_menu_management_reorder') }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body.toString()
            });
        }
    })();
    </script>
{% endblock %}
