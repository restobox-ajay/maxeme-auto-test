<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Message #{{ id }}</title>
    {# No app CSS/JS included on purpose: this document is only ever loaded inside a
       sandbox="" iframe (see admin/messenger/queue.html.twig) and should carry nothing
       for a sandboxed context to inherit. Every value below goes through Twig's default
       autoescape — nothing on this page is marked |raw. #}
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; margin: 0; padding: 20px; color: #1e293b; background: #fff; font-size: 13px; }
        h3 { margin: 20px 0 8px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; color: #64748b; }
        h3:first-child { margin-top: 0; }
        dl { margin: 0 0 16px; }
        dt { font-weight: 700; color: #0f172a; }
        dd { margin: 0 0 8px; word-break: break-word; }
        pre { white-space: pre-wrap; word-break: break-word; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; margin: 0 0 16px; max-height: 300px; overflow: auto; }
        .badge { display: inline-block; padding: 2px 8px; border-radius: 999px; background: #f1f5f9; font-size: 11px; font-weight: 700; }
        .danger { background: #fff1f2; color: #b42318; }
    </style>
</head>
<body>
    <p><span class="badge {{ queue == 'failed' ? 'danger' : '' }}">{{ queue }}</span> message #{{ id }}</p>

    {% if summary is not null %}
        <h3>Decoded Message</h3>
        <dl>
            <dt>Class</dt><dd>{{ summary.class }}</dd>
            {% if summary.from is defined %}
                <dt>From</dt><dd>{{ summary.from }}</dd>
                <dt>To</dt><dd>{{ summary.to }}</dd>
                <dt>Subject</dt><dd>{{ summary.subject }}</dd>
            {% endif %}
        </dl>
        {% if summary.htmlBody is defined and summary.htmlBody %}
            <h3>HTML Body (escaped, not rendered)</h3>
            <pre>{{ summary.htmlBody }}</pre>
        {% endif %}
        {% if summary.textBody is defined and summary.textBody %}
            <h3>Text Body</h3>
            <pre>{{ summary.textBody }}</pre>
        {% endif %}
    {% else %}
        <h3>Could Not Decode</h3>
        <p>This row's body could not be decoded as a Messenger envelope. Raw value below.</p>
    {% endif %}

    <h3>Raw Headers</h3>
    <pre>{{ headersPretty }}</pre>

    <h3>Raw Body</h3>
    <pre>{{ rawBody }}</pre>
</body>
</html>
