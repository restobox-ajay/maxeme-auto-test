{% extends 'base.html.twig' %}
{% block title %}Log in | {{ site_name() }}{% endblock %}
{% block body_class %}site site-admin-login{% endblock %}
{% block area_label %}Admin Console{% endblock %}
{% block home_path %}/admin{% endblock %}
{% block navigation %}{% endblock %}
{% block content_header %}{% endblock %}

{% block body %}
<div class="admin-login-shell">
    <div class="admin-login-card">
        <div class="admin-login-card-head">
            <div>
                <p class="eyebrow">{{ site_name() }} · Admin Console</p>
                <h2>Log in</h2>
            </div>
        </div>
        <p class="admin-login-sub">{{ app_setting('company_name', site_name()) }}</p>

        {% if error %}
            <div class="admin-login-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form class="form-grid admin-login-form" method="post" action="{{ path('admin_login') }}" role="form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <label class="span-2" for="username">
                Username
                <input type="text" id="username" name="_username" value="{{ last_username }}" required placeholder="Username" autocomplete="username" autofocus>
            </label>
            <label class="span-2" for="password">
                Password
                <input type="password" id="password" name="_password" required placeholder="Password" autocomplete="current-password">
            </label>
            <label class="check-row span-2">
                <input type="checkbox" id="remember_me" name="_remember_me" value="on"> Remember me
            </label>
            <div class="span-2 auth-actions">
                <button class="button primary full-width" type="submit" id="_submit" name="_submit">Log in</button>
            </div>
            {% if error %}
                <div class="span-2 login-help">
                    <a class="button mx-warning full-width forgot-password-btn" href="{{ path('maxeme_resetting_request') }}">Forgot your password ?</a>
                </div>
            {% endif %}
        </form>
    </div>
</div>
{% endblock %}
