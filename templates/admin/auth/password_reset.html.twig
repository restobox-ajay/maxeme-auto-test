{% extends 'base.html.twig' %}
{% block title %}Password Reset | Admin{% endblock %}
{% block body_class %}site site-admin-login{% endblock %}
{% block area_label %}Admin Console{% endblock %}
{% block home_path %}/admin{% endblock %}
{% block navigation %}{% endblock %}
{% block content_header %}{% endblock %}

{% block body %}
<section class="auth-center">
    <section class="auth-card-solo">
        <p class="eyebrow">{{ mode == 'invite' ? 'Admin account setup' : 'Admin password reset' }}</p>
        {% if token %}
            {% if mode == 'invite' %}
                <h1>Set up your admin password</h1>
                <p>Create a password to activate your admin account.</p>
            {% else %}
                <h1>Create new admin password</h1>
                <p>Set a strong password to secure your admin account.</p>
            {% endif %}
        {% else %}
            <h1>Send a secure admin reset link</h1>
            <p>Enter the email address connected to your admin account.</p>
        {% endif %}

        {% for message in app.flashes('success') %}
            <div class="alert success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert error">{{ message }}</div>
        {% endfor %}

        {% if token %}
            {% if tokenValid %}
                <form class="form-grid" method="post" action="{{ path(mode == 'invite' ? 'admin_account_setup' : 'admin_password_reset', {token: token}) }}">
                    {{ csrf_field() }}
                    <label class="span-2">New password <span class="req">*</span>
                        <input type="password" name="password" required autocomplete="new-password">
                    </label>
                    <label class="span-2">Confirm new password <span class="req">*</span>
                        <input type="password" name="confirm_password" required autocomplete="new-password">
                    </label>
                    <div class="span-2 auth-actions">
                        <button class="button primary" type="submit">{{ mode == 'invite' ? 'Set Password' : 'Update Password' }}</button>
                        <a class="button back-button" href="{{ path(loginRoute|default('admin_login')) }}">Back to login</a>
                    </div>
                </form>
            {% else %}
                <div class="alert warn span-2" style="margin-top: 12px;">
                    This link is invalid or expired. Please request a new reset link.
                </div>
                <div class="span-2 auth-actions" style="margin-top: 12px;">
                    <a class="button primary" href="{{ path('admin_password_reset') }}">Request new link</a>
                    <a class="button back-button" href="{{ path(loginRoute|default('admin_login')) }}">Back to login</a>
                </div>
            {% endif %}
        {% else %}
            <form class="form-grid" method="post" action="{{ path('admin_password_reset') }}">
                {{ csrf_field() }}
                <label class="span-2">Email <span class="req">*</span><input type="email" name="email" placeholder="admin@example.test" required></label>
                <div class="span-2 auth-actions">
                    <button class="button primary" type="submit">Send reset email</button>
                </div>
            </form>
        {% endif %}
        <p class="auth-foot">Back to <a href="{{ path(loginRoute|default('admin_login')) }}">login</a></p>
    </section>
</section>
{% endblock %}
