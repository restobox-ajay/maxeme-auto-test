{# Parts & Services › Reminder Templates. Vars: templates. #}
{% extends 'admin/_main/layout.html.twig' %}
{% block title %}Reminder Templates | {{ site_name() }}{% endblock %}
{% block admin_body %}
    {% set canManage = is_granted('/service/edit') %}
    {% embed 'maxeme/_page_header.html.twig' with { eyebrow: 'Parts & Services', title: 'Reminder Templates', lead: 'The emails a Service Reminder can use: a friendly reminder to call in or book on the website.' } %}
        {% block title_actions %}
            {% if is_granted('/service/edit') %}
                <a id="addTemplateButton" class="button mx-btn-sm mx-success" href="{{ path('maxeme_service_reminder_template_new') }}">+ Add template</a>
            {% endif %}
        {% endblock %}
        {% block actions %}<a class="button back-button" href="{{ path('maxeme_service_reminder_index') }}">Back</a>{% endblock %}
    {% endembed %}

    <section class="table-card no-paginate" id="reminder-template-card">
        <div class="table-header"><h2>Templates</h2></div>
        <div class="wide-table-wrap">
            <table id="reminder-template-table">
                <thead><tr><th>Name</th><th>Subject</th><th>Last updated</th><th></th></tr></thead>
                <tbody>
                    {% for template in templates %}
                        <tr id="template_{{ template.id }}">
                            <td data-label="Name"><strong>{{ template.name }}</strong></td>
                            <td data-label="Subject">{{ template.subject }}</td>
                            <td data-label="Last updated">{{ template.lastUpdated|date('Y-m-d H:i') }}</td>
                            <td data-label="Actions">
                                {% if canManage %}
                                    <div class="mx-actions">
                                        <a class="button mx-btn-sm mx-success" href="{{ path('maxeme_service_reminder_template_edit', { id: template.id }) }}">Edit</a>
                                        <button type="button" class="button mx-btn-sm danger js-post-action" data-remove-row="#template_{{ template.id }}"
                                                data-url="{{ path('maxeme_service_reminder_template_delete', { id: template.id }) }}"
                                                data-token="{{ csrf_token_value() }}"
                                                data-confirm-title="Delete Confirmation"
                                                data-confirm-before="Are you sure you want to delete "
                                                data-item="{{ template.name }}"
                                                data-confirm-after="?">Delete</button>
                                    </div>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="empty-table-cell">No templates yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
