{# Manage Admins › Edit an account. Vars: user (AdminUser), account (StaffAccountUpdateRequest), errors, assignableRoles. #}
{% extends 'admin/_main/layout.html.twig' %}
{% import 'maxeme/_macros.html.twig' as mx %}
{% block title %}Edit Admin | {{ site_name() }}{% endblock %}
{# Breadcrumb: the third part, as in the mockup. #}{% block crumb_tail %}Edit{% endblock %}
{% block admin_body %}
    {% embed 'maxeme/_page_header.html.twig' with { eyebrow: 'Manage Admins', title: 'Edit ' ~ (user.username ?? user.email), lead: 'Leave the password boxes blank to keep the current password.' } %}
        {% block actions %}<a class="button back-button" href="{{ path('maxeme_staff_index') }}">Back</a>{% endblock %}
    {% endembed %}

    <section class="form-card">
        <form id="edit-admin-form" class="form-grid" method="post" action="{{ path('maxeme_staff_edit', { id: user.id }) }}" novalidate>
            {{ csrf_field() }}
            {{ mx.form_errors(errors) }}
            <label class="span-2">Email<input type="email" name="email" value="{{ account.email }}" required maxlength="180" autocomplete="off"></label>
            <label class="span-2">Username<input type="text" name="username" value="{{ account.username }}" required minlength="2" maxlength="180" pattern="\S+" title="A username has no spaces." autocomplete="off"></label>
            <label>First name:<input type="text" name="first_name" value="{{ account.firstName }}" required maxlength="120"></label>
            <label>Last name:<input type="text" name="last_name" value="{{ account.lastName }}" required maxlength="120"></label>
            <label class="span-2">Phone<input type="tel" name="phone_number" value="{{ account.phoneNumber }}" maxlength="40" autocomplete="tel" {{ input_rule('phone') }}></label>
            {# One or more roles (mockup 3d5095e): the account may do what any of them allows. #}
            <div class="span-2 mx-roles-field"><span>Roles <small class="muted-line">(pick one or more)</small></span>
                {% if account.roles|filter(r => r not in assignableRoles) is not empty %}
                    <input type="text" value="{{ account.roles|map(r => r.label)|join(', ') }}" disabled>
                {% else %}
                    <div class="mx-check-row">{% for role in assignableRoles %}<label class="mx-check"><input type="checkbox" name="roles[]" value="{{ role.value }}" {{ role in account.roles ? 'checked' }}> <span>{{ role.label }}</span></label>{% endfor %}</div>
                {% endif %}
            </div>
            <label>New password<input type="password" name="password" autocomplete="new-password" placeholder="Leave blank to keep" minlength="8"></label>
            <label>Repeat new password<input type="password" name="password_confirm" autocomplete="new-password" placeholder="Leave blank to keep" minlength="8"></label>
            <div class="form-actions span-2">
                <button type="submit" class="button primary">Update</button>
                <a class="button outline cancel-back-button" href="{{ path('maxeme_staff_index') }}">Cancel</a>
            </div>
        </form>
    </section>
{% endblock %}
