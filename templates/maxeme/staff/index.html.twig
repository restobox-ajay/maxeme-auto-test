{% extends 'admin/_main/layout.html.twig' %}
{% import 'maxeme/_macros.html.twig' as mx %}
{% block title %}Manage Admins | {{ site_name() }}{% endblock %}
{% block admin_body %}
    {% set canAdd = is_granted('/staff/create') %}
    {% set canManage = is_granted('/staff/edit') %}
    {# Read here, before base.html.twig's flash loop, so it opens the modal instead of becoming a toast. #}
    {% set createdUsername = app.flashes(constant('App\\Maxeme\\Controller\\StaffController::FLASH_CREATED'))|first %}

    {% embed 'maxeme/_page_header.html.twig' with { eyebrow: 'Config', title: 'Manage Admins', lead: 'Every login account. De-activated accounts cannot sign in until activated again; deleted accounts leave this list.' } %}
        {% block actions %}
            {% if canAdd %}
                <button id="add-new-admin-btn" class="button mx-success" type="button" data-modal-open="#register-modal">+ Add a new user</button>
            {% endif %}
        {% endblock %}
    {% endembed %}

    <section class="table-card no-paginate" id="admin-card">
        <div class="wide-table-wrap">
            <table id="admin-table">
                <thead>
                    <tr>
                        <th>First name</th>
                        <th>Last name</th>
                        <th>Email</th>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Status</th>
                        {% if canManage %}<th style="text-align:center;">Actions</th>{% endif %}
                    </tr>
                    {# Column search boxes (core filter-row: filters[field] in the URL); the role is picked from a list. #}
                    <tr class="filter-row">
                        {% for field, label in { first_name: 'First name', last_name: 'Last name', email: 'Email', username: 'Username' } %}
                            <th><input type="search" value="{{ filters[field] ?? '' }}" data-filter-field="{{ field }}" placeholder="Search" aria-label="Search {{ label|lower }}"></th>
                        {% endfor %}
                        <th>
                            <select data-filter-field="role" aria-label="Filter by role">
                                <option value="">All roles</option>
                                {% for role in roles %}
                                    <option value="{{ role.value }}" {{ (filters.role ?? '') == role.value ? 'selected' }}>{{ role.label }}</option>
                                {% endfor %}
                            </select>
                        </th>
                        <th>
                            <select data-filter-field="status" aria-label="Filter by status">
                                <option value="">All</option>
                                {% for status in statuses %}
                                    <option value="{{ status.value }}" {{ (filters.status ?? '') == status.value ? 'selected' }}>{{ status.value }}</option>
                                {% endfor %}
                            </select>
                        </th>
                        {% if canManage %}<th></th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr id="user-{{ user.id }}">
                            <td data-label="First name">{{ user.firstName }}</td>
                            <td data-label="Last name">{{ user.lastName }}</td>
                            <td data-label="Email">{{ user.email }}</td>
                            <td data-label="Username">{{ user.username }}</td>
                            {% set role = staff_role(user) %}
                            <td data-label="Role">{% if role %}<span class="badge mx-role mx-role-{{ role.permissionKey|replace({'_': '-'}) }}">{{ role.label }}</span>{% else %}—{% endif %}</td>
                            {% set active = user.status == 'Active' %}
                            <td data-label="Status"><span class="badge {{ active ? 'success' : 'warn' }}">{{ user.status }}</span></td>
                            {% if canManage %}
                                <td data-label="Actions" style="text-align:center;">
                                    <div class="mx-actions">
                                    {% if is_granted('MAXEME_STAFF_MANAGE', user) and user != app.user %}
                                        <a class="button mx-btn-sm mx-success edit_admin" href="{{ path('maxeme_staff_edit', { id: user.id }) }}">Edit</a>
                                        {% if active %}
                                            <button type="button" class="button mx-btn-sm danger deactivate_admin js-post-action" data-reload
                                                    data-url="{{ path('maxeme_staff_deactivate', { id: user.id }) }}"
                                                    data-token="{{ csrf_token_value() }}"
                                                    data-confirm-title="De-activate Confirmation"
                                                    data-confirm-before="Are you sure you want to de-activate "
                                                    data-item="{{ user.username ?? user.email }}"
                                                    data-confirm-after="? They will not be able to sign in until activated again.">De-activate</button>
                                        {% else %}
                                            <button type="button" class="button mx-btn-sm primary activate_admin js-post-action" data-reload
                                                    data-url="{{ path('maxeme_staff_activate', { id: user.id }) }}"
                                                    data-token="{{ csrf_token_value() }}">Activate</button>
                                        {% endif %}
                                        {# Delete takes the account off this list for good and stops it signing in; its history is kept. #}
                                        <button type="button" class="button mx-btn-sm danger delete_admin js-post-action" data-remove-row="#user-{{ user.id }}"
                                                data-url="{{ path('maxeme_staff_delete', { id: user.id }) }}"
                                                data-token="{{ csrf_token_value() }}"
                                                data-confirm-title="Delete Confirmation"
                                                data-confirm-before="Are you sure you want to delete "
                                                data-item="{{ user.username ?? user.email }}"
                                                data-confirm-after="? It will be removed from this list and can no longer sign in.">Delete</button>
                                    {% endif %}
                                    {{ mx.logs_link(user) }}
                                    </div>
                                </td>
                            {% endif %}
                        </tr>
                    {% else %}
                        <tr><td colspan="{{ canManage ? 7 : 6 }}" class="empty-table-cell">No data available in table</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    {% if canAdd %}
    <div class="admin-modal-overlay {{ errors is not empty ? 'is-visible' }}" id="register-modal" role="dialog" aria-modal="true" aria-labelledby="register-modal-title">
        <div class="admin-modal">
            <button class="admin-modal-x js-modal-close" type="button" aria-label="Close">&times;</button>
            <div class="admin-modal-header">
                <p class="eyebrow">Manage Admins</p>
                <h2 id="register-modal-title">Add a new user</h2>
                <p class="lead">The role decides what the account can see and change.</p>
            </div>
            <form id="register-form" class="form-grid" method="post" action="{{ path('maxeme_staff_create') }}" style="margin-top:18px" novalidate>
                {{ csrf_field() }}
                {{ mx.form_errors(errors, 'mx-form-error') }}
                <label class="span-2">Email<input type="email" name="email" id="reg-email" value="{{ account.email }}" required maxlength="180" autocomplete="off"></label>
                <label class="span-2">Username<input type="text" name="username" id="reg-username" value="{{ account.username }}" required minlength="2" maxlength="180" pattern="\S+" title="A username has no spaces." autocomplete="off"></label>
                <label>Password<input type="password" name="password" id="reg-pass1" required autocomplete="new-password" minlength="8"></label>
                <label>Repeat password<input type="password" name="password_confirm" id="reg-pass2" required autocomplete="new-password" minlength="8"></label>
                <label>First name:<input type="text" name="first_name" id="reg-first" value="{{ account.firstName }}" required maxlength="120"></label>
                <label>Last name:<input type="text" name="last_name" id="reg-last" value="{{ account.lastName }}" required maxlength="120"></label>
                <label class="span-2">Role
                    <select name="role" id="reg-role" required>
                        <option value="">Choose a role</option>
                        {% for role in assignableRoles %}
                            <option value="{{ role.value }}" {{ account.role == role ? 'selected' }}>{{ role.label }}</option>
                        {% endfor %}
                    </select>
                </label>
                <div class="form-actions span-2">
                    <button type="submit" class="button primary">Register</button>
                    <button type="button" class="button outline cancel-back-button js-modal-close">Cancel</button>
                </div>
            </form>
        </div>
    </div>
    {% endif %}

    <div class="admin-modal-overlay {{ createdUsername ? 'is-visible' }}" id="register-confirmed-modal" role="dialog" aria-modal="true" aria-labelledby="register-confirmed-title">
        <div class="admin-modal">
            <button class="admin-modal-x js-modal-close" type="button" aria-label="Close">&times;</button>
            <div class="admin-modal-header">
                <p class="eyebrow">Registration</p>
                <h2 id="register-confirmed-title">The user has been created successfully</h2>
            </div>
            <p id="register-confirmed-text" style="margin-top:14px">Congrats {{ createdUsername }}, your account is now activated.</p>
            <div class="admin-modal-footer-split" style="margin-top:22px">
                <span></span>
                <button class="button primary js-modal-close" type="button">Back to Manage Admins</button>
            </div>
        </div>
    </div>
{% endblock %}
