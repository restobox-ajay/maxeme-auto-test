{% extends 'admin/_main/layout.html.twig' %}
{% import 'maxeme/_macros.html.twig' as mx %}
{% set isEdit = appointment is not null %}
{% set title = isEdit ? 'Edit an appointment' : 'Schedule an appointment' %}
{% block title %}{{ title }} | {{ site_name() }}{% endblock %}
{% block admin_body %}
    {% set profileUrl = path('maxeme_client_show', { id: client.id, tab: 'appointments' }) %}
    {% set duration = isEdit ? appointment.durationInHours : settings.defaultDurationHours %}

    {% embed 'maxeme/_page_header.html.twig' with { eyebrow: 'Schedule', title: title, lead: isEdit ? 'Click another 15-minute slot to move the appointment, or change the vehicle, duration or note.' : 'Pick a vehicle, then click a 15-minute slot in the day view to set the start time.' } %}
        {% block actions %}
            {% if isEdit and not appointment.locked %}
                <div class="mx-doc-actions">
                    {% if appointment.status.value == 'new' %}
                        <button type="button" class="button mx-btn-sm primary js-post-action" data-reload
                                data-url="{{ path('maxeme_appointment_check_in', { id: appointment.id }) }}" data-token="{{ csrf_token_value() }}">Check-in</button>
                    {% endif %}
                    {# A completed appointment is never deleted (mockup ca9d795). #}
                    {% if appointment.status.value != 'complete' %}
                        <button type="button" class="button mx-btn-sm danger js-post-action" data-redirect="{{ profileUrl }}"
                                data-url="{{ path('maxeme_appointment_delete', { id: appointment.id }) }}" data-token="{{ csrf_token_value() }}"
                                data-confirm-title="Delete Confirmation" data-confirm-before="Delete this appointment" data-item="" data-confirm-after="?">Delete</button>
                    {% endif %}
                </div>
            {% endif %}
            <a class="button back-button" href="{{ profileUrl }}">Back</a>
        {% endblock %}
    {% endembed %}

    <div class="appt-layout">
        <section class="form-card">
            {% if isEdit and appointment.locked %}
                {# Its repair order is paid (mockup ee7a843): only the note can change. #}
                <div class="mx-alert mx-alert-info" id="appointment-locked" role="status"><div><strong>&#128274; Paid and locked.</strong>
                    <p class="muted-line">{{ ro_number(appointment.repairOrder) }} is paid, so this appointment is read-only except its note. Mark the invoice unpaid or cancelled first to change it.</p></div></div>
            {% endif %}
            <form id="{{ isEdit ? 'make_edit_appointment_form' : 'make_new_appointment_form' }}" class="form-grid appt-form-grid" method="post"
                  action="{{ isEdit ? path('maxeme_appointment_edit', { id: appointment.id }) : path('maxeme_appointment_new', { id: client.id }) }}"
                  data-appointment-form="{{ {
                      initialDate: data.start ? data.start|slice(0, 10) : null,
                      daysUrl: path('maxeme_appointment_days'),
                      slotsUrl: path('maxeme_appointment_slots'),
                      slotUrl: path('maxeme_appointment_slot'),
                      slotMinTime: settings.dayStart,
                      slotMaxTime: settings.dayEnd,
                      slotMinutes: settings.slotMinutes,
                      busySlotCount: settings.busySlotCount,
                  }|json_encode }}">
                {{ csrf_field() }}
                {{ mx.form_errors(errors) }}
                <input id="appointment_start_time" type="hidden" name="start" value="{{ data.start }}">
                <input id="appointment_end_time" type="hidden" name="end" value="{{ data.end }}">
                <label>Client:
                    <input id="client_full_name" type="text" value="{{ client.fullName }}" readonly>
                </label>
                <label>Phone number:
                    <input type="text" value="{{ client.phones|join(' · ') }}" readonly>
                </label>
                <label for="appointment_type">Appointment for:
                    <select id="appointment_type" name="type">
                        {% for type in types %}<option value="{{ type.value }}" data-needs-vehicle="{{ type.needsVehicle ? 1 : 0 }}" {{ data.type == type.value ? 'selected' }}>{{ type.label }}</option>{% endfor %}
                    </select>
                </label>
                <label for="client_vehicle_name">Vehicle:
                    <select id="client_vehicle_name" name="vehicle_id">
                        <option value="" {{ data.vehicleId is null ? 'selected' }}>(no vehicle)</option>
                        {% set vehicles = client.vehicles|merge(isEdit and appointment.vehicle and appointment.vehicle not in client.vehicles ? [appointment.vehicle] : []) %}
                        {% for vehicle in vehicles %}
                            <option value="{{ vehicle.id }}" {{ data.vehicleId == vehicle.id ? 'selected' }}>{{ vehicle.fullName }}{{ vehicle.active ? '' : ' (inactive)' }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label>Start time:
                    <span id="a_start_time" class="appt-start-time">{{ data.start ? data.start|date('Y-m-d g:i A', false) : 'Pick from the calendar' }}</span>
                </label>
                <label for="appointment_duration">Duration:
                    <span class="appt-duration"><input id="appointment_duration" value="{{ duration }}" type="number" min="0.5" max="24" step="0.5"> hours</span>
                </label>
                <label for="appointment_repair_order" id="appointment_repair_order_field">Repair Order:
                    <select id="appointment_repair_order" name="repair_order_id">
                        {% if isEdit %}
                            <option value="">(none)</option>
                        {% else %}
                            <option value="">Choose a repair order…</option>
                            <option value="new" {{ data.repairOrderId == 'new' ? 'selected' }}>+ Create new repair order</option>
                        {% endif %}
                        {% for repairOrder in repairOrders %}
                            <option value="{{ repairOrder.id }}" data-technician="{{ repairOrder.masterTechnician ? repairOrder.masterTechnician.id }}" {{ data.repairOrderId == repairOrder.id ~ '' ? 'selected' }}>{{ ro_number(repairOrder) }}{{ repairOrder.name ? ' · ' ~ (repairOrder.name|length > 40 ? repairOrder.name|slice(0, 40) ~ '…' : repairOrder.name) }}{{ repairOrder.vehicle ? ' · ' ~ repairOrder.vehicle.fullName }} · {{ repairOrder.status.label }}</option>
                        {% endfor %}
                    </select>
                    {% if isEdit and appointment.repairOrder %}<a class="muted-line" href="{{ path('maxeme_repair_order_edit', { id: appointment.repairOrder.id }) }}">Open {{ ro_number(appointment.repairOrder) }}</a>{% endif %}
                </label>
                {# The same technician as its repair order's (mockup 986d771): picking one here sets it there too. #}
                <label for="appointment_technician">Assigned Technician:
                    <select id="appointment_technician" name="technician_id">
                        <option value="">(none)</option>
                        {% for choice in technicians %}<option value="{{ choice.user.id }}" {{ data.technicianId == choice.user.id ~ '' ? 'selected' }}>{{ choice.user.name }}{{ choice.stale ? ' (no longer an active technician)' }}</option>{% endfor %}
                    </select>
                </label>
                {% if isEdit %}
                    <label for="appointment_status">Status:
                        <select id="appointment_status" name="status">
                            {# Extended only once the vehicle has arrived (mockup 551ab32). #}
                            {% set arrived = appointment.status.value in ['in_progress', 'extended'] %}
                            {% for status in statuses %}<option value="{{ status.value }}" {{ data.status == status.value ? 'selected' }} {{ status.value == 'extended' and not arrived ? 'disabled' }}>{{ status.label }} — {{ status.description }}{{ status.value == 'extended' and not arrived ? ' (after check-in)' }}</option>{% endfor %}
                        </select>
                    </label>
                {% endif %}
                <label>Note:
                    <textarea name="note" rows="3">{{ data.note }}</textarea>
                </label>
                <div class="form-actions">
                    <a id="appointment_cancel" class="button outline" href="{{ profileUrl }}">Close</a>
                    <button id="appointment_submit" type="submit" class="button primary" {{ data.start ? '' : 'disabled' }}>Save</button>
                </div>
            </form>
        </section>
        <section class="table-card calendar-card">
            <div class="appointment-calendar-wrap">
                <div id="calendar" class="mx-calendar"></div>
                <div id="timeslot-detail" hidden>
                    <div id="timeslot-detail-container" hidden>
                        <h5><span id="timeslot-detail-title">Appointments start from</span> <span id="timeslot-detail-time"></span></h5>
                        <div id="timeslot-detail-list"></div>
                    </div>
                </div>
            </div>
        </section>
    </div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    {% include 'maxeme/schedule/_fullcalendar.html.twig' %}
    <script src="/assets/js/maxeme-appointment-form.js?v=3"></script>
{% endblock %}
