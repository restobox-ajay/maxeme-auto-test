{% extends 'admin/_main/layout.html.twig' %}
{% import 'maxeme/_macros.html.twig' as mx %}
{% set isEdit = appointment is not null %}
{% set title = isEdit ? 'Edit an appointment' : 'Schedule an appointment' %}
{% block title %}{{ title }} | {{ site_name() }}{% endblock %}
{% block admin_body %}
    {% set profileUrl = path('maxeme_client_show', { id: client.id, tab: 'appointments' }) %}
    {% set duration = isEdit ? appointment.durationInHours : settings.defaultDurationHours %}

    {% embed 'maxeme/_page_header.html.twig' with { eyebrow: 'Schedule', title: title, lead: isEdit ? 'Click another 15-minute slot to move the appointment, or change the vehicle, duration or note.' : 'Pick a vehicle, then click a 15-minute slot in the day view to set the start time.' } %}
        {% block actions %}<a class="button back-button" href="{{ profileUrl }}">Back</a>{% endblock %}
    {% endembed %}

    <div class="appt-layout">
        <section class="form-card">
            <form id="{{ isEdit ? 'make_edit_appointment_form' : 'make_new_appointment_form' }}" class="form-grid appt-form-grid" method="post"
                  action="{{ isEdit ? path('maxeme_appointment_edit', { id: appointment.id }) : path('maxeme_appointment_new', { id: client.id }) }}"
                  data-appointment-form="{{ {
                      initialDate: data.start ? data.start|slice(0, 10) : null,
                      daysUrl: path('maxeme_appointment_days'),
                      slotsUrl: path('maxeme_appointment_slots'),
                      slotUrl: path('maxeme_appointment_slot'),
                      slotMinTime: settings.dayStart,
                      slotMaxTime: settings.dayEnd,
                      slotMinutes: settings.slotMinutes,
                      busySlotCount: settings.busySlotCount,
                  }|json_encode }}">
                {{ csrf_field() }}
                {{ mx.form_errors(errors) }}
                <input id="appointment_start_time" type="hidden" name="start" value="{{ data.start }}">
                <input id="appointment_end_time" type="hidden" name="end" value="{{ data.end }}">
                <label>Client:
                    <input id="client_full_name" type="text" value="{{ client.fullName }}" readonly>
                </label>
                <label>Phone number:
                    <input type="text" value="{{ client.homeNumber }}" readonly>
                </label>
                <label for="client_vehicle_name">Vehicle:
                    <select id="client_vehicle_name" name="vehicle_id">
                        {% for vehicle in client.vehicles %}
                            <option value="{{ vehicle.id }}" {{ data.vehicleId == vehicle.id ? 'selected' }}>{{ vehicle.fullName }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label>Start time:
                    <span id="a_start_time" class="appt-start-time">{{ data.start ? data.start|date('Y-m-d g:i A', false) : 'Pick from the calendar' }}</span>
                </label>
                <label for="appointment_duration">Duration:
                    <span class="appt-duration"><input id="appointment_duration" value="{{ duration }}" type="number" min="0.5" max="24" step="0.5"> hours</span>
                </label>
                <label>Note:
                    <textarea name="note" rows="3">{{ data.note }}</textarea>
                </label>
                <div class="form-actions">
                    <a id="appointment_cancel" class="button outline" href="{{ profileUrl }}">Close</a>
                    <button id="appointment_submit" type="submit" class="button primary" {{ data.start ? '' : 'disabled' }}>Save</button>
                </div>
            </form>
        </section>
        <section class="table-card calendar-card">
            <div class="appointment-calendar-wrap">
                <div id="calendar" class="mx-calendar"></div>
                <div id="timeslot-detail" hidden>
                    <div id="timeslot-detail-container" hidden>
                        <h5><span id="timeslot-detail-title">Appointments start from</span> <span id="timeslot-detail-time"></span></h5>
                        <div id="timeslot-detail-list"></div>
                    </div>
                </div>
            </div>
        </section>
    </div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    {% include 'maxeme/schedule/_fullcalendar.html.twig' %}
    <script src="/assets/js/maxeme-appointment-form.js?v=1"></script>
{% endblock %}
