{# Parts Inventory › Physical count (after wholesale-b2b's Cycle Count). Vars: parts, find (SearchTerm). #}
{% extends 'admin/_main/layout.html.twig' %}
{% block title %}Physical count | {{ site_name() }}{% endblock %}
{% block admin_body %}
    {% set param = constant('App\\Maxeme\\Listing\\SearchTerm::PARAM') %}
    {% embed 'maxeme/_page_header.html.twig' with { eyebrow: 'Parts & Service', title: 'Physical count', lead: 'Count the shelf and enter what you actually found. Each difference is recorded in the part\'s stock history as "Physical count"; a part that agrees changes nothing. Leave a box blank to skip that part.' } %}
        {% block actions %}<a class="button back-button" href="{{ path('maxeme_part_index') }}">Back</a>{% endblock %}
    {% endembed %}

    <section class="panel compact-panel">
        <form method="get" action="{{ path('maxeme_part_count') }}" class="mx-pick-search" role="search">
            <input type="search" name="{{ param }}" value="{{ find.text }}" placeholder="Narrow the sheet: part name, VIN #, manufacturer, vendor" aria-label="Narrow the count sheet">
            <button class="button primary" type="submit">{{ mx_icon('search') }} Filter</button>
            {% if not find.isEmpty %}<a class="button outline" href="{{ path('maxeme_part_count') }}">Show all</a>{% endif %}
        </form>
    </section>

    <section class="table-card no-paginate" id="count-card">
        <form method="post" action="{{ path('maxeme_part_count_submit') }}" id="physical-count-form">
            {{ csrf_field() }}
            <input type="hidden" name="{{ param }}" value="{{ find.text }}">
            <div class="table-header"><h2>Count sheet · {{ parts|length }} part(s)</h2></div>
            <div class="wide-table-wrap">
                <table id="count-table">
                    <thead>
                        <tr><th>Part name</th><th>VIN #</th><th>Manufacturer</th><th>Type</th><th class="num">System says</th><th style="width:140px">Found</th></tr>
                    </thead>
                    <tbody>
                        {% for part in parts %}
                            <tr id="count_{{ part.id }}">
                                <td data-label="Part name">{{ part.displayName }}</td>
                                <td data-label="VIN #">{{ part.vin }}</td>
                                <td data-label="Manufacturer">{{ part.manufacturer }}</td>
                                <td data-label="Type">{{ part.type ? part.type.label : '' }}</td>
                                <td data-label="System says" class="num"><strong>{{ part.quantity }}</strong></td>
                                <td data-label="Found">
                                    <input type="number" name="found[{{ part.id }}]" min="0" step="1" inputmode="numeric" placeholder="{{ part.quantity }}" aria-label="Found for {{ part.displayName }}">
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="6" class="empty-table-cell">No active parts match.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if parts is not empty %}
                <div class="table-footer mx-count-footer">
                    <label>Reference <input type="text" name="reference" maxlength="160" placeholder="Count sheet number (optional)"></label>
                    <button class="button primary" type="submit">Record count</button>
                </div>
            {% endif %}
        </form>
    </section>
{% endblock %}
