{# Part form fields (legacy cns_parts_info_form). Vars: types (PartType cases). #}
<label>Vin<input type="text" name="vin"></label>
<label>Name<input type="text" name="name"></label>
<label>Manufacturer<input type="text" name="manufacturer"></label>
<label>Type
    <select name="type">
        {% for type in types %}<option value="{{ type.value }}">{{ type.label }}</option>{% endfor %}
    </select>
</label>
<label>Description<input type="text" name="description"></label>
<label>Vendor<input type="text" name="vendor"></label>
<label>Unit price<input type="text" name="unit_price" inputmode="decimal"></label>
<label>Sale price<input type="text" name="sale_price" inputmode="decimal"></label>
<label>Quantity<input type="text" name="quantity" inputmode="numeric"></label>
<label class="span-2">Notes<textarea rows="4" name="notes"></textarea></label>
