{# A report's time filter: [preset ▾] From [ ] to [ ] [Run]. The preset only fills From and To in the
   browser (maxeme.js select[data-period-preset]); the report runs on From and To. Vars: period
   (ReportPeriod), hidden (extra query fields to keep, e.g. { method: 3 }). #}
<div class="mx-period">
    <label class="mx-period-field"><span class="sr-only">Period</span>
        <select data-period-preset aria-label="Period">
            <option value="custom">Custom</option>
            <option value="today">Today</option>
            <option value="yesterday">Yesterday</option>
            <option value="this_week">This Week</option>
            <option value="this_month">This Month</option>
            <option value="last_week">Last Week</option>
            <option value="last_month">Last Month</option>
        </select>
    </label>
    <label class="mx-period-field">From <input type="date" name="from" value="{{ period.from|date('Y-m-d', false) }}" required></label>
    <label class="mx-period-field">to <input type="date" name="to" value="{{ period.to|date('Y-m-d', false) }}" required></label>
    {% for name, value in hidden|default({}) %}{% if value is not null and value != '' %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endif %}{% endfor %}
    <button class="button primary" type="submit">Run</button>
</div>
