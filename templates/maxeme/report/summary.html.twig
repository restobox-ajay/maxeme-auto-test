{% extends 'admin/_main/layout.html.twig' %}
{% import 'maxeme/_macros.html.twig' as mx %}
{% block title %}Summary Report | {{ site_name() }}{% endblock %}
{% block admin_body %}
    {% include 'maxeme/_page_header.html.twig' with { eyebrow: 'Accounting', title: 'Daily Summary', lead: 'Invoices by date and payment method, with revenue, material cost, discount, sales tax and net gain.' } only %}

    <section class="table-card no-search no-paginate">
        <form class="mx-report-query" method="get" action="{{ path('maxeme_report_summary') }}">
            {% if method %}<input type="hidden" name="method" value="{{ method.id }}">{% endif %}
            Show invoice between dates from
            <input type="text" name="startDate" placeholder="Start Date" value="{{ startDate }}" aria-label="Start Date">
            to
            <input type="text" name="endDate" placeholder="End Date" value="{{ endDate }}" aria-label="End Date">
            <button class="button primary" type="submit">Run Query</button>
            {% if error %}<p class="field-error">{{ error }}</p>{% endif %}
        </form>

        <nav class="detail-tabs mx-report-tabs" aria-label="Payment method">
            {% set range = { startDate: startDate, endDate: endDate } %}
            <a href="{{ path('maxeme_report_summary', range) }}" class="{{ method is null ? 'is-active' }}">All</a>
            {% for option in methods %}
                <a href="{{ path('maxeme_report_summary', range|merge({ method: option.id })) }}" class="{{ method == option ? 'is-active' }}">{{ option.name }}</a>
            {% endfor %}
        </nav>

        {% if result %}
            <div class="wide-table-wrap">
                <table class="list-report-table">
                    <thead>
                        <tr><th>Invoice #</th><th>Payment method</th><th class="num">Revenue</th><th class="num">Material Cost</th><th class="num">Discount</th><th class="num">Sales Tax</th><th class="num">Net Gain</th><th>Date</th><th>Time</th></tr>
                    </thead>
                    <tbody>
                        {% for invoice in result.invoices %}
                            <tr data-invoice-key="{{ invoice.invoiceKey }}">
                                <td><a href="{{ path('maxeme_invoice_show', { invoiceKey: invoice.invoiceKey }) }}" target="_blank" rel="noopener">{{ doc_number(invoice) }}</a></td>
                                <td>{{ invoice.paymentType ? invoice.paymentType.name }}</td>
                                <td class="num positive">+{{ mx.money(invoice.totalPrice) }}</td>
                                <td class="num negative">-{{ mx.money(invoice.expenseAmount) }}</td>
                                <td class="num negative">{{ mx.money(invoice.discountAmount) }}</td>
                                <td class="num negative">-{{ mx.money(invoice.salesTax) }}</td>
                                <td class="num positive">+{{ mx.money(invoice.netAmount) }}</td>
                                <td>{{ invoice.lastModified|date('m/d/Y') }}</td>
                                <td>{{ invoice.lastModified|date('h:i:s A') }}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="9" class="empty-table-cell">No invoices in this range.</td></tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr>
                            <td>Overall:</td><td></td>
                            <td class="num positive">+{{ mx.money(result.totals.revenue) }}</td>
                            <td class="num negative">-{{ mx.money(result.totals.expense) }}</td>
                            <td class="num negative">{{ mx.money(result.totals.discount) }}</td>
                            <td class="num negative">-{{ mx.money(result.totals.salesTax) }}</td>
                            <td class="num positive">+{{ mx.money(result.totals.net) }}</td>
                            <td></td><td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
