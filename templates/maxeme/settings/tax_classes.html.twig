{# Config › Settings › Tax Classes. Vars: records (list<TaxClass>), rates (list<TaxRate>). #}
{% extends 'maxeme/settings/_layout.html.twig' %}
{% set tab = 'tax_classes' %}
{% block title_actions %}<button id="manageAddButton" class="button mx-btn-sm mx-success" type="button" data-modal-open="#manageAddModal">+ Add tax class</button>{% endblock %}
{% block settings_body %}
    <section class="table-card">
        <div class="table-header"><h2>Tax Classes</h2></div>
        <div class="wide-table-wrap">
            <table id="tax-class-table">
                <thead><tr><th>Code</th><th>Name</th><th>Taxes charged</th><th></th></tr></thead>
                <tbody>
                    {% for class in records %}
                        <tr id="row_{{ class.id }}">
                            <td data-label="Code"><code>{{ class.code }}</code></td>
                            <td data-label="Name"><strong>{{ class.name }}</strong></td>
                            <td data-label="Taxes charged">{{ class.ratesLabel }}</td>
                            <td data-label="Actions">
                                <div class="mx-actions">
                                    <button type="button" class="button mx-btn-sm mx-success" data-modal-open="#manageEditModal"
                                            data-form-action="{{ path('maxeme_settings_tax_class_update', { id: class.id }) }}"
                                            data-form-values="{{ form_values(class)|json_encode }}">Edit</button>
                                    <button type="button" class="button mx-btn-sm danger js-post-action" data-remove-row="#row_{{ class.id }}"
                                            data-url="{{ path('maxeme_settings_tax_class_delete', { id: class.id }) }}"
                                            data-token="{{ csrf_token_value() }}"
                                            data-confirm-title="Delete Confirmation"
                                            data-confirm-before="Are you sure you want to delete "
                                            data-item="{{ class.name }}"
                                            data-confirm-after="?">Delete</button>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="empty-table-cell">No tax classes yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    {% include 'maxeme/settings/_modals.html.twig' with { noun: 'Tax Class', createUrl: path('maxeme_settings_tax_class_create'), fields: 'maxeme/settings/_tax_class_fields.html.twig', extra: { rates: rates } } only %}
{% endblock %}
