{# Config › Settings › Payment Types. Vars: records (list<PaymentType>). #}
{% extends 'maxeme/settings/_layout.html.twig' %}
{% import 'maxeme/_macros.html.twig' as mx %}
{% set tab = 'payment_types' %}
{% block title_actions %}<button id="manageAddButton" class="button mx-btn-sm mx-success" type="button" data-modal-open="#manageAddModal">+ Add payment type</button>{% endblock %}
{% block settings_body %}
    <section class="table-card">
        <div class="table-header"><h2>Payment Types</h2></div>
        <div class="wide-table-wrap">
            <table id="payment-type-table">
                <thead><tr><th>Order</th><th>Name</th><th>Active</th><th></th></tr></thead>
                <tbody>
                    {% for type in records %}
                        <tr id="row_{{ type.id }}">
                            <td data-label="Order" class="num">{{ type.position }}</td>
                            <td data-label="Name"><strong>{{ type.name }}</strong></td>
                            <td data-label="Active"><span class="badge {{ type.active ? 'success' : 'danger-soft' }}">{{ type.active ? 'Active' : 'Inactive' }}</span></td>
                            <td data-label="Actions">
                                <div class="mx-actions">
                                    <button type="button" class="button mx-btn-sm mx-success" data-modal-open="#manageEditModal"
                                            data-form-action="{{ path('maxeme_settings_payment_type_update', { id: type.id }) }}"
                                            data-form-values="{{ form_values(type)|json_encode }}">Edit</button>
                                    <button type="button" class="button mx-btn-sm danger js-post-action" data-remove-row="#row_{{ type.id }}"
                                            data-url="{{ path('maxeme_settings_payment_type_delete', { id: type.id }) }}"
                                            data-token="{{ csrf_token_value() }}"
                                            data-confirm-title="Delete Confirmation"
                                            data-confirm-before="Are you sure you want to delete "
                                            data-item="{{ type.name }}"
                                            data-confirm-after="?">Delete</button>
                                    {{ mx.logs_link(type) }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="empty-table-cell">No payment types yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <p class="muted-line">The invoice builder offers the active ones, in this order. The Summary Report has a tab for each.</p>
    </section>

    {% include 'maxeme/settings/_modals.html.twig' with { noun: 'Payment Type', createUrl: path('maxeme_settings_payment_type_create'), fields: 'maxeme/settings/_payment_type_fields.html.twig' } only %}
{% endblock %}
