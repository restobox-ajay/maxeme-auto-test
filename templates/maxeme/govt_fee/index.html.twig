{# Config › Government Fees. Vars: page (ListPage<GovtFee>), taxClasses. #}
{% extends 'admin/_main/layout.html.twig' %}
{% import 'maxeme/_macros.html.twig' as mx %}
{% block title %}Government Fees | {{ site_name() }}{% endblock %}
{% block admin_body %}
    {% set canManage = is_granted('/service/edit') %}
    {% embed 'maxeme/_page_header.html.twig' with { eyebrow: 'Config', title: 'Government Fees', lead: 'Fees added to invoices by hand, or automatically by fee rules that look for their code.' } %}
        {% block title_actions %}
            {% if is_granted('/service/edit') %}<button id="manageAddButton" class="button mx-btn-sm mx-success" type="button" data-modal-open="#manageAddModal">+ Add government fee</button>{% endif %}
        {% endblock %}
    {% endembed %}

    <section class="table-card" id="govt-fee-card" {{ mx.list_card_attrs(page) }}>
        <div class="table-header"><h2>Government Fees</h2></div>
        <div class="wide-table-wrap">
            <table id="govt-fee-table">
                <thead>
                    <tr>
                        {{ mx.sort_th(page, 'name', 'Name') }}{{ mx.sort_th(page, 'code', 'Code') }}{{ mx.sort_th(page, 'price', '$') }}
                        <th>Description</th>{{ mx.sort_th(page, 'active', 'Active') }}<th>Tax class</th><th></th>
                    </tr>
                    <tr class="filter-row">
                        {% for field, label in { name: 'Name', code: 'Code' } %}
                            <th><input type="search" value="{{ page.query.filters[field] ?? '' }}" data-filter-field="{{ field }}" placeholder="Search" aria-label="Search {{ label|lower }}"></th>
                        {% endfor %}
                        <th></th><th></th><th></th><th></th><th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for fee in page.items %}
                        <tr id="row_{{ fee.id }}">
                            <td data-label="Name"><strong>{{ fee.name }}</strong></td>
                            <td data-label="Code"><code>{{ fee.code }}</code></td>
                            <td data-label="$" class="num">{{ mx.money(fee.price) }}</td>
                            <td data-label="Description" class="mx-note-text">{{ fee.description|nl2br }}</td>
                            <td data-label="Active"><span class="badge {{ fee.active ? 'success' : 'danger-soft' }}">{{ fee.active ? 'Active' : 'Inactive' }}</span></td>
                            <td data-label="Tax class">{{ fee.taxClass ? fee.taxClass.label : '—' }}</td>
                            <td data-label="Actions">
                                {% if canManage %}
                                    <div class="mx-actions">
                                        <button type="button" class="button mx-btn-sm mx-success" data-modal-open="#manageEditModal"
                                                data-form-action="{{ path('maxeme_govt_fee_update', { id: fee.id }) }}"
                                                data-form-values="{{ form_values(fee)|json_encode }}">Edit</button>
                                        <button type="button" class="button mx-btn-sm danger js-post-action" data-remove-row="#row_{{ fee.id }}"
                                                data-url="{{ path('maxeme_govt_fee_delete', { id: fee.id }) }}"
                                                data-token="{{ csrf_token_value() }}"
                                                data-confirm-title="Delete Confirmation"
                                                data-confirm-before="Are you sure you want to delete "
                                                data-item="{{ fee.name }}"
                                                data-confirm-after="?">Delete</button>
                                    </div>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" class="empty-table-cell">No government fees yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {{ mx.list_footer(page) }}
    </section>

    {% if canManage %}
        {% include 'maxeme/charge/_modals.html.twig' with { noun: 'Government Fee', createUrl: path('maxeme_govt_fee_create'), fields: 'maxeme/govt_fee/_fields.html.twig', priceLabel: '$ (amount)', taxClasses: taxClasses } only %}
    {% endif %}
{% endblock %}
