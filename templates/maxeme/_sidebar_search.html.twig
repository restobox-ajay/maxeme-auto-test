{# The sidebar searches, below the navigation: one box each for customers, vehicles and invoices, each
   shown to a role that can see that area. One match opens the record, several open its list. #}
{% set route = app.request.attributes.get('_route') %}
{% set boxes = [
    { permission: '/people/view', action: 'maxeme_client_search', title: 'Customer', placeholder: 'Name, phone, address…', hint: 'Name, preferred name, phone, address or invoice #', lists: ['maxeme_client_index', 'maxeme_client_search'] },
    { permission: '/car/view', action: 'maxeme_vehicle_search', title: 'Vehicle', placeholder: 'VIN, plate, make…', hint: 'VIN, license plate, make, model, year or color', lists: ['maxeme_vehicle_index', 'maxeme_vehicle_search'] },
    { permission: '/accounting/view', action: 'maxeme_invoice_find', title: 'Invoice #', placeholder: 'e.g. 15836', hint: 'The invoice number; prefix and leading zeros optional', lists: ['maxeme_invoice_index', 'maxeme_invoice_find'] },
] %}
<div class="mx-side-search">
    {% for box in boxes|filter(box => is_granted(box.permission)) %}
        <form method="get" action="{{ path(box.action) }}" role="search">
            <h5>{{ box.title }}</h5>
            <div class="mx-side-field">
                <div class="mx-inputs">
                    <input type="search" name="{{ constant('App\\Maxeme\\Listing\\SearchTerm::PARAM') }}" placeholder="{{ box.placeholder }}" title="{{ box.hint }}" aria-label="Search {{ box.title|lower }}: {{ box.hint }}"
                           value="{{ route in box.lists ? app.request.query.get(constant('App\\Maxeme\\Listing\\SearchTerm::PARAM'))|default('') : '' }}" required>
                </div>
                <button class="button primary mx-side-go" type="submit" aria-label="Find {{ box.title|lower }}">{{ mx_icon('search') }}</button>
            </div>
        </form>
    {% endfor %}
</div>
