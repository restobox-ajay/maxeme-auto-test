{# Schedule › Reminders (mockups 1b7f972, aa322bb): the reminders and the service reminder queue in one
   paginated list, this week by default. Two statuses each: the reminder's own and the email's (queue
   entries), plus how the call went (Phone Status, changed in place). The buttons follow the status: a
   closed reminder or skipped entry offers only its email and logs.
   Vars: period (ReportPeriod), page (ListPage of ReminderList rows), statuses, emailStatuses (value => label),
   phoneStatuses (PhoneStatus cases), latestDay ('Y-m-d' or null), later (rows dated after the period). #}
{% extends 'admin/_main/layout.html.twig' %}
{% import 'maxeme/_macros.html.twig' as mx %}
{% block title %}Reminders | {{ site_name() }}{% endblock %}
{% block admin_body %}
    {% set canManage = is_granted('/reminder/edit') %}
    {% set canBook = is_granted('/appointment/edit') %}
    {% set query = app.request.query.all %}
    {% embed 'maxeme/_page_header.html.twig' with { eyebrow: 'Schedule', title: 'Reminders' } %}
        {% block title_actions %}<a class="button mx-btn-sm outline" id="reminder-export" href="{{ path('maxeme_reminder_export', app.request.query.all|merge(period.toQuery)) }}">Export CSV</a>{% endblock %}
    {% endembed %}

    <section class="table-card" id="reminder-card" {{ mx.list_card_attrs(page) }} data-phone-url="{{ path('maxeme_reminder_phone_status', { kind: 'reminder', id: 0 }) }}" data-token="{{ csrf_token_value() }}">
        <form class="mx-report-query" method="get" action="{{ path('maxeme_reminder_index') }}" id="reminder-period">
            {% include 'maxeme/report/_period.html.twig' with { period: period, hidden: { q: page.query.search } } only %}
        </form>
        {% if latestDay %}
            <p class="muted-line mx-board-note">No reminders in this period. The latest is dated {{ latestDay|date('m/d/Y', false) }}: <a href="{{ path('maxeme_reminder_index', { from: latestDay|slice(0, 8) ~ '01', to: latestDay }) }}">show its month</a>.</p>
        {% elseif later %}
            <p class="muted-line mx-board-note">{{ later }} more reminder{{ later == 1 ? ' is' : 's are' }} dated after {{ period.to|date('m/d/Y', false) }}.</p>
        {% endif %}
        <div class="table-header">
            <h2>Reminders <span class="muted-line">{{ page.total }}</span></h2>
            {{ mx.list_search(page, 'reminders') }}
        </div>
        <div class="table-scroll-region">
        <div class="wide-table-wrap">
            <table class="reminder-table" id="reminder-table">
                <thead>
                    <tr>
                        {{ mx.sort_th(page, 'date', 'Date') }}{{ mx.sort_th(page, 'status', 'Status') }}
                        {% if canBook %}<th>Appointment</th>{% endif %}
                        {{ mx.sort_th(page, 'client', 'Client Info') }}<th>Vehicle</th><th>Previous Appointment</th><th>Reminder note</th><th>Phone number</th><th>Phone Status</th><th>Email</th><th>Email Status</th>
                        <th>Action</th>
                    </tr>
                    <tr class="filter-row">
                        <th></th>
                        <th><select data-filter-field="status" aria-label="Filter status"><option value="">All</option>{% for value, label in statuses %}<option value="{{ value }}" {{ (page.query.filters.status ?? '') == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select></th>
                        {% if canBook %}<th></th>{% endif %}
                        <th></th><th></th><th></th><th></th><th></th>
                        <th><select data-filter-field="phone" aria-label="Filter phone status"><option value="">All</option>{% for status in phoneStatuses %}<option value="{{ status.value }}" {{ (page.query.filters.phone ?? '') == status.value ? 'selected' }}>{{ status.label }}</option>{% endfor %}</select></th>
                        <th></th>
                        <th><select data-filter-field="email" aria-label="Filter email status"><option value="">All</option>{% for value, label in emailStatuses %}<option value="{{ value }}" {{ (page.query.filters.email ?? '') == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in page.items %}
                        {% set reminder = row.reminder %}
                        {% set entry = row.entry %}
                        {% set source = reminder ?? entry %}
                        {% set client = source.client %}
                        {% set vehicle = source.vehicle %}
                        {% set rowId = row.kind ~ '_' ~ source.id %}
                        <tr id="reminder_{{ rowId }}">
                            <td class="mx-nowrap">{{ row.date|date('m/d/Y') }}<div class="muted-line">{{ row.date|date('g:i A') }}</div></td>
                            <td><span class="badge {{ row.statusBadge }}">{{ row.statusLabel }}</span></td>
                            {% if canBook %}
                                <td>{% if row.status in ['new', 'unavailable', 'delayed'] %}<a class="button mx-btn-sm mx-success" href="{{ path('maxeme_appointment_new', { id: client.id, vehicle: vehicle.id }) }}">Book Appointment</a>{% endif %}</td>
                            {% endif %}
                            <td><a href="{{ path('maxeme_client_show', { id: client.id }) }}"><strong>{{ client.fullName }}</strong></a>{% if client.latestNote %}<div class="muted-line">{{ client.latestNote.text }}</div>{% endif %}</td>
                            <td>{{ vehicle.fullName }}{% if vehicle.mileage %}<div class="muted-line">{{ vehicle.mileage }} {{ vehicle.mileageUnit.label|lower }}</div>{% endif %}{% if vehicle.licensePlate %}<div class="muted-line">{{ vehicle.licensePlate }}</div>{% endif %}</td>
                            <td>
                                {% if entry %}
                                    {% if entry.repairOrder %}<a href="{{ path('maxeme_repair_order_edit', { id: entry.repairOrder.id }) }}">{{ entry.repairOrder.createdOn|date('m/d/Y') }} · {{ ro_number(entry.repairOrder) }}</a>{% endif %}
                                    <div class="muted-line">{{ entry.serviceName }}</div>
                                {% else %}
                                    {% set invoice = reminder.invoice %}
                                    {% if invoice and invoice.appointment %}Date: {{ invoice.appointment.endTime|date('m/d/Y') }}{% endif %}
                                    {% if invoice and invoice.serviceLines|length %}<ul class="muted-line">{% for line in invoice.serviceLines %}<li>{{ line.name }}</li>{% endfor %}</ul>{% endif %}
                                {% endif %}
                            </td>
                            <td>
                                {% if entry %}
                                    {{ entry.serviceName }}<div class="muted-line">{{ entry.reminderDays }} days · due {{ entry.dueAt|date('m/d/Y') }}</div>
                                {% else %}
                                    {{ reminder.note }}
                                    {% if reminder.delayNote %}<div class="muted-line"><strong>Delayed{{ reminder.delayedAt ? ' ' ~ reminder.delayedAt|date('m/d/Y') }}:</strong> {{ reminder.delayNote }}</div>{% endif %}
                                {% endif %}
                            </td>
                            <td class="mx-nowrap">
                                {% for n, number in client.phones %}<div class="phone-line" title="Phone Number {{ n }}">{{ mx_icon('phone') }} {{ number|phone }}</div>{% else %}<span class="muted-line">—</span>{% endfor %}
                            </td>
                            <td>
                                {% if canManage %}
                                    <select class="js-phone-status" data-kind="{{ row.kind }}" data-id="{{ source.id }}" aria-label="Phone status">
                                        {% for status in phoneStatuses %}<option value="{{ status.value }}" {{ row.phoneStatus == status.value ? 'selected' }}>{{ status.label }}</option>{% endfor %}
                                    </select>
                                {% else %}
                                    {{ source.phoneStatus.label }}
                                {% endif %}
                            </td>
                            <td>{{ (entry ? entry.email : null) ?: client.email ?: '—' }}</td>
                            <td>
                                {% if row.emailStatus %}
                                    <span class="badge {{ row.emailStatus == 'sent' ? 'success' : (row.emailStatus == 'error' ? 'danger' : (row.emailStatus == 'skipped' ? 'warn' : 'info')) }}" {% if entry.sentAt %}title="Sent {{ entry.sentAt|date('m/d/Y g:i A') }}"{% endif %}>{{ emailStatuses[row.emailStatus] }}</span>
                                    {% if entry.error %}<div class="muted-line">{{ entry.error }}</div>{% endif %}
                                {% else %}<span class="muted-line">—</span>{% endif %}
                            </td>
                            <td>
                                <div class="mx-actions">
                                    {% if entry %}
                                        <a class="button mx-btn-sm outline" href="{{ path('maxeme_reminder_queue_email', { id: entry.id }) }}">View email</a>
                                        {% if canManage and entry.live %}
                                            <button type="button" class="button mx-btn-sm outline js-post-action" data-reload data-url="{{ path('maxeme_reminder_queue_resend', { id: entry.id }) }}" data-token="{{ csrf_token_value() }}">{{ entry.sentAt ? 'Resend' : 'Send now' }}</button>
                                            <button type="button" class="button mx-btn-sm primary js-post-action" data-reload data-url="{{ path('maxeme_reminder_queue_resolve', { id: entry.id }) }}" data-token="{{ csrf_token_value() }}">Resolved</button>
                                        {% endif %}
                                    {% elseif canManage and reminder.status.isOpen %}
                                        <button type="button" class="button mx-btn-sm primary js-post-action" data-reload
                                                data-url="{{ path('maxeme_reminder_status', { id: reminder.id }) }}" data-token="{{ csrf_token_value() }}" data-params="{{ { status: 'resolved' }|json_encode }}">Resolved</button>
                                        {% if reminder.status.value != 'delayed' %}
                                            <button type="button" class="button mx-btn-sm mx-warning" data-modal-open="#reminder-modal"
                                                    data-form-action="{{ path('maxeme_reminder_status', { id: reminder.id }) }}" data-form-values="{{ { note: '' }|json_encode }}">Delayed</button>
                                        {% endif %}
                                        <button type="button" class="button mx-btn-sm danger js-post-action" data-reload
                                                data-url="{{ path('maxeme_reminder_status', { id: reminder.id }) }}" data-token="{{ csrf_token_value() }}" data-params="{{ { status: 'declined' }|json_encode }}"
                                                data-confirm-title="Decline Confirmation" data-confirm-before="Mark the reminder for " data-item="{{ client.fullName }}" data-confirm-after=" as declined?">Declined</button>
                                    {% endif %}
                                    {{ mx.logs_link(source) }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="{{ 11 + (canBook ? 1 : 0) }}" class="empty-table-cell">No reminders match.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        </div>
        {{ mx.list_footer(page) }}
    </section>

    {% if canManage %}
        <div class="admin-modal-overlay" id="reminder-modal" role="dialog" aria-modal="true" aria-labelledby="reminder-modal-title">
            <div class="admin-modal">
                <button class="admin-modal-x js-modal-close" type="button" aria-label="Close">&times;</button>
                <div class="admin-modal-header"><h2 id="reminder-modal-title">Enter reason for delay:</h2></div>
                <form method="post" action="">
                    {{ csrf_field() }}{{ mx.return_field() }}
                    <input type="hidden" name="status" value="delayed">
                    <div class="admin-modal-body">
                        <textarea name="note" placeholder="Enter note" rows="7" required></textarea>
                        <p class="muted-line">A reason is required. The reminder's own note is kept as it is.</p>
                    </div>
                    <div class="admin-modal-footer-split">
                        <button type="button" class="button outline js-modal-close">Close</button>
                        <button type="submit" class="button primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
        <script>
            /* Phone Status: saved as soon as it is changed (mockup aa322bb). */
            (function () {
                var card = document.getElementById('reminder-card');
                card.addEventListener('change', function (event) {
                    var select = event.target.closest('.js-phone-status');
                    if (!select) { return; }
                    var url = card.getAttribute('data-phone-url').replace('/reminder/0/', '/' + select.getAttribute('data-kind') + '/' + select.getAttribute('data-id') + '/');
                    var body = new FormData();
                    body.append('phone_status', select.value);
                    fetch(url, { method: 'POST', body: body, headers: { 'X-CSRF-TOKEN': card.getAttribute('data-token'), 'Accept': 'application/json' } })
                        .then(function (response) { return response.json().then(function (json) { window.WC.showToast(json.message, response.ok ? 'success' : 'error'); }); })
                        .catch(function () { window.WC.showToast('The phone status could not be saved.', 'error'); });
                });
            })();
        </script>
    {% endif %}
{% endblock %}
