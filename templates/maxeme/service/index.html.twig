{% extends 'admin/_main/layout.html.twig' %}
{% import 'maxeme/_macros.html.twig' as mx %}
{% block title %}Services | {{ site_name() }}{% endblock %}
{% block admin_body %}
    {% set canEdit = is_granted('/service/edit') %}
    {% embed 'maxeme/_page_header.html.twig' with { eyebrow: 'Parts & Services', title: 'Manage Service', lead: 'Services with their standard price and their lines (labour, parts, sublet, government fees, discount), used on invoices and work orders. Click a name, label, price or tax class to change it in place.' } %}
        {% block title_actions %}
            <a id="manageAddButton" class="button mx-btn-sm mx-success" href="{{ path('maxeme_service_new', { _return: app.request.requestUri }) }}">+ Add a new service</a>
            {# The current view (column search boxes, sort), every page. #}
            <a id="serviceExportButton" class="button mx-btn-sm outline" href="{{ path('maxeme_service_export', app.request.query.all) }}">Export CSV</a>
        {% endblock %}
    {% endembed %}

    <section class="table-card" id="service-card" {{ mx.list_card_attrs(page) }}>
        <div class="table-header">
            <h2>Services</h2>
        </div>
        <div class="wide-table-wrap">
            <table id="service-table">
                <thead>
                    <tr>
                        {% for key, label in { name: 'Name', preferredName: 'Label', price: 'Default Price' } %}{{ mx.sort_th(page, key, label) }}{% endfor %}
                        {# Colour is the calendar colour: the service's own, else its category's. #}
                        <th>Tax Class</th><th>Colour</th><th>Service Lines</th>
                        <th style="text-align:center;">Actions</th>
                    </tr>
                    <tr class="filter-row">
                        {% for field, label in { name: 'Name', preferredName: 'Label', price: null, taxClass: null, colour: null, lines: null } %}
                            <th>{% if label %}<input type="search" value="{{ page.query.filters[field] ?? '' }}" data-filter-field="{{ field }}" placeholder="Search" aria-label="Search {{ label|lower }}">{% endif %}</th>
                        {% endfor %}
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for service in page.items %}
                        <tr id="row_{{ service.id }}" {% if canEdit %}data-inline-url="{{ path('maxeme_service_inline', { id: service.id }) }}"{% endif %}>
                            <td data-label="Name" {% if canEdit %}data-inline-field="name" title="Click to edit"{% endif %}>{{ service.name }}</td>
                            <td data-label="Label" {% if canEdit %}data-inline-field="preferred_name" title="Click to edit"{% endif %}>{{ service.preferredName }}</td>
                            <td data-label="Default Price" class="num" {% if canEdit %}data-inline-field="price" data-inline-value="{{ service.price }}" title="Click to edit"{% endif %}>{{ mx.money(service.price) }}</td>
                            <td data-label="Tax Class" {% if canEdit %}data-inline-field="tax_class_id" data-inline-value="{{ service.taxClass ? service.taxClass.id }}" data-inline-options="{{ taxOptions|json_encode }}" title="Click to edit"{% endif %}>{{ service.taxClass ? service.taxClass.label : '—' }}</td>
                            <td data-label="Colour">{% include 'maxeme/service/_colour.html.twig' with { colour: service.colour, label: service.ownColour ? 'Own colour' : (service.category ? service.category.path) } only %}</td>
                            <td data-label="Service Lines">
                                {% if service.lines is empty %}<span class="mx-muted-cell">—</span>{% else %}
                                    <ul class="mx-service-lines">
                                        {% for line in service.lines %}
                                            <li><strong>{{ line.type.label }}</strong>{% if line.type.hasItem %} · {{ line.itemLabel }}{% endif %} · {{ line.quantity + 0 }} × {{ mx.money(line.unitPrice) }}{% if line.chargeThrough %} <span class="badge success" title="Charge through: shown on the invoice and added to the total">Charged</span>{% endif %}</li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </td>
                            <td data-label="Actions" style="text-align:center;">
                                <div class="mx-actions">
                                        <a class="button mx-btn-sm mx-success" href="{{ path('maxeme_service_edit', { id: service.id, _return: app.request.requestUri }) }}">Edit</a>
                                        <button type="button" class="button mx-btn-sm danger js-post-action" data-remove-row="#row_{{ service.id }}"
                                                data-url="{{ path('maxeme_service_delete', { id: service.id }) }}"
                                                data-token="{{ csrf_token_value() }}"
                                                data-confirm-title="Delete Confirmation"
                                                data-confirm-before="Are you sure you want to delete "
                                                data-item="{{ service.name }}"
                                                data-confirm-after="?">Delete</button>
                                    {{ mx.logs_link(service) }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" class="empty-table-cell">No data available in table</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {{ mx.list_footer(page) }}
    </section>

{% endblock %}
