{% extends 'admin/_main/layout.html.twig' %}
{% import 'maxeme/_macros.html.twig' as mx %}
{% block title %}Services | {{ site_name() }}{% endblock %}
{% block admin_body %}
    {% embed 'maxeme/_page_header.html.twig' with { eyebrow: 'Parts & Services', title: 'Manage Service', lead: 'Services with their standard price and their lines (labour, parts, sublet, government fees, discount), used on invoices and work orders.' } %}
        {% block title_actions %}
            <a id="manageAddButton" class="button mx-btn-sm mx-success" href="{{ path('maxeme_service_new', { _return: app.request.requestUri }) }}">+ Add a new service</a>
            {# The current view (column search boxes, sort), every page. #}
            <a id="serviceExportButton" class="button mx-btn-sm outline" href="{{ path('maxeme_service_export', app.request.query.all) }}">Export CSV</a>
        {% endblock %}
    {% endembed %}

    <section class="table-card" id="service-card" {{ mx.list_card_attrs(page) }}>
        <div class="table-header">
            <h2>Services</h2>
        </div>
        <div class="wide-table-wrap">
            <table id="service-table">
                <thead>
                    <tr>
                        {% for key, label in { name: 'Name', preferredName: 'Label', price: 'Default Price' } %}{{ mx.sort_th(page, key, label) }}{% endfor %}
                        {# Colour is the calendar colour: the service's own, else its category's. #}
                        <th>Tax Class</th><th>Colour</th>
                        <th style="text-align:center;">Actions</th>
                    </tr>
                    <tr class="filter-row">
                        {% for field, label in { name: 'Name', preferredName: 'Label', price: null, taxClass: null, colour: null } %}
                            <th>{% if label %}<input type="search" value="{{ page.query.filters[field] ?? '' }}" data-filter-field="{{ field }}" placeholder="Search" aria-label="Search {{ label|lower }}">{% endif %}</th>
                        {% endfor %}
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for service in page.items %}
                        <tr id="row_{{ service.id }}">
                            <td data-label="Name">{{ service.name }}</td>
                            <td data-label="Label">{{ service.preferredName }}</td>
                            <td data-label="Default Price" class="num">{{ mx.money(service.price) }}</td>
                            <td data-label="Tax Class">{% if service.taxClass %}{{ service.taxClass.label }}{% else %}<span class="mx-muted-cell">—</span>{% endif %}</td>
                            <td data-label="Colour">{% include 'maxeme/service/_colour.html.twig' with { colour: service.colour, label: service.ownColour ? 'Own colour' : (service.category ? service.category.path) } only %}</td>
                            <td data-label="Actions" style="text-align:center;">
                                <div class="mx-actions">
                                        <a class="button mx-btn-sm mx-success" href="{{ path('maxeme_service_edit', { id: service.id, _return: app.request.requestUri }) }}">Edit</a>
                                        <button type="button" class="button mx-btn-sm danger js-post-action" data-remove-row="#row_{{ service.id }}"
                                                data-url="{{ path('maxeme_service_delete', { id: service.id }) }}"
                                                data-token="{{ csrf_token_value() }}"
                                                data-confirm-title="Delete Confirmation"
                                                data-confirm-before="Are you sure you want to delete "
                                                data-item="{{ service.name }}"
                                                data-confirm-after="?">Delete</button>
                                    {{ mx.logs_link(service) }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="empty-table-cell">No data available in table</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {{ mx.list_footer(page) }}
    </section>

{% endblock %}
