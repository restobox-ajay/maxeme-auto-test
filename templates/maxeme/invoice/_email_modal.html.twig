{# "Email PDF" (legacy #myModal / #myModal2). Vars: id, title, action, invoice. #}
{% import 'maxeme/_macros.html.twig' as mx %}
<div class="admin-modal-overlay" id="{{ id }}" role="dialog" aria-modal="true" aria-labelledby="{{ id }}-title">
    <div class="admin-modal" style="max-width:560px">
        <button class="admin-modal-x js-modal-close" type="button" aria-label="Close">&times;</button>
        <h2 id="{{ id }}-title" style="margin-top:0">{{ title }}</h2>
        <form method="post" class="form-grid js-email-form" action="{{ action }}">
            {{ csrf_field() }}{{ mx.return_field() }}
            <label class="span-2">Email-Ids *<input type="email" multiple name="emails" required title="One or more email addresses, separated by commas." value="{{ invoice.client ? invoice.client.email }}"></label>
            <p class="mx-email-error span-2" role="alert"></p>
            <p class="mx-help span-2">Please add comma to separate each email address if you want to send to multiple recipients.</p>
            <div class="form-actions span-2">
                <button class="button mx-success" type="submit">Send</button>
                <button class="button outline js-modal-close" type="button">Close</button>
            </div>
        </form>
    </div>
</div>
