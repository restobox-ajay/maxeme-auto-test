{# The invoice / work order document CSS, one copy for the page and the PDF. dompdf cannot read CSS
   variables, so the colours come in as `c` (theme variables on screen, hex in the PDF). #}
{% set c = c|default({ band: 'var(--mx-navbar)', bandInk: 'var(--card)', accent: 'var(--mx-primary-hover)', ink: 'var(--ink-body)', line: 'var(--line)', soft: 'var(--line-light)', muted: 'var(--muted)', card: 'var(--card)' }) %}
.invoice-document { background: {{ c.card }}; color: {{ c.ink }}; border: 1px solid {{ c.line }}; border-radius: 4px; overflow: hidden; }
.inv-band { padding: 9px 16px; background: {{ c.band }}; color: {{ c.bandInk }}; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
.inv-band table { width: 100%; border-collapse: collapse; }
.inv-band td { color: {{ c.bandInk }}; padding: 0; vertical-align: middle; }
.inv-band .site { font-size: 14px; font-weight: bold; }
.inv-band .label { font-size: 17px; font-weight: bold; text-align: right; }
.inv-band .label small { display: block; font-size: 10px; font-weight: normal; }
.invoice-body { padding: 14px 18px 18px; }
.inv-meta-table, .inv-addr-table, .inv-footer-table { width: 100%; border-collapse: collapse; }
.inv-meta-col { width: 33.33%; vertical-align: top; font-size: 11px; line-height: 1.45; padding-right: 14px; }
.inv-meta-col.last { padding-right: 0; text-align: right; }
.inv-meta-col p, .address-box p { margin: 0; }
.invoice-section-title { font-size: 12px; font-weight: bold; color: {{ c.accent }}; border-bottom: 1px solid {{ c.ink }}; padding-bottom: 2px; margin: 12px 0 6px; }
.address-box { width: 50%; vertical-align: top; padding-right: 14px; font-size: 11px; line-height: 1.45; }
.address-box h3 { font-size: 11.5px; font-weight: bold; color: {{ c.accent }}; margin: 0 0 3px; }
.invoice-table { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
.invoice-table th { font-size: 11px; font-weight: bold; text-align: left; padding: 5px 6px; border-bottom: 1px solid {{ c.ink }}; background: {{ c.soft }}; }
.invoice-table td { font-size: 11px; padding: 5px 6px; border-bottom: 1px solid {{ c.line }}; vertical-align: top; }
.invoice-table .r, .totals-inner .r { text-align: right; }
.inv-footer-table { margin-top: 10px; }
.footer-note { vertical-align: top; font-size: 11px; color: {{ c.muted }}; padding: 6px 20px 0 0; line-height: 1.45; }
.footer-note p { margin: 3px 0 0; color: {{ c.ink }}; }
.footer-totals { vertical-align: top; width: 270px; border-top: 1px solid {{ c.ink }}; padding-top: 6px; }
.totals-inner { width: 100%; border-collapse: collapse; }
.totals-inner td { font-size: 11px; padding: 2px 0; }
.grand-total-row td { border-top: 2px solid {{ c.ink }}; font-size: 13px; font-weight: bold; color: {{ c.accent }}; padding-top: 5px; }
.wo-table { width: 100%; border-collapse: collapse; margin-top: 10px; }
.wo-table th, .wo-table td { border: 1px solid {{ c.line }}; padding: 6px 8px; font-size: 11.5px; line-height: 1.45; vertical-align: top; text-align: left; }
.wo-table p { margin: 0 0 6px; }
.wo-items td { height: 80px; }
.wo-master { font-size: 12.5px; }
.wo-blank { display: inline-block; width: 120px; border-bottom: 1px solid {{ c.muted }}; vertical-align: bottom; height: 1em; }
.wo-blank-wide { width: 260px; }
.wo-mileage-miles { padding-left: 62px; }
.wo-tech { border-bottom: 1px solid {{ c.muted }}; width: 70%; margin-top: 8px; }
.wo-agreement { font-size: 11.5px; line-height: 1.5; margin-top: 16px; }
.wo-sign { width: 100%; margin-top: 22px; border-collapse: collapse; }
.wo-sign td { width: 45%; border-bottom: 1px solid {{ c.muted }}; padding-bottom: 4px; font-weight: bold; font-size: 11.5px; }
.wo-sign td.gap { width: 10%; border: 0; }
