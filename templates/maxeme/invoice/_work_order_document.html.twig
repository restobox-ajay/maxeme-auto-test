{# The repair order for the technicians (legacy invoice_workorder / invoice_workorder_pdf), laid out
   like the repair order's work order (mockup e533d51, 986d771): the Assigned Technician only when its
   repair order has one, Phone 1, 2 and Address, the vehicle as one "Name:" line with VIN, License and
   Mileage (KM / MILES), then each service and standalone part with room for the technician's
   result. No appointment note, authorisation text or signature lines. "First Printed On" (mockup
   f556ee8): set on the first print or PDF, never changed; blank on an unsaved (blank) work order. Vars: invoice, kind,
   vehicles, addresses + address (optional: the blank work order's vehicle switch and its
   pickup-address pick, the client's addresses in the client's order). #}
{% if vehicles|default([])|length > 1 or addresses|default([])|length > 1 %}<form id="wo-switch" method="get" hidden></form>{% endif %}
<div class="invoice-document">
    {% include 'maxeme/invoice/_band.html.twig' with { label: 'REPAIR ORDER', detail: maxeme_company.name ~ ' · ' ~ maxeme_company.address ~ ' · Company Phone: ' ~ maxeme_company.phone } only %}
    <div class="invoice-body">
        <table class="wo-table">
            <tr>
                <td style="width:50%"><strong>Work Order Number:</strong> {{ doc_number(invoice, kind) }}</td>
                <td style="width:50%"><strong>First Printed On:</strong> <span id="wo-first-printed" {{ invoice.workOrderFirstPrintedAt ? '' : 'data-unset' }}>{% if invoice.workOrderFirstPrintedAt %}{{ invoice.workOrderFirstPrintedAt|date('m/d/Y h:i a') }}{% else %}<span class="muted-line no-print">set when first printed</span>{% endif %}</span></td>
            </tr>
            {% set technician = invoice.repairOrder and invoice.repairOrder.masterTechnician ? invoice.repairOrder.masterTechnician.name %}
            {% if technician %}
                <tr><td colspan="2" class="wo-master"><strong>Assigned Technician:</strong> {{ technician }}</td></tr>
            {% endif %}
            <tr>
                <td>
                    <p><strong>Bill to</strong></p>
                    <p>{{ invoice.clientFullName }}</p>
                    {% set phones = [invoice.clientHomeNumber, invoice.clientCellNumber]|filter(phone => phone) %}
                    {% for phone in phones %}<p>Phone {{ loop.index }}: {{ phone|phone }}</p>{% else %}<p>Phone: <span class="wo-blank"></span></p>{% endfor %}
                    <p>Address:
                        {% if addresses|default([])|length > 1 %}
                            <select class="no-print-border" name="address" form="wo-switch" onchange="this.form.submit()" aria-label="Pickup address">
                                {% for option in addresses %}<option value="{{ option.id }}" {{ option == address ? 'selected' }}>{{ loop.index }}. {{ option.label ? option.label ~ ' — ' }}{{ option.oneLine }}</option>{% endfor %}
                            </select>
                        {% else %}
                            {{ invoice.clientAddress }}
                        {% endif %}
                    </p>
                </td>
                <td>
                    <p><strong>Vehicle</strong></p>
                    {% if vehicles|default([])|length > 1 %}
                        <p>Vehicle: <select class="no-print-border" name="vehicle" form="wo-switch" onchange="this.form.submit()" aria-label="Vehicle">
                            {% for vehicle in vehicles %}<option value="{{ vehicle.id }}" {{ vehicle == invoice.vehicle ? 'selected' }}>{{ vehicle.fullName }}</option>{% endfor %}
                        </select></p>
                    {% endif %}
                    <p>Name: {{ [invoice.vehicleYear, invoice.vehicleManufacturer, invoice.vehicleModel]|filter(v => v)|join(' ') }}</p>
                    <p>VIN: {{ invoice.vehicleVin }}</p>
                    <p>License: {{ invoice.vehicleLicense }}</p>
                    {% include 'maxeme/document/_mileage.html.twig' with { mileage: invoice.vehicleMileage, unit: invoice.vehicleMileageUnit.label } only %}
                </td>
            </tr>
        </table>

        <div class="invoice-section-title wo-section-title">Repair Items</div>
        <table class="wo-table wo-items item-table">
            <thead><tr><th style="width:50%">Repair Items</th><th>Results</th></tr></thead>
            <tbody>
                {% for line in invoice.topServiceLines|merge(invoice.standalonePartLines) %}
                    <tr>
                        <td>{{ line.name }}</td>
                        <td><div class="wo-tech">Technician:</div></td>
                    </tr>
                {% else %}
                    {% for i in 1..5 %}<tr><td></td><td><div class="wo-tech">Technician:</div></td></tr>{% endfor %}
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
