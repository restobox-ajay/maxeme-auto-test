{# The repair order for the technicians (legacy invoice_workorder / invoice_workorder_pdf): the master
   technician (its repair order's, else a line to fill in), Phone 1, 2… and Address, the vehicle's
   Make, Year, Model, VIN, License and Mileage (KM, and a line for Miles), then each service and
   standalone part, the parts to use, and a Technician line. Vars: invoice, kind,
   vehicles, addresses + address (optional: the blank work order's vehicle switch and its
   pickup-address pick, the client's addresses in the client's order). #}
{% if vehicles|default([])|length > 1 or addresses|default([])|length > 1 %}<form id="wo-switch" method="get" hidden></form>{% endif %}
<div class="invoice-document">
    {% include 'maxeme/invoice/_band.html.twig' with { label: 'REPAIR ORDER', detail: maxeme_company.address ~ ' · Company Phone: ' ~ maxeme_company.phone } only %}
    <div class="invoice-body">
        <table class="wo-table">
            <tr>
                <td style="width:50%"><strong>Work Order Number:</strong> {{ doc_number(invoice, kind) }}</td>
                <td style="width:50%"><strong>Last Modified On:</strong> {{ (invoice.saved ? invoice.documentDate : 'now')|date('m/d/Y h:i a') }}</td>
            </tr>
            <tr>
                {% set technician = invoice.repairOrder and invoice.repairOrder.masterTechnician ? invoice.repairOrder.masterTechnician.name %}
                <td colspan="2" class="wo-master"><strong>Master Technician:</strong> {% if technician %}{{ technician }}{% else %}<span class="wo-blank wo-blank-wide"></span>{% endif %}</td>
            </tr>
            <tr>
                <td>
                    <p><strong>Bill to</strong></p>
                    <p>{{ invoice.clientFullName }}</p>
                    {% set phones = [invoice.clientHomeNumber, invoice.clientCellNumber]|filter(phone => phone) %}
                    {% for phone in phones %}<p>Phone {{ loop.index }}: {{ phone }}</p>{% else %}<p>Phone: <span class="wo-blank"></span></p>{% endfor %}
                    <p>Address:
                        {% if addresses|default([])|length > 1 %}
                            <select class="no-print-border" name="address" form="wo-switch" onchange="this.form.submit()" aria-label="Pickup address">
                                {% for option in addresses %}<option value="{{ option.id }}" {{ option == address ? 'selected' }}>{{ loop.index }}. {{ option.label ? option.label ~ ' — ' }}{{ option.oneLine }}</option>{% endfor %}
                            </select>
                        {% else %}
                            {{ invoice.clientAddress }}
                        {% endif %}
                    </p>
                    {% if invoice.saved %}<p><strong>Appointment Note:</strong> {{ invoice.note }}</p>{% endif %}
                </td>
                <td>
                    <p><strong>Vehicle</strong></p>
                    {% if vehicles|default([])|length > 1 %}
                        <p>Vehicle: <select class="no-print-border" name="vehicle" form="wo-switch" onchange="this.form.submit()" aria-label="Vehicle">
                            {% for vehicle in vehicles %}<option value="{{ vehicle.id }}" {{ vehicle == invoice.vehicle ? 'selected' }}>{{ vehicle.fullName }}</option>{% endfor %}
                        </select></p>
                    {% endif %}
                    <p>Make: {{ invoice.vehicleManufacturer }}</p>
                    <p>Year: {{ invoice.vehicleYear }}</p>
                    <p>Model: {{ invoice.vehicleModel }}</p>
                    <p>VIN: {{ invoice.vehicleVin }}</p>
                    <p>License: {{ invoice.vehicleLicense }}</p>
                    {% include 'maxeme/document/_mileage.html.twig' with { mileage: invoice.vehicleMileage } only %}
                </td>
            </tr>
        </table>

        <div class="invoice-section-title">Repair Items</div>
        <table class="wo-table wo-items item-table">
            <thead><tr><th style="width:50%">Repair Items</th><th>Results</th></tr></thead>
            <tbody>
                {% for line in invoice.serviceLines|merge(invoice.standalonePartLines) %}
                    <tr>
                        <td>{{ line.name }}</td>
                        <td>
                            {% if line.parts is defined %}{% for part in line.parts %}<div>x{{ part.quantity }} {{ part.name }}</div>{% endfor %}{% endif %}
                            <div class="wo-tech">Technician:</div>
                        </td>
                    </tr>
                {% else %}
                    {% for i in 1..5 %}<tr><td></td><td><div class="wo-tech">Technician:</div></td></tr>{% endfor %}
                {% endfor %}
            </tbody>
        </table>

        <div class="wo-agreement">
            <p>I here by authorize the above repaid work to be done along with necessary materials. You and your employees may operate above vehicle for purpose of testing, inspection or delivery at my risk.</p>
            <table class="wo-sign"><tr><td>Signature:</td><td class="gap"></td><td>Date:</td></tr></table>
        </div>
    </div>
</div>
