{# One row of the builder's item table. Vars: index (row number or "__ROW__" for the JS template),
   type ('Services' | 'Parts'), id, name, quantity, price, parts (the service's InvoicePartLines),
   chargeThrough (optional: the service's charge-through InvoiceServiceLines, shown read-only; they are
   kept on save and their amount counts in the live total), tax (optional: the saved service line's
   LineTax, which it keeps; otherwise the live total takes the service's from the tax map). #}
{% set base = 'items[' ~ index ~ ']' %}
<tr class="item-row"{% if tax|default(null) %} data-gst="{{ tax.gst ? 1 : 0 }}" data-pst="{{ tax.pst ? 1 : 0 }}"{% endif %}>
    <td class="item-name">
        <div class="mx-name-group">
            <input class="item-name-search" type="text" name="{{ base }}[name]" value="{{ name }}" placeholder="Enter item name here" autocomplete="off">
            <input class="item-value" type="hidden" name="{{ base }}[id]" value="{{ id }}">
            <input class="item-type" type="hidden" name="{{ base }}[type]" value="{{ type }}">
            <button type="button" class="button mx-btn-sm primary add_part" {{ type == 'Parts' ? 'hidden' }}>Add Parts</button>
        </div>
        <ul class="mx-parts-list" data-base="{{ base }}">
            {% for line in parts %}
                {% include 'maxeme/invoice/_part_row.html.twig' with { base: base, index: loop.index0, part: { id: line.product ? line.product.id, name: line.name, quantity: line.quantity } } only %}
            {% endfor %}
        </ul>
        {% if chargeThrough|default([])|length %}
            {% set extraCents = 0 %}{% set extraGst = 0 %}{% set extraPst = 0 %}
            {% for extra in chargeThrough %}{% set extraCents = extraCents + extra.totalCents %}{% set extraGst = extraGst + (extra.chargesGst ? extra.totalCents : 0) %}{% set extraPst = extraPst + (extra.chargesPst ? extra.totalCents : 0) %}{% endfor %}
            <ul class="mx-charge-through muted-line" data-cents="{{ extraCents }}" data-gst-cents="{{ extraGst }}" data-pst-cents="{{ extraPst }}" title="Charge-through lines of the service, billed with it">
                {% for extra in chargeThrough %}<li>&#8627; {{ extra.name }} · x{{ extra.quantity + 0 }} @ {{ extra.salePrice|number_format(2, '.', ',') }} = {{ (extra.totalCents / 100)|number_format(2, '.', ',') }}</li>{% endfor %}
            </ul>
        {% endif %}
    </td>
    <td class="item-quantity num"><input type="number" class="item-quantity-field" name="{{ base }}[quantity]" value="{{ quantity }}" min="1" max="99" step="1" aria-label="Quantity"></td>
    <td class="item-price num"><input type="text" class="item-price-field" name="{{ base }}[price]" value="{{ price }}" {{ input_rule('money') }} aria-label="Price"></td>
    <td class="item-controls ctl">
        <button type="button" class="mini-action danger item-remove" title="remove item">&minus;</button>
        <button type="button" class="mini-action item-add" title="add item">+</button>
    </td>
</tr>
