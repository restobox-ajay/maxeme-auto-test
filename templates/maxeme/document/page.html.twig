{# The on-screen page of an invoice, quote or work order (a PrintedDocument), its header on one row
   (mockups 38af4be, 345c037): the title and status with the repair order's document switcher beside
   them; on the right this document's own actions first (the quote's Approve / Decline, the invoice's
   Edit), then its PDF menu, then More (Change Invoice # / Work Order #, Logs, Back). ?print=1 prints it
   on arrival (the switcher's Print). Vars: document, repairOrder (or null), invoice (or null), actions
   (this document's {label, url, class} links and its {menu: {label, printUrl, pdfUrl, emailUrl}}),
   backUrl, numberChange ({label, url, value, automatic} or null), quoteDecision (the quote's, or null). #}
{% extends 'admin/_main/layout.html.twig' %}
{% import 'maxeme/_macros.html.twig' as mx %}
{% import 'maxeme/document/_menus.html.twig' as menus %}
{% block title %}{{ document.kind.emailTitle }} {{ document.number }} | {{ site_name() }}{% endblock %}
{% block head_extra %}
    <style>
        {% include 'maxeme/invoice/_document_styles.html.twig' only %}
    </style>
{% endblock %}
{% block admin_body %}
    {% set decision = quoteDecision|default(null) %}
    {% set logsTarget = invoice ?? repairOrder %}
    <section class="panel compact-panel no-print mx-doc-head">
        <div class="panel-title-row">
            <div>
                <p class="eyebrow">{{ repairOrder ? 'Repair Order ' ~ ro_number(repairOrder) ~ ' · ' }}{{ document.kind.emailTitle }}</p>
                <div class="title-with-status">
                    <h1>{{ document.kind.emailTitle }} {{ document.number }}</h1>
                    {% if invoice %}<span class="badge {{ invoice.status.badge }}">{{ invoice.status.label }}</span>{% elseif repairOrder %}<span class="badge {{ repairOrder.status.badge }}">{{ repairOrder.status.label }}</span>{% endif %}
                    {% if repairOrder %}{% include 'maxeme/repair_order/_docnav.html.twig' with { repairOrder: repairOrder, current: invoice ? 'invoice' : document.kind.value, invoice: invoice } only %}{% endif %}
                </div>
                <p class="lead">{{ document.clientName }} · {{ document.vehicleName }}</p>
            </div>
            <div class="panel-actions mx-doc-actions" aria-label="{{ document.kind.emailTitle }} actions">
                {% if decision and repairOrder %}
                    {# The customer's answer to the quote (mockup aa322bb). #}
                    {% if decision.open and decision.canDecide %}
                        <button class="button mx-success" type="button" id="quote-approve" data-modal-open="#quote-approve-modal">Approve</button>
                        <button class="button danger" type="button" id="quote-decline" data-modal-open="#quote-decline-modal">Decline</button>
                    {% elseif repairOrder.status.value == 'cancelled' and repairOrder.quoteDeclinedAt %}
                        <span class="badge danger" title="Declined {{ repairOrder.quoteDeclinedAt|date('m/d/Y') }}">Quote declined</span>
                    {% elseif repairOrder.quoteApprovedAt %}
                        <span class="badge success">Approved {{ repairOrder.quoteApprovedVia ? repairOrder.quoteApprovedVia.phrase }} · {{ repairOrder.quoteApprovedAt|date('m/d/Y') }}</span>
                    {% endif %}
                {% endif %}
                {% for action in actions|filter(a => a.menu is not defined) %}
                    <a class="button {{ action.class|default('outline') }}" href="{{ action.url }}">{{ action.label }}</a>
                {% endfor %}
                {% set pay = paymentMenu|default(null) %}
                {% if invoice and pay %}
                    {# Payment ▾ (mockup 345c037). #}
                    <details class="mx-menu" id="payment-menu">
                        <summary class="button outline">Payment <span aria-hidden="true">▾</span></summary>
                        <div class="mx-menu-list" role="menu">
                            {% if pay.canEdit and pay.balance > 0 %}
                                <button role="menuitem" type="button" data-modal-open="#mark-paid-modal">Mark Paid</button>
                                <a role="menuitem" href="{{ path('maxeme_invoice_payment_new', { invoiceKey: invoice.invoiceKey }) }}">Add Payment</a>
                            {% endif %}
                            <a role="menuitem" href="{{ path('maxeme_invoice_payments', { invoiceKey: invoice.invoiceKey }) }}">View Payments ({{ pay.count }})</a>
                        </div>
                    </details>
                {% endif %}
                {% for action in actions|filter(a => a.menu is defined) %}
                    {{ menus.pdf_menu(action.menu.label, action.menu.printUrl, action.menu.pdfUrl, action.menu.emailUrl) }}
                {% endfor %}
                <details class="mx-menu mx-more">
                    <summary class="button outline" aria-label="More">&#8943;</summary>
                    <div class="mx-menu-list" role="menu">
                        {% if numberChange|default(null) %}<button role="menuitem" type="button" id="change-number" data-modal-open="#change-number-modal">{{ numberChange.label }}</button>{% endif %}
                        {{ mx.logs_link(logsTarget, '') }}
                        <a role="menuitem" href="{{ backUrl }}">Back</a>
                    </div>
                </details>
            </div>
        </div>
    </section>
    {% if outOfDate|default(false) and invoice and repairOrder %}
        {# The repair order changed since this unpaid invoice was issued (mockup 0a4baef). #}
        <div class="mx-alert mx-alert-warn no-print" id="invoice-out-of-date" role="status">
            <div>
                <strong><span class="badge danger">Out of date</span> {{ ro_number(repairOrder) }} changed since {{ doc_number(invoice) }} was issued.</strong>
                <p class="muted-line">Sync to bring the invoice up to the repair order's current lines, fees and totals. Its number, date and payments stay.</p>
            </div>
            {% if is_granted('/accounting/edit') %}<form method="post" action="{{ path('maxeme_invoice_issued_sync', { invoiceKey: invoice.invoiceKey }) }}" class="mx-inline-form">{{ csrf_field() }}<input type="hidden" name="_return" value="{{ app.request.requestUri }}"><button class="button mx-warning" type="submit" title="Take the repair order's current lines, fees and totals; the number, date and payments stay">Sync Repair Order</button></form>{% endif %}
        </div>
    {% endif %}
    {% if offerClose|default(false) and repairOrder %}
        {# A payment made the invoice Paid while the repair order is still open (mockup 84d136d). #}
        <div class="mx-alert mx-alert-info no-print" id="offer-close" role="status">
            <div>
                <strong>Complete {{ ro_number(repairOrder) }} and lock it?</strong>
                <p class="muted-line">{{ invoice ? doc_number(invoice) : 'The invoice' }} is paid, but {{ ro_number(repairOrder) }} is still {{ repairOrder.status.label }}. Completing it locks the repair order and marks its appointments Completed (read-only except notes). Leave it if the work is still to be done (for example a prepayment).</p>
            </div>
            <form method="post" action="{{ path('maxeme_repair_order_complete_and_lock', { id: repairOrder.id }) }}">
                {{ csrf_field() }}
                <input type="hidden" name="_return" value="{{ app.request.pathInfo }}">
                <button class="button mx-success" type="submit">Complete and lock</button>
            </form>
        </div>
    {% endif %}
    {% if invoice and is_granted('/accounting/view') %}
        {# The Remark (mockup d2fbfc8): internal, shown to staff above the invoice, never part of it, never printed. #}
        <section class="panel compact-panel no-print mx-remark-card" id="invoice-remark">
            <strong>Remark</strong> <span class="muted-line">(internal: never printed)</span>
            {# P19 (mockup): the remark as text, then an Add / Edit remark link that opens the box. #}
            <div class="mx-remark-text-block">{% if invoice.adminNote %}{{ invoice.adminNote }}{% else %}<span class="muted-line">No remark.</span>{% endif %}</div>
            {% if is_granted('/accounting/edit') %}
            <details class="mx-remark-edit-toggle"><summary>{{ invoice.adminNote ? 'Edit remark' : 'Add remark' }}</summary>
                <form method="post" action="{{ path('maxeme_invoice_remark', { invoiceKey: invoice.invoiceKey }) }}" class="mx-remark-form">
                    {{ csrf_field() }}
                    <textarea name="admin_note" rows="2" maxlength="1000" placeholder="No remark.">{{ invoice.adminNote }}</textarea>
                    <button class="button mx-btn-sm outline" type="submit">{{ invoice.adminNote ? 'Save remark' : 'Add remark' }}</button>
                </form>
            </details>
            {% endif %}
        </section>
    {% endif %}
    <div class="invoice-page-container">
        {% include document.kind.printedTemplate with { document: document } only %}
    </div>
    {% if numberChange|default(null) %}
        <div class="admin-modal-overlay" id="change-number-modal" role="dialog" aria-modal="true" aria-labelledby="change-number-title">
            <div class="admin-modal">
                <button class="admin-modal-x js-modal-close" type="button" aria-label="Close">&times;</button>
                <div class="admin-modal-header"><h2 id="change-number-title">{{ numberChange.label }}</h2></div>
                <form method="post" action="{{ numberChange.url }}">
                    {{ csrf_field() }}{{ mx.return_field() }}
                    <div class="admin-modal-body">
                        <label class="form-label" for="change-number-input">Number</label>
                        <input type="text" id="change-number-input" name="number" value="{{ numberChange.value }}" maxlength="{{ constant('App\\Maxeme\\Document\\DocumentNumberEditor::MAX_LENGTH') }}" placeholder="{{ numberChange.automatic }}">
                        <p class="muted-line">Leave it blank for the automatic number, {{ numberChange.automatic }}. It is printed and emailed as typed.</p>
                    </div>
                    <div class="admin-modal-footer-split">
                        <button type="button" class="button outline js-modal-close">Close</button>
                        <button type="submit" class="button primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    {% endif %}
    {% if document.kind.value == 'work_order' and repairOrder %}<script src="/assets/js/maxeme-first-printed.js?v=1" data-url="{{ path('maxeme_repair_order_work_order_printed', { id: repairOrder.id }) }}" data-token="{{ csrf_token_value() }}"></script>{% endif %}
    {% if invoice and paymentMenu|default(null) and paymentMenu.canEdit and paymentMenu.balance > 0 %}
        <div class="admin-modal-overlay" id="mark-paid-modal" role="dialog" aria-modal="true" aria-labelledby="mark-paid-title">
            <div class="admin-modal">
                <button class="admin-modal-x js-modal-close" type="button" aria-label="Close">&times;</button>
                <div class="admin-modal-header"><h2 id="mark-paid-title">Mark {{ doc_number(invoice) }} paid</h2></div>
                <form method="post" action="{{ path('maxeme_invoice_mark_paid', { invoiceKey: invoice.invoiceKey }) }}">
                    {{ csrf_field() }}
                    <div class="admin-modal-body">
                        <p>One payment of the balance due, <strong>${{ mx.money(paymentMenu.balance) }}</strong>, now.</p>
                        <label class="form-label" for="mark-paid-method">Payment method</label>
                        <select id="mark-paid-method" name="payment_type_id" required>
                            {% for type in paymentMenu.types %}<option value="{{ type.id }}" {{ invoice.paymentType == type ? 'selected' }}>{{ type.name }}</option>{% endfor %}
                        </select>
                    </div>
                    <div class="admin-modal-footer-split">
                        <button type="button" class="button outline js-modal-close">Close</button>
                        <button type="submit" class="button mx-success">Mark Paid</button>
                    </div>
                </form>
            </div>
        </div>
    {% endif %}
    {% if decision and decision.open and decision.canDecide %}
        {% for mode in ['approve', 'decline'] %}
            {% set approve = mode == 'approve' %}
            <div class="admin-modal-overlay" id="quote-{{ mode }}-modal" role="dialog" aria-modal="true" aria-labelledby="quote-{{ mode }}-title">
                <div class="admin-modal">
                    <button class="admin-modal-x js-modal-close" type="button" aria-label="Close">&times;</button>
                    <div class="admin-modal-header"><h2 id="quote-{{ mode }}-title">{{ approve ? 'Approve this quote' : 'Decline this quote' }}</h2></div>
                    <form method="post" action="{{ decision.url }}">
                        {{ csrf_field() }}
                        <input type="hidden" name="decision" value="{{ mode }}">
                        <div class="admin-modal-body">
                            {% if approve %}
                                <label class="form-label" for="quote-via">How was it approved?</label>
                                <select id="quote-via" name="via" required>{% for way in decision.ways %}<option value="{{ way.value }}">{{ way.label }}</option>{% endfor %}</select>
                                <p class="muted-line">The repair order becomes Authorized.</p>
                            {% else %}
                                <p class="muted-line">The repair order becomes Cancelled, and its pending appointments with it.</p>
                            {% endif %}
                            <label class="form-label" for="quote-{{ mode }}-note">{{ approve ? 'Note (optional)' : 'Reason for declining' }}</label>
                            <textarea id="quote-{{ mode }}-note" name="note" rows="3" maxlength="450" {{ approve ? '' : 'required' }}></textarea>
                        </div>
                        <div class="admin-modal-footer-split">
                            <button type="button" class="button outline js-modal-close">Close</button>
                            <button type="submit" class="button {{ approve ? 'mx-success' : 'danger' }}">{{ approve ? 'Approve' : 'Decline' }}</button>
                        </div>
                    </form>
                </div>
            </div>
        {% endfor %}
    {% endif %}
    {% if app.request.query.get('print') %}<script>window.addEventListener('load', function () { window.print(); });</script>{% endif %}
{% endblock %}
