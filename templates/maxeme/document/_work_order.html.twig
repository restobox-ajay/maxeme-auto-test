{# A repair order's work order for the technicians (a PrintedDocument), as the client asked (mockup
   e533d51, 986d771, 345c037): the black-and-white header with the company on one line, the Assigned
   Technician only when one is set, the customer's first two phones and address, the vehicle as one
   "Name: year make model" line with VIN, License and Mileage (KM / MILES), then each service with
   room for the technician's result. The internal comment, the authorisation text and the
   signature lines are not printed. "First Printed On" (mockup f556ee8) is set the first time it is
   printed or saved as a PDF and never changes; page.html.twig fills it in on the first print. Vars: document. #}
<div class="invoice-document">
    {% include 'maxeme/invoice/_band.html.twig' with { label: 'REPAIR ORDER', detail: maxeme_company.name ~ ' · ' ~ maxeme_company.address ~ ' · Company Phone: ' ~ maxeme_company.phone } only %}
    <div class="invoice-body">
        <table class="wo-table">
            <tr>
                <td style="width:50%"><strong>Work Order Number:</strong> {{ document.number }}</td>
                <td style="width:50%"><strong>First Printed On:</strong> <span id="wo-first-printed" {{ document.firstPrinted ? '' : 'data-unset' }}>{% if document.firstPrinted %}{{ document.firstPrinted|date('m/d/Y h:i a') }}{% else %}<span class="muted-line no-print">set when first printed</span>{% endif %}</span></td>
            </tr>
            {% if document.masterTechnician %}
                <tr><td colspan="2" class="wo-master"><strong>Assigned Technician:</strong> {{ document.masterTechnician }}</td></tr>
            {% endif %}
            <tr>
                <td>
                    <p><strong>Bill to</strong></p>
                    <p>{{ document.clientName }}</p>
                    {% for phone in document.phones|slice(0, 2) %}<p>Phone {{ loop.index }}: {{ phone }}</p>{% else %}<p>Phone: <span class="wo-blank"></span></p>{% endfor %}
                    <p>Address: {{ document.address }}</p>
                </td>
                <td>
                    <p><strong>Vehicle</strong></p>
                    <p>Name: {{ document.vehicleName }}</p>
                    <p>VIN: {{ document.vehicleVin }}</p>
                    <p>License: {{ document.vehicleLicense }}</p>
                    {% include 'maxeme/document/_mileage.html.twig' with { mileage: document.mileage, unit: document.mileageUnit } only %}
                </td>
            </tr>
        </table>

        <div class="invoice-section-title wo-section-title">Repair Items</div>
        <table class="wo-table wo-items item-table">
            <thead><tr><th style="width:50%">Repair Items</th><th>Results</th></tr></thead>
            <tbody>
                {% for item in document.repairItems %}
                    <tr><td>{{ item.name }}</td><td><div class="wo-tech"><strong>Technician:</strong> {% if item.technician|default(null) %}{{ item.technician }}{% else %}<span class="wo-blank"></span>{% endif %}{% if item.workStatus|default(null) %} · {{ item.workStatus }}{% endif %}</div></td></tr>
                {% else %}
                    {% for i in 1..5 %}<tr><td></td><td><div class="wo-tech">Technician:</div></td></tr>{% endfor %}
                {% endfor %}
            </tbody>
        </table>
        {# For the customer (mockup 169b599): also carried onto the invoice. #}
        {% if document.recommendations %}<p class="wo-recommendations"><strong>Recommendations:</strong><br>{{ document.recommendations|nl2br }}</p>{% endif %}
    </div>
</div>
