{# The fields Labour and Government Fees share (AbstractChargeData). Vars: priceLabel, taxClasses. #}
<label>Code *<input type="text" name="code" maxlength="40" pattern="[A-Za-z0-9_\-]+" title="Letters, digits, - and _" required></label>
<label>Name *<input type="text" name="name" maxlength="255" required></label>
<label>{{ priceLabel }} *<input type="text" name="price" inputmode="decimal" pattern="\d{1,8}(\.\d{1,2})?" title="An amount in dollars, e.g. 12.50" required></label>
<label>Tax class *
    <select name="tax_class" required>
        {% for class in taxClasses %}<option value="{{ class.value }}">{{ class.label }}</option>{% endfor %}
    </select>
</label>
<label class="mx-check"><input type="checkbox" name="active" value="1" checked> Active</label>
