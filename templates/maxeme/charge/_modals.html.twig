{# Add / edit modals of a charge list (mockup labour.html / govt-fees.html): a sectioned popup, two columns
   with labels above. Vars: noun ("Labour"), createUrl, fields (a template of extra fields, as macros
   after_price() and before_active()), priceLabel, taxClasses, units (Labour only). #}
{% import 'maxeme/_macros.html.twig' as mx %}
{% for modal in [
    { id: 'manageAddModal', title: 'Add ' ~ noun, action: createUrl, submit: 'Add' },
    { id: 'manageEditModal', title: 'Edit ' ~ noun, action: '', submit: 'Save' },
] %}
    <div class="admin-modal-overlay" id="{{ modal.id }}" role="dialog" aria-modal="true" aria-labelledby="{{ modal.id }}Label">
        <div class="admin-modal mx-modal-wide mx-modal-sectioned">
            <div class="mx-modal-head">
                <div><h2 id="{{ modal.id }}Label">{{ modal.title }}</h2></div>
                <button class="admin-modal-x js-modal-close" type="button" aria-label="Close">&times;</button>
            </div>
            <form method="post" action="{{ modal.action }}">
                {{ csrf_field() }}{{ mx.return_field() }}
                <div class="mx-modal-body form-grid inline-form-grid">
                    {% include 'maxeme/charge/_fields.html.twig' with { priceLabel: priceLabel, taxClasses: taxClasses, fields: fields, units: units|default([]) } only %}
                </div>
                <div class="mx-modal-foot">
                    <button class="button outline js-modal-close" type="button">Cancel</button>
                    <button class="button primary" type="submit">{{ modal.submit }}</button>
                </div>
            </form>
        </div>
    </div>
{% endfor %}
