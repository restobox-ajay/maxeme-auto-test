{% extends 'admin/_main/layout.html.twig' %}
{% block title %}Activity #{{ entry.id }} | {{ site_name() }}{% endblock %}
{# Breadcrumb: the third part, as in the mockup. #}{% block crumb_tail %}Detail{% endblock %}
{% block admin_body %}
    {% embed 'maxeme/_page_header.html.twig' with { eyebrow: 'Activity Log', title: entry.summary, lead: entry.occurredAt|date('m/d/Y h:i:s A') ~ ' · ' ~ entry.actorName ~ (entry.actorRole ? ' (' ~ entry.actorRole ~ ')') } %}
        {% block actions %}
            <a class="button back-button" href="{{ path('maxeme_activity_log_index', back) }}">Back</a>
        {% endblock %}
    {% endembed %}

    {# L3: the details and the changes side by side, as in the mockup. #}
    <div class="mx-grid2">
        <section class="form-card mx-kv-card">
            <dl class="mx-kv">
                <dt>User</dt><dd>{{ entry.actorName }}{{ entry.actorId ? ' (#' ~ entry.actorId ~ ')' }}</dd>
                <dt>Role</dt><dd>{{ entry.actorRole ?? '—' }}</dd>
                <dt>Area</dt><dd>{{ entry.area }}</dd>
                <dt>Action</dt><dd>{{ entry.action|replace({ '_': ' ' }) }}</dd>
                <dt>Record</dt><dd>{{ entry.entityType }}{{ entry.entityId ? ' #' ~ entry.entityId }}</dd>
                <dt>IP address</dt><dd>{{ entry.ipAddress ?? '—' }}</dd>
            </dl>
        </section>

        <section class="table-card no-paginate">
            <div class="table-header"><h2>Changes</h2></div>
            <div class="wide-table-wrap">
                <table id="activity-changes">
                    <thead><tr><th>Field</th><th>Before</th><th>After</th></tr></thead>
                    <tbody>
                        {% for field, pair in changes.fields %}
                            <tr>
                                <td data-label="Field"><strong>{{ field }}</strong></td>
                                <td data-label="Before">{% include 'maxeme/activity_log/_value.html.twig' with { value: pair[0] } only %}</td>
                                <td data-label="After">{% include 'maxeme/activity_log/_value.html.twig' with { value: pair[1] } only %}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="3" class="empty-table-cell">This action changed no record.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </div>
{% endblock %}
