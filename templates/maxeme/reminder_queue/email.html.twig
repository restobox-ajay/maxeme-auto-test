{# Service Reminder Queue › View email: the reminder as it was sent, or as it will be. Vars: entry, email ({subject, html}). #}
{% extends 'admin/_main/layout.html.twig' %}
{% import 'maxeme/_macros.html.twig' as mx %}
{% block title %}Service Reminder Email | {{ site_name() }}{% endblock %}
{% block admin_body %}
    {% embed 'maxeme/_page_header.html.twig' with { eyebrow: 'Service Reminder Queue', title: 'Service Reminder Email', lead: entry.client.fullName ~ ' · ' ~ entry.vehicle.fullName ~ ' · ' ~ entry.serviceName } %}
        {% block title_actions %}
            {% import 'maxeme/_macros.html.twig' as mx %}
            <a class="button mx-btn-sm outline" href="{{ path('maxeme_reminder_queue_index') }}">Back to the queue</a>
            {% if is_granted('/reminder/edit') %}
                <form method="post" action="{{ path('maxeme_reminder_queue_resend', { id: entry.id }) }}">{{ csrf_field() }}{{ mx.return_field() }}<button type="submit" class="button mx-btn-sm primary">{{ entry.status.value == 'sent' ? 'Resend' : 'Send now' }}</button></form>
            {% endif %}
        {% endblock %}
    {% endembed %}

    <section class="table-card no-search no-paginate mx-reminder-email">
        <dl class="mx-reminder-email-meta">
            <dt>Status</dt><dd><span class="badge {{ entry.status.badge }}">{{ entry.status.label }}</span>{% if entry.error %} {{ entry.error }}{% endif %}</dd>
            <dt>To</dt><dd>{{ entry.email ?: entry.client.email ?: '—' }}</dd>
            <dt>{{ entry.sentAt ? 'Sent' : 'Due' }}</dt><dd>{{ entry.sentAt ? entry.sentAt|date('m/d/Y h:i A') : entry.dueAt|date('m/d/Y') }}</dd>
            <dt>Subject</dt><dd><strong>{{ email.subject }}</strong></dd>
        </dl>
        <iframe class="mx-reminder-email-body" sandbox="" srcdoc="{{ email.html }}" title="Email body"></iframe>
    </section>
{% endblock %}
