{% extends 'admin/_main/layout.html.twig' %}
{% import 'maxeme/_macros.html.twig' as mx %}
{% block title %}Change Password | {{ site_name() }}{% endblock %}
{% block admin_body %}
    {% include 'maxeme/_page_header.html.twig' with { eyebrow: 'Account', title: 'Change Password', lead: 'Enter your current password, then the new one twice.' } only %}

    <section class="form-card">
        <form class="form-grid" method="post" action="{{ path('maxeme_profile_change_password') }}" novalidate>
            {{ csrf_field() }}
            {{ mx.form_errors(errors) }}
            <label class="span-2">Current password<input type="password" name="current_password" required autocomplete="current-password"></label>
            <label>New password<input type="password" name="new_password" required autocomplete="new-password"></label>
            <label>Repeat new password<input type="password" name="confirm_new_password" required autocomplete="new-password"></label>
            <div class="form-actions span-2">
                <button type="submit" class="button primary">Change password</button>
                <a class="button outline" href="{{ path('maxeme_profile_show') }}">Cancel</a>
            </div>
        </form>
    </section>
{% endblock %}
