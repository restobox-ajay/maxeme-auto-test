{# Shared Maxeme template helpers. Import with: {% import 'maxeme/_macros.html.twig' as mx %} #}

{# A form's validation errors, collected in one alert at the top of the form (as the mockup shows them). #}
{% macro form_errors(errors, class = 'span-2') %}
    {%- if errors is not empty -%}
        <div class="alert error {{ class }}">{% for message in errors %}{{ message }}{% if not loop.last %}<br>{% endif %}{% endfor %}</div>
    {%- endif -%}
{% endmacro %}

{# Export CSV of a table that shows every row on the page (maxeme.js [data-csv-of], mockup a38e7a2); logged to the Activity Log. #}
{% macro csv_button(filename, table, area, entity, class = 'button mx-btn-sm outline') -%}
    <a class="{{ class }}" href="#" data-csv="{{ filename }}" data-csv-of="{{ table }}" data-csv-area="{{ area }}" data-csv-entity="{{ entity }}"
       data-log-url="{{ path('maxeme_export_logged') }}" data-token="{{ csrf_token_value() }}">Export CSV</a>
{%- endmacro %}

{# Hidden field that sends a modal form back to the page (and filters) it was opened from. #}
{% macro return_field() %}
    <input type="hidden" name="{{ constant('App\\Maxeme\\Controller\\AbstractMaxemeController::RETURN_FIELD') }}" value="{{ app.request.requestUri }}">
{%- endmacro %}

{# ── Server-side lists: core's URL-driven .table-card (app.js navigates, ListQuery reads it back) ── #}

{# The attributes a .table-card needs for app.js's per-page select and pager. `page` is a ListPage. #}
{% macro list_card_attrs(page) -%}
    data-per-page="{{ page.query.limit }}" data-current-page="{{ page.query.page }}" data-pages="{{ page.pageCount }}" data-default-sort="{{ page.query.defaultSort }}" data-default-dir="{{ page.query.defaultDir }}"
{%- endmacro %}

{# A header app.js makes sortable, marked with the current sort. #}
{# cls: the header's own class (e.g. "num"), kept beside the sorted mark. #}
{% macro sort_th(page, key, label, attrs = '', cls = '') -%}
    <th data-sort-field="{{ key }}" class="{{ cls }}{{ page.query.sort == key ? (cls ? ' ' : '') ~ 'is-sorted-' ~ page.query.dir }}" {{ attrs|raw }}>{{ label }}</th>
{%- endmacro %}

{# The search box app.js submits as ?q=. #}
{% macro list_search(page, label) -%}
    <div class="table-tools"><input class="table-search" type="search" placeholder="Search" value="{{ page.query.search }}" aria-label="Search {{ label }}"></div>
{%- endmacro %}

{# "Showing x to y of z entries"; app.js adds the per-page select and pager around it. #}
{% macro list_footer(page) -%}
    <div class="table-footer">
        {% include 'admin/_table_count.html.twig' with { count: page.items|length, total: page.total, currentPage: page.query.page, perPage: page.query.limit } only %}
    </div>
{%- endmacro %}

{# A row's Delete button: asks "Are you sure you want to delete <item>?", posts to url with the CSRF
   token (maxeme.js .js-post-action) and removes the row (removeRow, a CSS selector) when it worked. #}
{% macro delete_button(url, removeRow, item, extraClass = '', before = 'Are you sure you want to delete ') -%}
    <button type="button" class="button mx-btn-sm danger {{ extraClass ? extraClass ~ ' ' }}js-post-action" data-remove-row="{{ removeRow }}"
            data-url="{{ url }}"
            data-token="{{ csrf_token_value() }}"
            data-confirm-title="Delete Confirmation"
            data-confirm-before="{{ before }}"
            data-item="{{ item }}"
            data-confirm-after="?">Delete</button>
{%- endmacro %}

{# A dollar amount (decimal string or null) shown with two decimals; blank when there is none.
   Core's |amount filter (DisplayNumber) is the one money format; this name stays for the call sites. #}
{% macro money(value) -%}
    {{ value|amount }}
{%- endmacro %}

{# A printed invoice's payment rows under the totals (InvoicePayments::summary()): paid, the method and
   amount (each method when split) and any change; unpaid, what was paid so far and the balance due;
   cancelled (or none: a quote), nothing. #}
{% macro payment_rows(payment) -%}
    {% import _self as mx %}
    {% if payment and payment.paid %}
        {% if payment.methods|length > 1 %}
            {% for method in payment.methods %}<tr><td>Payment method: {{ method.type }}</td><td class="r"><strong>{{ mx.money(method.amount) }}</strong></td></tr>{% endfor %}
        {% else %}
        <tr><td>Payment method: {{ payment.type }}</td><td class="r"><strong>{{ mx.money(payment.amount) }}</strong></td></tr>
        {% endif %}
        {% if payment.change > 0 %}<tr><td>Change:</td><td class="r"><strong>{{ mx.money(payment.change) }}</strong></td></tr>{% endif %}
    {% elseif payment and not payment.cancelled %}
        {% if payment.paidSoFar > 0 %}<tr><td>Paid so far:</td><td class="r"><strong>{{ mx.money(payment.paidSoFar) }}</strong></td></tr>{% endif %}
        <tr><td>Balance due:</td><td class="r"><strong>{{ mx.money(payment.balance) }}</strong></td></tr>
    {% endif %}
{%- endmacro %}

{# The Logs button every record has: its history in the Activity Log (who changed what, and when),
   for the roles that may read the log. In an .mx-actions group it lands in the ⋯ menu after two. #}
{% macro logs_link(record, class = 'button outline mx-btn-sm') -%}
    {%- set target = audit_record(record) -%}
    {%- if target.id is not null and is_granted('/log/view') -%}
        <a class="{{ class }}" href="{{ path('maxeme_activity_log_index', target) }}">Logs</a>
    {%- endif -%}
{%- endmacro %}
