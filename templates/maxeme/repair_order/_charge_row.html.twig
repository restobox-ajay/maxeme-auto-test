{# One custom fee or discount under the subtotal (a repair order's or an invoice's). Vars: index (number, or
   "__CHARGE__" in the JS template), charge (DocumentChargeData or null), chargeKinds, errors, removeClass
   (the Delete button's hook: the repair order page's "charge-remove", else maxeme.js's "js-row-remove"),
   discountOnly (new rows are discounts, no new fees). #}
{% set base = 'charges[' ~ index ~ ']' %}
{% set errorAt = 'charges.' ~ index ~ '.' %}
<tr class="mx-charge-row">
    <td colspan="2">
        <input type="hidden" name="{{ base }}[id]" value="{{ charge ? charge.id }}">
        <span class="mx-charge-fields">
            {# discountOnly (the repair order page, mockup 9d04430): a new row is a discount; an existing fee stays as it is. #}
            {% set kindNow = charge ? charge.kind : (discountOnly|default(false) ? 'discount' : 'fee') %}
            <select class="charge-kind" name="{{ base }}[kind]" aria-label="Fee or discount">
                {% for kind in chargeKinds %}{% if not discountOnly|default(false) or kind.value == 'discount' or kind.value == kindNow %}<option value="{{ kind.value }}" {{ kindNow == kind.value ? 'selected' }}>{{ kind.label }}</option>{% endif %}{% endfor %}
            </select>
            <input class="charge-label {{ errors[errorAt ~ 'label'] is defined ? 'is-invalid' }}" type="text" name="{{ base }}[label]" value="{{ charge ? charge.label }}" maxlength="120" placeholder="{{ discountOnly|default(false) ? 'e.g. Loyalty discount' : 'e.g. Shop supplies' }}" aria-label="What it is for">
        </span>
    </td>
    <td class="num"><input class="charge-amount {{ errors[errorAt ~ 'amount'] is defined ? 'is-invalid' }}" type="text" name="{{ base }}[amount]" value="{{ charge ? charge.amount }}" placeholder="0.00" {{ input_rule('money') }} aria-label="Amount"></td>
    <td class="ctl"><button type="button" class="button mx-btn-sm danger {{ removeClass|default('charge-remove') }}">Delete</button></td>
</tr>
