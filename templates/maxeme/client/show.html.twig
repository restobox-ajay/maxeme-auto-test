{% extends 'admin/_main/layout.html.twig' %}
{% import 'maxeme/_macros.html.twig' as mx %}
{% block title %}{{ client.fullName }} | {{ site_name() }}{% endblock %}
{% block admin_body %}
    {% set canManage = is_granted('ROLE_MANAGER') %}

    <section class="panel compact-panel">
        <div class="panel-title-row">
            <div>
                <p class="eyebrow">Client</p>
                <h1 id="client-fullname">{{ client.fullName }}</h1>
                <p class="lead">Client #{{ client.id }}{{ client.address ? ' · ' ~ client.address }}</p>
            </div>
            <div class="panel-actions">
                <a class="button back-button" href="{{ path('maxeme_client_index') }}">Back</a>
                {% if canManage %}
                    <a id="add_client_appointment" class="button primary" href="{{ path('maxeme_appointment_new', { id: client.id }) }}">+ Add new appointment for {{ client.fullName }}</a>
                    {# With no vehicles the link comes back here with "Client does not have any vehicles!", so it opens in place. #}
                    <a id="client_empty_workorder" class="button outline" href="{{ path('maxeme_work_order_blank', { id: client.id }) }}" {{ client.vehicles|length ? 'target="_blank" rel="noopener"' }}>Empty Work Order (Print Only)</a>
                {% endif %}
            </div>
        </div>
    </section>

    <nav class="detail-tabs mx-profile-tabs" aria-label="Client profile sections">
        {% for item in tabs %}
            <a href="{{ path('maxeme_client_show', { id: client.id, tab: item.value }) }}" class="{{ item == tab ? 'is-active' }}" {{ item == tab ? 'aria-current="page"' }}>{{ item.label }}</a>
        {% endfor %}
    </nav>

    {% if tab.value == 'info' %}
        {# Client Profile tab (legacy _user_info.html.twig) #}
        <section class="form-card">
            <form id="manageEditFormBody" method="post" action="{{ path('maxeme_client_update', { id: client.id }) }}">
                {{ csrf_field() }}
                <div class="mx-form-head">
                    <h2>Client Profile</h2>
                    {% if canManage %}<button id="manageEditSubmit" class="button primary mx-btn-sm edit_client" type="submit">Update</button>{% endif %}
                </div>
                <div class="client-info-blocks">
                    <div>{% include 'maxeme/client/_fields.html.twig' with { data: form, only: ['first_name', 'last_name', 'preferred_name'], readonly: not canManage } only %}</div>
                    <div>{% include 'maxeme/client/_fields.html.twig' with { data: form, only: ['email', 'home_number', 'work_number', 'cell_number'], readonly: not canManage } only %}</div>
                    <div>{% include 'maxeme/client/_fields.html.twig' with { data: form, only: ['address', 'note'], readonly: not canManage, noteClass: '' } only %}</div>
                </div>
            </form>
        </section>
    {% elseif tab.value == 'vehicles' %}
        {# Vehicles tab (legacy _vehicles.html.twig) #}
        <section class="table-card" id="vehicle-grid" {{ mx.list_card_attrs(vehicles) }}>
            <div class="table-header">
                <h2>Vehicles</h2>
                {% if canManage %}
                    <button class="button primary mx-btn-sm" type="button" data-modal-open="#manageAddModal">+ Add new vehicle to {{ client.fullName }}</button>
                {% endif %}
                {{ mx.list_search(vehicles, 'vehicles') }}
            </div>
            <div class="wide-table-wrap">
                <table id="vechicle-table_{{ client.id }}">
                    <thead>
                        <tr>
                            {% for key, label in { manufacturer: 'Manufacturer', model: 'Model', year: 'Year', vin: 'Vin', color: 'Color', note: 'Note' } %}{{ mx.sort_th(vehicles, key, label) }}{% endfor %}
                            {% if canManage %}<th style="width:65px"></th>{% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for vehicle in vehicles.items %}
                            <tr id="row_{{ vehicle.id }}">
                                <td data-label="Manufacturer">{{ vehicle.manufacturer }}</td>
                                <td data-label="Model">{{ vehicle.model }}</td>
                                <td data-label="Year">{{ vehicle.year }}</td>
                                <td data-label="Vin">{{ vehicle.vin }}</td>
                                <td data-label="Color">{{ vehicle.color }}</td>
                                <td data-label="Note">{{ vehicle.note }}</td>
                                {% if canManage %}
                                    <td data-label="Actions">
                                        <div class="row-action-menu">
                                            <button class="table-action row-action-toggle" type="button" aria-expanded="false" aria-label="Vehicle actions"></button>
                                            <div class="row-action-dropdown">
                                                <button type="button" class="edit_client_vehicle" data-modal-open="#manageEditClientVehicleModal"
                                                        data-form-action="{{ path('maxeme_vehicle_update', { id: vehicle.id }) }}"
                                                        data-form-values="{{ form_values(vehicle)|json_encode }}">Edit</button>
                                                <button type="button" class="delete_client_vehicle danger js-post-action" data-remove-row="#row_{{ vehicle.id }}"
                                                        data-url="{{ path('maxeme_vehicle_delete', { id: vehicle.id }) }}"
                                                        data-token="{{ csrf_token_value() }}"
                                                        data-confirm-title="Delete Confirmation"
                                                        data-confirm-before="Are you sure you want to delete "
                                                        data-item="{{ vehicle.fullName }}"
                                                        data-confirm-after="?">Delete</button>
                                            </div>
                                        </div>
                                    </td>
                                {% endif %}
                            </tr>
                        {% else %}
                            <tr><td colspan="{{ canManage ? 7 : 6 }}" class="empty-table-cell">No data available in table</td></tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr><th>Manufacturer</th><th>Model</th><th>Year</th><th>Vin</th><th>Color</th><th>Note</th>{% if canManage %}<th></th>{% endif %}</tr>
                    </tfoot>
                </table>
            </div>
            {{ mx.list_footer(vehicles) }}
        </section>

        {% if canManage %}
            <div class="admin-modal-overlay" id="manageAddModal" role="dialog" aria-modal="true" aria-labelledby="manageAddModalLabel">
                <div class="admin-modal mx-modal-wide">
                    <button class="admin-modal-x js-modal-close" type="button" aria-label="Close">&times;</button>
                    <h2 id="manageAddModalLabel" style="margin-top:0">Add A New Vehicle to {{ client.firstName|capitalize }} {{ client.lastName|capitalize }}...</h2>
                    <form id="manageAddForm" class="form-grid" method="post" action="{{ path('maxeme_vehicle_create', { id: client.id }) }}">
                        {{ csrf_field() }}
                        {% include 'maxeme/client/_vehicle_fields.html.twig' only %}
                        <div class="modal-actions span-2">
                            <button id="manageAddModalCancel" class="button outline js-modal-close" type="button">Cancel</button>
                            <button id="manageAddSubmit" class="button primary" type="submit">Add Vehicle</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="admin-modal-overlay" id="manageEditClientVehicleModal" role="dialog" aria-modal="true" aria-labelledby="manageEditClientVehicleModalLabel">
                <div class="admin-modal mx-modal-wide">
                    <button class="admin-modal-x js-modal-close" type="button" aria-label="Close">&times;</button>
                    <h2 id="manageEditClientVehicleModalLabel" style="margin-top:0">Edit the Vehicle...</h2>
                    <form id="vehicleEditFormBody" class="form-grid" method="post" action="">
                        {{ csrf_field() }}
                        {% include 'maxeme/client/_vehicle_fields.html.twig' only %}
                        <div class="modal-actions span-2">
                            <button id="manageEditClientVehicleModalCancel" class="button outline js-modal-close" type="button">Cancel</button>
                            <button id="manageEditClientVehicleSubmit" class="button primary" type="submit">Save</button>
                        </div>
                    </form>
                </div>
            </div>
        {% endif %}
    {% elseif tab.value == 'appointments' %}
        {% include 'maxeme/client/_appointments.html.twig' %}
    {% endif %}
{% endblock %}
