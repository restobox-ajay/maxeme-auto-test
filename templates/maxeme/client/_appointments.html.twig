{# Client Profile › Appointments (legacy Profile/_appointments.html.twig). Vars: client, pending, past,
   invoiceKeys (appointment id => invoice key). Times render in the shop's timezone (Twig's, set by core).
   Accounting gets Invoice (the builder, created on first save); other roles get the Work Order once an
   invoice exists; Appointment edit gets check-in / edit / delete. #}
{% set canInvoice = is_granted('/accounting/view') %}
{% set canEditAppointments = is_granted('/appointment/edit') %}
{% import 'maxeme/_macros.html.twig' as mx %}
<div class="mx-tab-stack">
    <section class="table-card no-paginate" id="pending-card">
        <div class="table-header"><h2>Pending Appointments</h2></div>
        <div class="wide-table-wrap">
            <table id="pending-appointments">
                <thead>
                    <tr><th>Date</th><th>Time</th><th>Vehicle</th><th>Duration</th><th>Note</th><th style="width:80px"></th></tr>
                </thead>
                <tbody>
                    {% for appointment in pending %}
                        <tr id="row_{{ appointment.id }}" class="{{ appointment.status.value }}">
                            <td data-label="Date">{{ appointment.startTime|date('m/d/Y') }}</td>
                            <td data-label="Time">{{ appointment.startTime|date('h:i A') }}</td>
                            <td data-label="Vehicle">{{ appointment.vehicle.fullName }}</td>
                            <td data-label="Duration">{{ appointment.durationInHours|number_format(2) }} Hours</td>
                            <td data-label="Note">{{ appointment.note }}</td>
                            <td data-label="Actions">
                            {% if canInvoice or canEditAppointments %}
                                    <div class="row-action-menu">
                                        <button class="table-action row-action-toggle" type="button" aria-expanded="false" aria-label="Appointment actions"></button>
                                        <div class="row-action-dropdown">
                                            {% if canInvoice %}
                                                <a class="invoice_client_appointment" href="{{ path('maxeme_invoice_for_appointment', { id: appointment.id }) }}" target="_blank" rel="noopener">Invoice</a>
                                            {% elseif invoiceKeys[appointment.id] is defined %}
                                                <a class="workorder-client-apointment" href="{{ path('maxeme_work_order_show', { invoiceKey: invoiceKeys[appointment.id] }) }}" target="_blank" rel="noopener">Work Order</a>
                                            {% endif %}
                                            {% if canEditAppointments %}
                                                {% if appointment.status.value == 'new' %}
                                                    <button type="button" class="checkin_appointment js-post-action" data-reload
                                                            data-url="{{ path('maxeme_appointment_check_in', { id: appointment.id }) }}"
                                                            data-token="{{ csrf_token_value() }}">Check-in</button>
                                                {% endif %}
                                                <a class="edit_client_appointment" href="{{ path('maxeme_appointment_edit', { id: appointment.id }) }}">Edit Appointment</a>
                                                <button type="button" class="delete_client_appointment danger js-post-action" data-remove-row="#row_{{ appointment.id }}"
                                                        data-url="{{ path('maxeme_appointment_delete', { id: appointment.id }) }}"
                                                        data-token="{{ csrf_token_value() }}"
                                                        data-confirm-title="Delete Confirmation"
                                                        data-confirm-before="Are you sure you want to delete "
                                                        data-item="the appointment on {{ appointment.startTime|date('m/d/Y h:i A') }}"
                                                        data-confirm-after="?">Delete Appointment</button>
                                            {% endif %}
                                        </div>
                                    </div>
                            {% elseif invoiceKeys[appointment.id] is defined %}
                                <a class="button outline mx-btn-sm workorder-client-apointment" href="{{ path('maxeme_work_order_show', { invoiceKey: invoiceKeys[appointment.id] }) }}" target="_blank" rel="noopener">Work Order</a>
                            {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="empty-table-cell">No pending appointments.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="table-card" id="past-grid" {{ mx.list_card_attrs(past) }}>
        <div class="table-header">
            <h2>Past Appointments</h2>
            {{ mx.list_search(past, 'past appointments') }}
        </div>
        <div class="wide-table-wrap">
            <table id="past-appointments">
                <thead>
                    <tr>{{ mx.sort_th(past, 'startTime', 'Date') }}<th>Time</th><th>Vehicle</th><th>Duration</th>{{ mx.sort_th(past, 'note', 'Note') }}<th style="width:110px"></th></tr>
                </thead>
                <tbody>
                    {% for appointment in past.items %}
                        <tr id="row_{{ appointment.id }}">
                            <td data-label="Date">{{ appointment.startTime|date('Y-m-d') }}</td>
                            <td data-label="Time">{{ appointment.startTime|date('h:i A') }}</td>
                            <td data-label="Vehicle">{{ appointment.vehicle.fullName }}</td>
                            <td data-label="Duration">{{ appointment.durationInHours }}</td>
                            <td data-label="Note">{{ appointment.note }}</td>
                            <td data-label="Actions">
                                {% if canInvoice %}
                                    <a class="button outline mx-btn-sm invoice_client_appointment" href="{{ path('maxeme_invoice_for_appointment', { id: appointment.id }) }}" target="_blank" rel="noopener">Invoice</a>
                                {% elseif invoiceKeys[appointment.id] is defined %}
                                    <a class="button outline mx-btn-sm" href="{{ path('maxeme_work_order_show', { invoiceKey: invoiceKeys[appointment.id] }) }}" target="_blank" rel="noopener">Work Order</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="empty-table-cell">No data available in table</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {{ mx.list_footer(past) }}
    </section>
</div>
