{# Client form fields (legacy cns_client_info_form, with phone 1-4 for home / work / cell). Vars: data (ClientData or null), only (field names, default all), readonly.
   Each field's type and format match ClientData's constraints (input_rule() / #[Formatted]). #}
{% set labels = { first_name: 'First name', last_name: 'Last name', preferred_name: 'Preferred name', email: 'Email', phone_1: 'Phone Number 1', phone_2: 'Phone Number 2', phone_3: 'Phone Number 3', phone_4: 'Phone Number 4' } %}
{% for field in only|default(labels|keys) %}
    {% set value = data ? attribute(data, constant('App\\Maxeme\\Dto\\ClientData::FIELDS')[field]) : '' %}
    <label>{{ labels[field] }}
        {%- if field == 'email' -%}
            <input type="email" name="email" value="{{ value }}" maxlength="255" autocomplete="off" placeholder="name@example.com" {{ readonly|default(false) ? 'readonly' }}>
        {%- elseif field starts with 'phone_' -%}
            <input type="tel" name="{{ field }}" value="{{ value }}" maxlength="40" {{ input_rule('phone') }} {{ readonly|default(false) ? 'readonly' }}>
        {%- else -%}
            <input type="text" name="{{ field }}" value="{{ value }}" maxlength="255" {{ readonly|default(false) ? 'readonly' }}>
        {%- endif -%}
    </label>
{% endfor %}
