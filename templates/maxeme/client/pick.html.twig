{# Choose a client, then open `for`'s screen for them. Vars: for (ClientPickPurpose), find, page. #}
{% extends 'admin/_main/layout.html.twig' %}
{% import 'maxeme/_macros.html.twig' as mx %}
{% block title %}{{ for.title }} | {{ site_name() }}{% endblock %}
{% block admin_body %}
    {% set param = constant('App\\Maxeme\\Listing\\SearchTerm::PARAM') %}
    {% embed 'maxeme/_page_header.html.twig' with { eyebrow: for.eyebrow, title: for.title, lead: 'Choose the client first: search by name, preferred name, phone, address or invoice #.' } %}
        {% block actions %}
            {% if is_granted('/people/edit') %}<a class="button mx-success" id="pick-new-client" href="{{ path('maxeme_client_index', { add: 1, next: for.value }) }}">+ Create new client</a>{% endif %}
            {# P17 (mockup): a repair order can be started before the customer is known. #}
            {% if for.value == 'repair_order' %}<a class="button outline" id="pick-no-client" href="{{ path('maxeme_repair_order_new') }}">Start without a client</a>{% endif %}
            <a class="button back-button" href="{{ path('maxeme_home') }}">Back</a>
        {% endblock %}
    {% endembed %}

    <section class="panel compact-panel">
        <form method="get" action="{{ path('maxeme_client_pick', { purpose: for.value }) }}" class="mx-pick-search" role="search">
            <input type="search" name="{{ param }}" value="{{ find.text }}" placeholder="Name, phone, address or invoice #" aria-label="Search clients" autofocus>
            <button class="button primary" type="submit">{{ mx_icon('search') }} Search</button>
        </form>
    </section>

    <section class="table-card" id="pick-card" {{ mx.list_card_attrs(page) }}>
        {% include 'maxeme/_search_results.html.twig' with { find: find, page: page, clear: 'maxeme_client_pick', clearParams: { purpose: for.value } } only %}
        <div class="table-header"><h2>Clients</h2></div>
        <div class="wide-table-wrap">
            <table id="pick-table">
                <thead>
                    <tr>
                        {{ mx.sort_th(page, 'firstName', 'First name') }}
                        {{ mx.sort_th(page, 'lastName', 'Last name') }}
                        {{ mx.sort_th(page, 'preferredName', 'Preferred name') }}
                        <th>Phone</th>
                        <th>Address</th>
                        <th style="width:90px"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for client in page.items %}
                        <tr id="pick_{{ client.id }}">
                            <td data-label="First name">{{ client.firstName ?: '—' }}</td>
                            <td data-label="Last name">{{ client.lastName ?: '—' }}</td>
                            <td data-label="Preferred name">{{ client.preferredName ?: '—' }}</td>
                            <td data-label="Phone">{{ client.phones|map(p => p|phone)|join(' · ') ?: '—' }}</td>
                            <td data-label="Address">{{ client.primaryAddress ? client.primaryAddress.oneLine : '—' }}</td>
                            <td data-label="Actions"><a class="button primary mx-btn-sm" href="{{ path(for.route, { id: client.id }) }}">Choose</a></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="empty-table-cell">
                            <strong>No clients match{{ find.text ? ' "' ~ find.text ~ '"' }}.</strong>
                            {% if is_granted('/people/edit') %}<div style="margin-top:8px"><a class="button mx-success" href="{{ path('maxeme_client_index', { add: 1, next: for.value, q: find.text }) }}">+ Create new client{{ find.text ? ' "' ~ find.text ~ '"' }}</a></div>{% endif %}
                        </td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {{ mx.list_footer(page) }}
    </section>
    {# P17 (mockup): the sidebar and breadcrumb point at the screen the client is being picked for
       (Schedule › Repair Order, Appointments or Reminders), not at People › Client. #}
    {% set forList = { repair_order: path('maxeme_repair_order_index'), appointment: path('maxeme_appointment_calendar'), reminder: path('maxeme_reminder_index') }[for.value] %}
    <script>
        // After load: the sidebar script sets its own current item first.
        window.addEventListener('load', function () {
            var link = document.querySelector('.nav a.nav-sub[href="{{ forList|e('js') }}"]');
            if (!link) { return; }
            document.querySelectorAll('.nav .nav-sub.is-current').forEach(function (a) { a.classList.remove('is-current'); });
            link.classList.add('is-current');
            var group = link.closest('.nav-group');
            if (group) {
                document.querySelectorAll('.nav .nav-group.is-open').forEach(function (g) { if (g !== group) { g.classList.remove('is-open'); } });
                group.classList.add('is-open');
                var title = group.querySelector('.nav-group-title .nav-label');
                var crumb = document.querySelector('.mx-crumb');
                if (crumb && title) { crumb.textContent = title.textContent.trim() + ' › ' + link.textContent.trim(); }
            }
        });
    </script>
{% endblock %}
