{% extends 'admin/_main/layout.html.twig' %}
{% import 'maxeme/_macros.html.twig' as mx %}
{% block title %}Client List | {{ site_name() }}{% endblock %}
{% block admin_body %}
    {% set canManage = is_granted('/people/edit') %}
    {# Column => [label, sort key or null, filter field or null], in order. Each column has a search box under its label (filters[field]). #}
    {% set columns = [
        ['First name', 'firstName', 'firstName'],
        ['Last name', 'lastName', 'lastName'],
        ['Preferred name', 'preferredName', 'preferredName'],
        ['Email', 'email', 'email'],
        ['Phone', 'phone', 'phone'],
        ['Address', null, 'address'],
        ['Note', null, 'note'],
        ['Last updated', 'lastUpdated', null],
    ] %}

    {% embed 'maxeme/_page_header.html.twig' with { eyebrow: 'People', title: 'Client List', lead: 'All active clients. Open a profile to manage vehicles, appointments, invoices and work orders.' } %}
        {% block title_actions %}
            {% if canManage %}
                <button id="manageAddButton" class="button mx-btn-sm mx-success" type="button" data-modal-open="#manageAddModal">+ Add a new person</button>
            {% endif %}
            {# The current view (sidebar search, search box, column filters, sort), every page. #}
            <a id="clientExportButton" class="button mx-btn-sm outline" href="{{ path('maxeme_client_export', app.request.query.all) }}">Export CSV</a>
        {% endblock %}
    {% endembed %}

    <section class="table-card" id="client-grid" {{ mx.list_card_attrs(page) }}>
        {% include 'maxeme/_search_results.html.twig' with { find: find, page: page, clear: 'maxeme_client_index' } only %}
        <div class="table-header">
            <h2>Clients</h2>
        </div>
        <div class="wide-table-wrap">
            <table id="client-table" class="client-table">
                <thead>
                    <tr>
                        {% for column in columns %}{% if column[1] %}{{ mx.sort_th(page, column[1], column[0]) }}{% else %}<th>{{ column[0] }}</th>{% endif %}{% endfor %}
                        <th></th>
                    </tr>
                    <tr class="filter-row">
                        {% for column in columns %}
                            <th>{% if column[2] %}<input type="search" value="{{ page.query.filters[column[2]] ?? '' }}" data-filter-field="{{ column[2] }}" placeholder="Search" aria-label="Search {{ column[0]|lower }}">{% endif %}</th>
                        {% endfor %}
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for client in page.items %}
                        {% set profile = path('maxeme_client_show', { id: client.id }) %}
                        <tr id="row_{{ client.id }}">
                            <td data-label="First name"><a class="mx-row-link" href="{{ profile }}">{{ client.firstName }}</a></td>
                            <td data-label="Last name"><a class="mx-row-link" href="{{ profile }}">{{ client.lastName }}</a></td>
                            <td data-label="Preferred name"><a class="mx-row-link" href="{{ profile }}">{{ client.preferredName }}</a></td>
                            <td data-label="Email">{{ client.email }}</td>
                            <td data-label="Phone">{% for phone in client.phones %}<div class="phone-line">{{ phone }}</div>{% endfor %}</td>
                            <td data-label="Address">{{ client.primaryAddress ? client.primaryAddress.oneLine }}</td>
                            <td data-label="Note">{{ client.latestNote ? client.latestNote.text }}</td>
                            <td data-label="Last updated">{{ client.lastUpdated|date('Y-m-d H:i:s') }}</td>
                            <td data-label="Actions">
                                <div class="mx-actions">
                                    <a class="button mx-btn-sm primary client_info" href="{{ profile }}">View</a>
                                    {% if canManage %}
                                        <button type="button" class="button mx-btn-sm mx-success edit_client" data-modal-open="#manageEditModal"
                                                data-form-action="{{ path('maxeme_client_update', { id: client.id }) }}"
                                                data-form-values="{{ form_values(client)|json_encode }}">Edit</button>
                                        <button type="button" class="button mx-btn-sm danger delete_client js-post-action" data-remove-row="#row_{{ client.id }}"
                                                data-url="{{ path('maxeme_client_delete', { id: client.id }) }}"
                                                data-token="{{ csrf_token_value() }}"
                                                data-confirm-title="Delete Confirmation"
                                                data-confirm-before="Are you sure you want to delete "
                                                data-item="{{ client.fullName }}"
                                                data-confirm-after="?">Delete</button>
                                    {% endif %}
                                    {{ mx.logs_link(client) }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="{{ columns|length + 1 }}" class="empty-table-cell">No data available in table</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {{ mx.list_footer(page) }}
    </section>

    {% if canManage %}
        <div class="admin-modal-overlay" id="manageAddModal" role="dialog" aria-modal="true" aria-labelledby="manageAddModalLabel">
            <div class="admin-modal mx-modal-wide mx-modal-sectioned">
                <div class="mx-modal-head">
                    <div><p class="eyebrow">Client</p><h2 id="manageAddModalLabel">Add New Person...</h2></div>
                    <button class="admin-modal-x js-modal-close" type="button" aria-label="Close">&times;</button>
                </div>
                <form id="manageAddForm" method="post" action="{{ path('maxeme_client_create') }}">
                    {{ csrf_field() }}
                    {{ mx.return_field() }}
                    <div class="mx-modal-body form-grid inline-form-grid">
                        {% include 'maxeme/client/_fields.html.twig' with { data: null } only %}
                    </div>
                    <div class="mx-modal-foot">
                        <button id="manageAddModalCancel" class="button outline js-modal-close" type="button">Cancel</button>
                        <button id="manageAddSubmit" class="button primary" type="submit">Save</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="admin-modal-overlay" id="manageEditModal" role="dialog" aria-modal="true" aria-labelledby="manageEditModalLabel">
            <div class="admin-modal mx-modal-wide mx-modal-sectioned">
                <div class="mx-modal-head">
                    <div><p class="eyebrow">Client</p><h2 id="manageEditModalLabel">Edit the Client...</h2></div>
                    <button class="admin-modal-x js-modal-close" type="button" aria-label="Close">&times;</button>
                </div>
                <form id="manageEditFormBody" method="post" action="">
                    {{ csrf_field() }}
                    {{ mx.return_field() }}
                    <div class="mx-modal-body form-grid inline-form-grid">
                        {% include 'maxeme/client/_fields.html.twig' with { data: null } only %}
                    </div>
                    <div class="mx-modal-foot">
                        <button id="manageEditModalCancel" class="button outline js-modal-close" type="button">Cancel</button>
                        <button id="manageEditSubmit" class="button primary" type="submit">Save</button>
                    </div>
                </form>
            </div>
        </div>
    {% endif %}
{% endblock %}
