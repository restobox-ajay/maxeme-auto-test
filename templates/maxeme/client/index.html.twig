{% extends 'admin/_main/layout.html.twig' %}
{% import 'maxeme/_macros.html.twig' as mx %}
{% block title %}Client List | {{ site_name() }}{% endblock %}
{% block admin_body %}
    {% set canManage = is_granted('/people/edit') %}
    {# Sortable columns, then Address (the first in the book) and Note (the newest), then Last updated. #}
    {% set columns = { firstName: 'First name', lastName: 'Last name', preferredName: 'Preferred name', email: 'Email', phone1: 'Phone number 1', phone2: 'Phone number 2', phone3: 'Phone number 3', phone4: 'Phone number 4' } %}

    {% embed 'maxeme/_page_header.html.twig' with { eyebrow: 'People', title: 'Client List', lead: 'All active clients. Open a profile to manage vehicles, appointments, invoices and work orders.' } %}
        {% block actions %}
            {% if canManage %}
                <button id="manageAddButton" class="button mx-success" type="button" data-modal-open="#manageAddModal">+ Add a new person</button>
            {% endif %}
        {% endblock %}
    {% endembed %}

    <section class="table-card" id="client-grid" {{ mx.list_card_attrs(page) }}>
        {% include 'maxeme/_search_results.html.twig' with { find: find, page: page, clear: 'maxeme_client_index' } only %}
        <div class="table-header">
            <h2>Clients</h2>
            {{ mx.list_search(page, 'clients') }}
        </div>
        <div class="wide-table-wrap">
            <table id="client-table" class="client-table">
                <thead>
                    <tr>
                        <th style="width:40px"></th>
                        {% for key, label in columns %}{{ mx.sort_th(page, key, label) }}{% endfor %}
                        <th>Address</th><th>Note</th>{{ mx.sort_th(page, 'lastUpdated', 'Last updated') }}
                        {% if canManage %}<th></th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for client in page.items %}
                        <tr id="row_{{ client.id }}">
                            <td>
                                <a class="mini-action client_info" href="{{ path('maxeme_client_show', { id: client.id }) }}" title="View client profile" aria-label="View {{ client.fullName }}">{{ mx_icon('search') }}</a>
                            </td>
                            <td data-label="First name">{{ client.firstName }}</td>
                            <td data-label="Last name">{{ client.lastName }}</td>
                            <td data-label="Preferred name">{{ client.preferredName }}</td>
                            <td data-label="Email">{{ client.email }}</td>
                            {% for n in 1..4 %}<td data-label="Phone number {{ n }}">{{ attribute(client, 'phone' ~ n) }}</td>{% endfor %}
                            <td data-label="Address">{{ client.primaryAddress ? client.primaryAddress.oneLine }}</td>
                            <td data-label="Note">{{ client.latestNote ? client.latestNote.text }}</td>
                            <td data-label="Last updated">{{ client.lastUpdated|date('Y-m-d H:i:s') }}</td>
                            {% if canManage %}
                                <td data-label="Actions">
                                    <div class="mx-actions">
                                            <button type="button" class="button mx-btn-sm mx-success edit_client" data-modal-open="#manageEditModal"
                                                    data-form-action="{{ path('maxeme_client_update', { id: client.id }) }}"
                                                    data-form-values="{{ form_values(client)|json_encode }}">Edit</button>
                                            <button type="button" class="button mx-btn-sm danger delete_client js-post-action" data-remove-row="#row_{{ client.id }}"
                                                    data-url="{{ path('maxeme_client_delete', { id: client.id }) }}"
                                                    data-token="{{ csrf_token_value() }}"
                                                    data-confirm-title="Delete Confirmation"
                                                    data-confirm-before="Are you sure you want to delete "
                                                    data-item="{{ client.fullName }}"
                                                    data-confirm-after="?">Delete</button>
                                    </div>
                                </td>
                            {% endif %}
                        </tr>
                    {% else %}
                        <tr><td colspan="{{ canManage ? 13 : 12 }}" class="empty-table-cell">No data available in table</td></tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <th></th>
                        {% for label in columns %}<th>{{ label }}</th>{% endfor %}<th>Address</th><th>Note</th><th>Last updated</th>
                        {% if canManage %}<th></th>{% endif %}
                    </tr>
                </tfoot>
            </table>
        </div>
        {{ mx.list_footer(page) }}
    </section>

    {% if canManage %}
        <div class="admin-modal-overlay" id="manageAddModal" role="dialog" aria-modal="true" aria-labelledby="manageAddModalLabel">
            <div class="admin-modal mx-modal-wide">
                <button class="admin-modal-x js-modal-close" type="button" aria-label="Close">&times;</button>
                <h2 id="manageAddModalLabel" style="margin-top:0">Add New Person...</h2>
                <form id="manageAddForm" class="form-grid" method="post" action="{{ path('maxeme_client_create') }}">
                    {{ csrf_field() }}
                    {{ mx.return_field() }}
                    {% include 'maxeme/client/_fields.html.twig' with { data: null } only %}
                    <div class="modal-actions span-2">
                        <button id="manageAddModalCancel" class="button outline js-modal-close" type="button">Cancel</button>
                        <button id="manageAddSubmit" class="button primary" type="submit">Save</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="admin-modal-overlay" id="manageEditModal" role="dialog" aria-modal="true" aria-labelledby="manageEditModalLabel">
            <div class="admin-modal mx-modal-wide">
                <button class="admin-modal-x js-modal-close" type="button" aria-label="Close">&times;</button>
                <h2 id="manageEditModalLabel" style="margin-top:0">Edit the Client...</h2>
                <form id="manageEditFormBody" class="form-grid" method="post" action="">
                    {{ csrf_field() }}
                    {{ mx.return_field() }}
                    {% include 'maxeme/client/_fields.html.twig' with { data: null } only %}
                    <div class="modal-actions span-2">
                        <button id="manageEditModalCancel" class="button outline js-modal-close" type="button">Cancel</button>
                        <button id="manageEditSubmit" class="button primary" type="submit">Save</button>
                    </div>
                </form>
            </div>
        </div>
    {% endif %}
{% endblock %}
