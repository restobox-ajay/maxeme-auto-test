{% extends 'emails/layout.html.twig' %}

{% block title %}Quote Approved{% endblock %}

{% block body %}
    <p>Hi,</p>
    <h2 style="margin-top: 0; color: #0f172a;">Quote Request ({{ estimate.documentNumber }}) has been accepted.</h2>
    <p>It has been converted to order <span class="highlight">#{{ order.orderNumber }}</span>.</p>

    {% include 'emails/_quote_summary.html.twig' %}

    <div style="text-align: center; margin-top: 10px;">
        <a href="{{ admin_url|default('#') }}" class="button">Review Quote</a>
    </div>
{% endblock %}
