{% extends 'emails/layout.html.twig' %}

{% block title %}Your Quote Request Could Not Be Fulfilled{% endblock %}

{% block body %}
    <p>Hey {{ estimate.companyIdentity.name|default('there') }},</p>
    <h2 style="margin-top: 0; color: #0f172a;">Quote Request ({{ estimate.documentNumber }}) could not be fulfilled</h2>
    <p>We're sorry, but we're unable to move forward with this quote request. If you have any questions, please get in touch.</p>

    {% include 'emails/_quote_summary.html.twig' %}

    <div style="text-align: center; margin-top: 20px;">
        <a href="{{ estimate_url|default('#') }}" class="button" style="background: #0369a1;">View Quote</a>
    </div>
{% endblock %}
