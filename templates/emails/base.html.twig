<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Email{% endblock %}</title>
    <style>
        body { margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; background-color: #f1f5f9; -webkit-font-smoothing: antialiased; }
        .wrapper { width: 100%; table-layout: fixed; background-color: #f1f5f9; padding-bottom: 40px; }
        .main { background-color: #ffffff; margin: 0 auto; width: 100%; max-width: 600px; border-spacing: 0; color: #1e293b; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); margin-top: 40px; }
        .header { background-color: #1d4ed8; padding: 30px; text-align: center; color: #ffffff; }
        .header h1 { margin: 0; font-size: 24px; font-weight: 700; letter-spacing: -0.02em; }
        .content { padding: 40px 30px; line-height: 1.6; font-size: 16px; }
        .content h2 { margin-top: 0; color: #1d4ed8; font-size: 20px; }
        .content p { margin: 0 0 20px; }
        .footer { padding: 30px; text-align: center; font-size: 14px; color: #64748b; background-color: #f8fafc; border-top: 1px solid #e2e8f0; }
        .button { display: inline-block; padding: 12px 24px; background-color: #1d4ed8; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 600; text-align: center; margin: 10px 0; }
        .button:hover { background-color: #1e3a8a; }
    </style>
</head>
<body>
    <table class="wrapper">
        <tr>
            <td align="center">
                <table class="main">
                    <tr>
                        <td class="header">
                            <h1>{{ site_name() }}</h1>
                        </td>
                    </tr>
                    <tr>
                        <td class="content">
                            {% block content %}{% endblock %}
                        </td>
                    </tr>
                    <tr>
                        <td class="footer">
                            <p>&copy; {{ "now"|date("Y") }} {{ site_name() }}. All rights reserved.</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
