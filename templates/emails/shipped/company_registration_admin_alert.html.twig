{% extends 'emails/layout.html.twig' %}

{% block title %}New Company Registration{% endblock %}

{% block body %}
    <h2 style="margin-top: 0; color: #0f172a;">New company registration pending approval</h2>

    <p>A new company registration has been submitted and is waiting for admin review.</p>

    <div class="order-summary">
        <p style="margin: 0 0 12px 0; font-weight: 800; color: #0f172a;">Registration summary</p>
        <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse: collapse;">
            <tr>
                <td style="padding: 6px 0; font-size: 14px; color: #475569;">Company</td>
                <td style="padding: 6px 0; font-size: 14px; color: #0f172a; font-weight: 700; text-align: right;">{{ company_name|default('-') }}</td>
            </tr>
            <tr>
                <td style="padding: 6px 0; font-size: 14px; color: #475569;">Company Code</td>
                <td style="padding: 6px 0; font-size: 14px; color: #0f172a; text-align: right;">{{ company_code|default('-') }}</td>
            </tr>
            <tr>
                <td style="padding: 6px 0; font-size: 14px; color: #475569;">Company Email</td>
                <td style="padding: 6px 0; font-size: 14px; color: #0f172a; text-align: right;">{{ company_email|default('-') }}</td>
            </tr>
            <tr>
                <td style="padding: 6px 0; font-size: 14px; color: #475569;">Login Email</td>
                <td style="padding: 6px 0; font-size: 14px; color: #0f172a; text-align: right;">{{ user_email|default('-') }}</td>
            </tr>
        </table>
    </div>

    <p>Please review the registration and activate the customer user when approved.</p>

    <div style="text-align: center; margin-top: 30px;">
        <a href="{{ admin_url|default('#') }}" class="button">Review Customer Users</a>
    </div>
{% endblock %}
