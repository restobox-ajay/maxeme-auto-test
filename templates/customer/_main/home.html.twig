{% extends 'customer/_main/layout.html.twig' %}
{% block title %}Catalog Home | {{ site_name() }}{% endblock %}
{% block customer_body %}

    {# ── Hero ──────────────────────────────────────────────────────────────── #}
    <section class="market-hero">
        <div class="market-copy">
            <p class="eyebrow">Wholesale buyer portal</p>
            <h1>Source approved products with company pricing.</h1>
            <div class="hero-actions">
                <a class="button primary" href="/product/index">Shop catalog</a>
                <a class="button outline" href="{{ path('customer_register') }}">Request access</a>
            </div>
        </div>
        <div class="market-feature">
            <span class="feature-label">Featured category</span>
            {% if featuredCategory %}
                <strong>{{ featuredCategory.name }}</strong>
                <p>{{ featuredCategory.count }} active wholesale products</p>
                {% if uncategorizedCount > 0 and featuredCategory.id != '-1' %}
                    <p class="muted">Plus {{ uncategorizedCount }} uncategorized products</p>
                {% endif %}
            {% else %}
                <strong>No default category</strong>
                <p>Add categories in admin when you are ready.</p>
            {% endif %}
        </div>
    </section>

    {# ── Category pills ─────────────────────────────────────────────────────── #}
    {# ── Featured products ──────────────────────────────────────────────────── #}
    <div class="section-header">
        <h2>Featured products</h2>
        <a class="button outline" href="/product/index">View all catalog</a>
    </div>

    {% if blocked|default(false) %}
        <div class="alert error" style="margin-bottom: 20px;">
            No fulfillment region is currently enabled for your account. Please contact your account representative to get a region enabled before browsing the catalog.
        </div>
    {% endif %}
    <section class="product-grid product-grid-market" aria-label="Featured products">
        {% for product in products %}
            <article class="product-card market-product{{ app.user ? '' : ' guest-product-card' }}">
                <a class="product-media {{ product.image or app_setting('product_image_placeholder_url') ? '' : 'is-empty' }}" href="{{ path('customer_product_detail', {id: product.id, region: selectedRegion}) }}">
                    {% if product.image %}
                        <img src="/uploads/products/{{ product.image }}" alt="{{ product.name }}" onerror="this.closest('.product-media').classList.add('is-empty'); this.remove();">
                    {% elseif app_setting('product_image_placeholder_url') %}
                        <img src="{{ app_setting('product_image_placeholder_url') }}" alt="{{ product.name }}" class="product-media-placeholder">
                    {% endif %}
                </a>
                <div class="product-body">
                    <div class="product-main">
                        {% if app.user %}
                            <p class="sku">{{ product.sku }}</p>
                            <h2><a class="product-title-link" href="{{ path('customer_product_detail', {id: product.id, region: selectedRegion}) }}">{{ product.name }}</a></h2>
                            <p class="product-category">{{ product.category }}</p>
                        {% else %}
                            <h2><a class="product-title-link" href="{{ path('customer_product_detail', {id: product.id, region: selectedRegion}) }}">{{ product.name }}</a></h2>
                            <p class="product-unit">{{ product.unit ?: '-' }}</p>
                        {% endif %}
                    </div>
                    {% if product.inventory == 'In stock' %}
                        <span class="product-avail avail-in-stock">In stock</span>
                    {% elseif product.inventory == 'Out of stock' %}
                        <span class="product-avail avail-out-stock">Out of Stock</span>
                    {% elseif product.inventory == 'Company only' %}
                        <span class="product-avail avail-company">Company only</span>
                    {% else %}
                        <span class="product-avail avail-low">{{ product.inventory }}</span>
                    {% endif %}
                    <div class="product-footer">
                        {% if app.user %}
                            <strong class="product-price">{{ product.price }}</strong>
                            {% if product.inventory != 'Out of stock' %}
                                <form method="post" action="{{ path('customer_cart_add') }}" class="btn-cart-form">
                                    {{ csrf_field() }}
                                    <input type="hidden" name="sku" value="{{ product.sku }}">
                                    <input type="hidden" name="qty" value="1">
                                    <input type="hidden" name="redirect_to" value="{{ app.request.requestUri }}">
                                    <button class="btn-cart js-product-card-cart-btn" type="submit" data-modal-target="cart-modal-{{ product.sku }}" data-available-qty="{{ product.availableQuantity|default(0) }}" data-sku="{{ product.sku }}" data-name="{{ product.name }}" data-price="{{ product.price }}" data-unit="{{ product.unit|default('') }}" data-size="{{ product.size|default('') }}" data-image="{{ product.image|default('') ? '/uploads/products/' ~ product.image : '' }}">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                                        Add to cart
                                    </button>
                                </form>
                                {% include 'customer/catalog/_cart_qty_modal.html.twig' with {product: product} only %}
                            {% else %}
                                <span class="product-footer-spacer" aria-hidden="true"></span>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            </article>
        {% else %}
            <p class="lead">No products are available yet.</p>
        {% endfor %}
    </section>

{% endblock %}
