{# Column-header sort controls. These are REAL links carrying ProductSearch[sort]/[dir] so the
   list view sorts server-side with JavaScript disabled (issue #180); the .catalog-list-sort JS
   handler in app.js intercepts the click and re-sorts client-side as a progressive-enhancement
   veneer, but is not required. Each link preserves the current filters (category, view, search q,
   region, …) by merging onto the whole current query, resets to page 1, and toggles asc/desc when
   it's the field already sorted on. #}
{# The quantity already in the cart, resolved once for the whole listing rather than per row:
   customer_cart_items() is a database read. The button renders it in place of "Add to Cart" so the
   catalog agrees with the cart badge and the cart page, all three reading the same server cart. #}
{% set cartQuantities = app.user ? customer_cart_items() : {} %}
{% set catalogQuery = app.request.query.all %}
{% set baseProductSearch = catalogQuery.ProductSearch|default({}) %}
{% set activeSort = currentSort|default(null) %}
{% set activeDir = (currentDir|default('asc')) == 'desc' ? 'desc' : 'asc' %}
<div class="catalog-list-head" aria-hidden="true">
    <span>Image</span>
    {% for header in [
        {field: 'description', label: 'Description'},
        {field: 'sku', label: 'Sku'},
        {field: 'unit', label: 'Unit of Measure'},
        {field: 'size', label: 'Size'},
        {field: 'price', label: 'Price'},
        {field: 'stock', label: 'Stock'},
        {field: 'remarks', label: 'Remarks'}
    ] %}
        {% set isActive = activeSort == header.field %}
        {% set nextDir = (isActive and activeDir == 'asc') ? 'desc' : 'asc' %}
        <a class="catalog-list-sort{{ isActive ? ' is-active' : '' }}{{ isActive and activeDir == 'desc' ? ' is-desc' : '' }}"
           data-sort-field="{{ header.field }}"
           aria-sort="{{ isActive ? (activeDir == 'desc' ? 'descending' : 'ascending') : 'none' }}"
           href="{{ path('customer_catalog', catalogQuery|merge({'ProductSearch': baseProductSearch|merge({'sort': header.field, 'dir': nextDir}), 'page': 1})) }}"
           {{ header.field == 'unit' and hideUnitColumn|default(false) ? 'style="visibility:hidden" aria-hidden="true"'|raw : '' }}>{{ header.label }}</a>
    {% endfor %}
    <span>Ordered</span>
</div>
{% for product in products %}
    <article class="product-card market-product{{ app.user ? '' : ' guest-product-card' }}"
             data-search="{{ product.sku }} {{ product.name }} {{ product.category }} {{ product.inventory }} {{ product.description }} {{ product.unit }} {{ product.size }} {{ product.remarks }}">
        <a class="product-media {{ product.image or app_setting('product_image_placeholder_url') ? '' : 'is-empty' }}" href="{{ path('customer_product_detail', {id: product.id, region: app.request.query.get('region', selectedRegion|default(''))}) }}">
            {% if product.image %}
                <img src="/uploads/products/{{ product.image }}" alt="{{ product.name }}" onerror="this.closest('.product-media').classList.add('is-empty'); this.remove();">
            {% elseif app_setting('product_image_placeholder_url') %}
                <img src="{{ app_setting('product_image_placeholder_url') }}" alt="{{ product.name }}" class="product-media-placeholder">
            {% endif %}
        </a>
        <div class="product-body">
            <div class="product-main">
                {% if app.user %}
                    <p class="sku">{{ product.sku }}</p>
                {% endif %}
                <h2>
                    <a class="product-title-link" href="{{ path('customer_product_detail', {id: product.id, region: app.request.query.get('region', selectedRegion|default(''))}) }}">{{ product.name }}</a>
                    {% if app.user and isListView %}&nbsp;{{ injection_point('product_description_after', {product: product}) }}{% endif %}
                </h2>
                {% if app.user and not isListView %}
                    {# Grid View's grid is self-contained per card (a real 2x3 template built for
                       exactly the 6 fields already here), so a 7th field like this one safely
                       auto-places into a new row of its own — no explicit grid-column/row needed. #}
                    <p>{{ injection_point('product_description_after', {product: product}) }}</p>
                {% endif %}
                {% if app.user %}
                    <p class="product-category">{{ product.category }}</p>
                {% else %}
                    <p class="product-unit"{{ hideUnitColumn|default(false) ? ' style="visibility:hidden" aria-hidden="true"'|raw : '' }}>{{ product.unit ?: '-' }}</p>
                {% endif %}
                {% if app.user %}
                    <p class="product-unit"{{ hideUnitColumn|default(false) ? ' style="visibility:hidden" aria-hidden="true"'|raw : '' }}>{{ product.unit ?: '-' }}</p>
                    <p class="product-size">{{ product.size ?: '-' }}</p>
                    <p class="product-remarks">{{ product.remarks ?: '-' }}</p>
                {% endif %}
            </div>
            {% if product.inventory == 'In stock' %}
                <span class="product-avail avail-in-stock">In Stock</span>
            {% elseif product.inventory == 'Out of stock' %}
                <span class="product-avail avail-out-stock">Out of Stock</span>
            {% elseif product.inventory == 'Company only' %}
                <span class="product-avail avail-company">Company only</span>
            {% else %}
                <span class="product-avail avail-low">{{ product.inventory }}</span>
            {% endif %}
            <div class="product-footer">
                {% if app.user %}
                    <strong class="product-price"><span class="hrp-real-value">{{ product.price }}</span>{{ suggested_price_html(product) }}</strong>

                    {% if product.inventory != 'Out of stock' %}
                        <form method="post" action="{{ path('customer_cart_add') }}" class="btn-cart-form">
                            {{ csrf_field() }}
                            <input type="hidden" name="sku" value="{{ product.sku }}">
                            <input type="hidden" name="qty" value="1">
                            <input type="hidden" name="redirect_to" value="{{ app.request.requestUri }}">
                            <button class="btn-cart js-product-card-cart-btn" type="submit" data-modal-target="cart-modal-{{ product.sku }}" data-cart-qty="{{ cartQuantities[product.sku]|default(0)|qty }}" data-available-qty="{{ product.availableQuantity|default(0)|qty }}" data-sku="{{ product.sku }}" data-name="{{ product.name }}" data-price="{{ product.price }}" data-unit="{{ product.unit }}" data-size="{{ product.size }}" data-image="{{ product.image ? '/uploads/products/' ~ product.image : '' }}">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                                Add to Cart
                            </button>
                        </form>
                        {% include 'customer/catalog/_cart_qty_modal.html.twig' with {product: product} only %}
                    {% else %}
                        <span class="product-footer-spacer" aria-hidden="true"></span>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </article>
{% endfor %}
