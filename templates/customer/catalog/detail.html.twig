{% extends 'customer/_main/layout.html.twig' %}
{% block title %}{{ productRow.name|default('Product') }} | {{ site_name() }}{% endblock %}
{% block customer_body %}
    {% include 'customer/_main/_cart_hold_banner.html.twig' %}
    <section class="catalog-page-head customer-product-head" aria-label="Product detail heading">
        <div>
            <h1>PRODUCTS</h1>
            <div class="customer-product-head-actions">
                <a class="customer-product-back" href="{{ path('customer_catalog', {region: selectedRegion}) }}">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/><path d="M21 12H9"/></svg>
                    Back
                </a>
            </div>
        </div>
        <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href="{{ path('customer_home') }}">Home</a>
            <span>/</span>
            <span>{{ productRow.name|default('') }}</span>
        </nav>
    </section>

    {% if blocked|default(false) %}
        <section class="customer-product-detail-card">
            <div class="alert error" style="margin: 20px 0;">
                No fulfillment region is currently enabled for your account. Please contact your account representative to get a region enabled before browsing the catalog.
            </div>
        </section>
    {% else %}
    <section class="customer-product-detail-card">
        <div class="customer-product-gallery">
            <div class="customer-product-image {{ productRow.image or app_setting('product_image_placeholder_url') ? '' : 'is-empty' }}" id="customer-product-main-image">
                {% if productRow.image %}
                    <img src="/uploads/products/{{ productRow.image }}" alt="{{ productRow.name }}" onerror="this.closest('.customer-product-image').classList.add('is-empty'); this.remove();">
                {% elseif app_setting('product_image_placeholder_url') %}
                    <img src="{{ app_setting('product_image_placeholder_url') }}" alt="{{ productRow.name }}" class="product-media-placeholder">
                {% endif %}
            </div>

            {% if productRow.images|default([])|length > 1 %}
                <div class="customer-product-thumbs" id="customer-product-thumbs">
                    {% for image in productRow.images %}
                        <button type="button" class="customer-product-thumb{{ image.filename == productRow.image ? ' is-active' : '' }}" data-image-src="/uploads/products/{{ image.filename }}">
                            <img src="/uploads/products/{{ image.filename }}" alt="{{ productRow.name }}">
                        </button>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="customer-product-info">
            <h2>{{ productRow.name }}</h2>
            <ul class="customer-product-meta">
                <li><strong>SKU:</strong> {{ productRow.sku ?: '-' }}</li>
                <li><strong>Unit:</strong> {{ productRow.unit ?: '-' }}</li>
                <li><strong>Size:</strong> {{ productRow.size ?: '-' }}</li>
                {% if productRow.shortDescription %}
                    <li><strong>Description:</strong> {{ productRow.shortDescription }} {{ injection_point('product_short_description_after', {product: product}) }}</li>
                {% else %}
                    {# .customer-product-meta is `display: grid` — a bare (non-<li>) direct child
                       here becomes a grid item and gets forcibly "blockified" by the CSS Display
                       spec itself (not overridable, not even with an inline !important style),
                       which is what pushed .hrp-toggle/.hrp-reveal-slot onto their own line. #}
                    <li>{{ injection_point('product_short_description_after', {product: product}) }}</li>
                {% endif %}
                <li>
                    <strong>Categories:</strong>
                    {% if product.category %}
                        <a class="customer-product-category-link" href="{{ path('customer_catalog', selectedRegion ? {'ProductSearch[category_id]': product.category.id, 'region': selectedRegion} : {'ProductSearch[category_id]': product.category.id}) }}">
                            {{ product.category.name }}
                        </a>
                    {% else %}
                        {{ productRow.category ?: 'No category' }}
                    {% endif %}
                </li>
                {% if app.user and productRow.longDescription %}
                    <li>{{ productRow.longDescription }}</li>
                {% endif %}
                {{ injection_point('product_long_description_after', {product: product}) }}
                {% if app.user and productRow.remarks %}
                    <li><strong>Remarks:</strong> {{ productRow.remarks }}</li>
                {% endif %}
            </ul>

            {% if productRow.inventory == 'In stock' %}
                <p class="customer-product-stock avail-in-stock">In Stock</p>
            {% else %}
                <p class="customer-product-stock avail-out-stock">Out of Stock</p>
            {% endif %}

            {% if app.user %}
                <p class="customer-product-price"><strong>Price:</strong> {{ productRow.price }}</p>
                {{ suggested_price_html(product) }}

                <div class="customer-product-actions">
                    {% if productRow.inventory != 'Out of stock' %}
                        <form method="post" action="{{ path('customer_cart_add') }}" class="customer-product-actions-form">
                            {{ csrf_field() }}
                            <input type="hidden" name="sku" value="{{ productRow.sku }}">
                            <input type="hidden" name="redirect_to" value="{{ app.request.requestUri }}">
                            <div class="customer-product-qty">
                                <button class="customer-product-qty-btn js-detail-qty-dec" type="button" aria-label="Decrease quantity">-</button>
                                <input id="customer-product-qty-input" class="customer-product-qty-input" type="number" min="1" max="999" name="qty" value="1" inputmode="numeric" aria-label="Quantity">
                                <button class="customer-product-qty-btn js-detail-qty-inc" type="button" aria-label="Increase quantity">+</button>
                            </div>
                            {{ injection_point('product_before_add_to_cart', {product: product}) }}
                            <button class="btn-cart customer-product-cart-btn" type="submit" data-cart-qty="{{ (app.user ? customer_cart_items()[productRow.sku]|default(0) : 0)|qty }}" data-available-qty="{{ productRow.availableQuantity|default(0)|qty }}" data-qty-target="#customer-product-qty-input" data-sku="{{ productRow.sku }}" data-name="{{ productRow.name }}" data-price="{{ productRow.price }}" data-unit="{{ productRow.unit }}" data-size="{{ productRow.size }}" data-image="{{ productRow.image ? '/uploads/products/' ~ productRow.image : '' }}">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                                Add to Cart
                            </button>
                        </form>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </section>

    {% if productRow.images|default([])|length > 1 %}
        <script>
        (function () {
            var mainImage = document.getElementById('customer-product-main-image');
            var thumbs = document.getElementById('customer-product-thumbs');
            if (!mainImage || !thumbs) { return; }

            thumbs.addEventListener('click', function (e) {
                var button = e.target.closest('.customer-product-thumb');
                if (!button) { return; }

                var src = button.getAttribute('data-image-src');
                var img = mainImage.querySelector('img');
                if (!img) {
                    img = document.createElement('img');
                    img.alt = '{{ productRow.name|e('js') }}';
                    mainImage.appendChild(img);
                }

                if (img.getAttribute('src') === src) { return; }

                mainImage.classList.add('is-swapping');
                window.setTimeout(function () {
                    img.src = src;
                    mainImage.classList.remove('is-empty');
                    mainImage.classList.remove('is-swapping');
                }, 140);

                thumbs.querySelectorAll('.customer-product-thumb').forEach(function (el) {
                    el.classList.toggle('is-active', el === button);
                });
            });
        })();
        </script>
    {% endif %}
    {% endif %}
{% endblock %}
