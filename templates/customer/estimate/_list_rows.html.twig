{% for estimate in estimates %}
    {% set ship = estimate.effectiveShippingAddress %}
    {% set region = estimate.fulfillmentRegion ?: (ship and ship.city ? ship.city : '-') %}
    {% set expectedDelivery = expectedDeliveryByEstimateId[estimate.id]|default('') %}
    {% set specialInstructions = specialInstructionsByEstimateId[estimate.id]|default(estimate.specialInstructions ?: '-') %}
    {% set statusValue = estimate.status %}
    <tr>
        <td data-label="ID"><strong>{{ estimate.documentNumber }}</strong></td>
        <td data-label="Product">
            <div class="customer-order-products">
                {% for line in estimate.lines %}
                    <div class="customer-order-product-row">
                        <span class="customer-order-product-name">{{ line.name }}</span>
                        <span class="customer-order-product-qty">X {{ line.quantity|qty }}</span>
                    </div>
                {% else %}
                    <span class="muted">-</span>
                {% endfor %}
            </div>
        </td>
        <td data-label="Expected Delivery Time">
            {% if expectedDelivery %}
                <span class="customer-order-delivery-date">{{ expectedDelivery }}</span>
            {% endif %}
        </td>
        <td data-label="PO">{{ estimate.poNumber ?: '-' }}</td>
        <td data-label="Special Instructions">{{ specialInstructions }}</td>
        <td data-label="Fulfillment Region">{{ region }}</td>
        <td data-label="Status">
            {% if statusValue == 'Rejected' %}
                <span class="badge danger">{{ statusValue }}</span>
            {% elseif statusValue == 'Submitted' %}
                <span class="badge warn">{{ statusValue }}</span>
            {% elseif statusValue == 'Accepted' %}
                <span class="badge success">{{ statusValue }}</span>
            {% else %}
                <span class="badge info">{{ statusValue }}</span>
            {% endif %}
        </td>
        <td data-label="Total"><strong>{{ estimate.total is not null ? '$' ~ estimate.total|amount : 'TBD' }}</strong></td>
        <td data-label="Created At">
            {{ estimate.createdAt|date('Y-m-d') }}<br>
            <span class="muted">{{ estimate.createdAt|date('h:i:s A') }}</span>
        </td>
        <td data-label="Actions" class="row-actions">
            {# <details>, opened by the browser rather than by app.js, same as the order list — a
               real customer with JavaScript off must still reach Accept/Decline/Cancel. No form
               here nests inside another: the filter form above (line 31) is empty and closes
               before this table starts. #}
            <details class="row-action-menu no-js-row-actions">
                <summary class="table-action" aria-label="Actions for quote {{ estimate.documentNumber }}">Actions</summary>
                <div class="row-action-dropdown">
                    <a href="{{ path('customer_estimate_detail', {id: estimate.id}) }}">Detail</a>
                    {% if statusValue == 'Priced' and estimate.isFullyPriced %}
                        <form method="post" action="{{ path('customer_estimate_accept', {id: estimate.id}) }}">
                            {{ csrf_field() }}
                            <button type="submit">Accept</button>
                        </form>
                    {% endif %}
                    {% if statusValue == 'Priced' %}
                        <form method="post" action="{{ path('customer_estimate_reject', {id: estimate.id}) }}">
                            {{ csrf_field() }}
                            <button class="danger" type="submit">Decline</button>
                        </form>
                    {% endif %}
                    {% if statusValue == 'Submitted' %}
                        <form method="post" action="{{ path('customer_estimate_cancel', {id: estimate.id}) }}">
                            {{ csrf_field() }}
                            <button class="danger" type="submit">Cancel</button>
                        </form>
                    {% endif %}
                </div>
            </details>
        </td>
    </tr>
{% else %}
    <tr>
        <td colspan="10">
            <div class="empty-table-cell">
                <strong>No quote requests found.</strong>
            </div>
        </td>
    </tr>
{% endfor %}
