{% extends 'customer/_main/layout.html.twig' %}
{% block title %}Password Reset | {{ site_name() }}{% endblock %}
{% block customer_body %}
    <section class="auth-center">
        <section class="auth-card-solo">
            <p class="eyebrow">{{ mode == 'invite' ? 'Account setup' : 'Password reset' }}</p>
            {% if token %}
                {% if mode == 'invite' %}
                    <h1>Set up your password</h1>
                    <p>Create a password to activate your account.</p>
                {% else %}
                    <h1>Create new password</h1>
                    <p>Set a strong password to secure your account.</p>
                {% endif %}
            {% else %}
                <h1>Send a secure reset link</h1>
                <p>Enter the email address connected to your customer account.</p>
            {% endif %}

            {% for message in app.flashes('success') %}
                <div class="alert success">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert error">{{ message }}</div>
            {% endfor %}

            {% if token %}
                {% if tokenValid %}
                    <form class="form-grid" method="post" action="{{ path(mode == 'invite' ? 'customer_account_setup' : 'customer_password_reset', {token: token}) }}">
                        {{ csrf_field() }}
                        <label class="span-2">New password <span class="req">*</span>
                            <div style="position: relative;">
                                <input type="password" id="reset_password" name="password" required autocomplete="new-password" style="padding-right: 40px;">
                                <button type="button" onclick="togglePassword('reset_password', this)" style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: #6b7280; padding: 4px; display: flex; align-items: center; justify-content: center;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                </button>
                            </div>
                        </label>
                        <label class="span-2">Confirm new password <span class="req">*</span>
                            <div style="position: relative;">
                                <input type="password" id="reset_confirm_password" name="confirm_password" required autocomplete="new-password" style="padding-right: 40px;">
                                <button type="button" onclick="togglePassword('reset_confirm_password', this)" style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: #6b7280; padding: 4px; display: flex; align-items: center; justify-content: center;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                </button>
                            </div>
                        </label>
                        <div class="span-2 auth-actions">
                            <button class="button primary" type="submit">{{ mode == 'invite' ? 'Set Password' : 'Update Password' }}</button>
                            <a class="button back-button" href="{{ path(loginRoute|default('customer_login')) }}">Back to login</a>
                        </div>
                    </form>
                {% else %}
                    <div class="alert warn span-2" style="margin-top: 12px;">
                        This link is invalid or expired. Please request a new reset link.
                    </div>
                    <div class="span-2 auth-actions" style="margin-top: 12px;">
                        <a class="button primary" href="{{ path('customer_password_reset') }}">Request new link</a>
                        <a class="button back-button" href="{{ path(loginRoute|default('customer_login')) }}">Back to login</a>
                    </div>
                {% endif %}
            {% else %}
                <form class="form-grid" method="post" action="{{ path('customer_password_reset') }}">
                    {{ csrf_field() }}
                    <label class="span-2">Email <span class="req">*</span><input type="email" name="email" placeholder="buyer@example.test" required></label>
                    <div class="span-2 auth-actions">
                        <button class="button primary" type="submit">Send reset email</button>
                    </div>
                </form>
            {% endif %}
            <p class="auth-foot">Back to <a href="{{ path(loginRoute|default('customer_login')) }}">login</a></p>
        </section>
    </section>

    <script>
        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            if (!input) { return; }
            const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
            input.setAttribute('type', type);

            if (type === 'text') {
                btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" /></svg>`;
            } else {
                btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>`;
            }
        }
    </script>
{% endblock %}
