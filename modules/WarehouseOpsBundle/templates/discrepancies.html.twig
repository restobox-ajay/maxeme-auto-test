{% extends 'admin/_main/layout.html.twig' %}
{% block title %}Inventory Discrepancies | Admin{% endblock %}
{% block admin_body %}
    {% include '@WarehouseOps/_nav.html.twig' with {
        current: 'discrepancies',
        heading: 'Inventory Discrepancies',
        lead: 'Every place a periodic check found two records of the same stock disagreeing. Findings only — nothing here has been corrected, and nothing on this screen corrects anything.'
    } only %}

    <section class="table-card no-paginate"
             data-current-page="{{ page }}"
             data-per-page="{{ limit }}"
             data-total="{{ total }}"
             data-pages="{{ pages }}">
        <form method="get" id="discrepancy-filters" action="{{ path('admin_bundle_warehouse_ops_discrepancies') }}">
            <input type="hidden" name="page" value="1">
            <input type="hidden" name="sort" value="{{ currentSort }}">
            <input type="hidden" name="dir" value="{{ currentDir }}">
            {# Short deliberately: a .table-scroll-region page is clamped to the viewport, so a long
               prose block above the table would squeeze the rows it is explaining off the screen. #}
            <div class="table-header">
                <p class="lead"><strong>Nothing here was corrected.</strong> Resolve a transfer finding on its transfer document, a stock finding on the Inventory Depth adjustment screen.</p>
                <p>
                    <strong>transfer_out / transfer_in</strong>: <code>product_inventory</code>'s cached transfer
                    columns against <code>transfer_order_line</code> — cumulative, everything that has ever left or
                    arrived, not what is on a truck now.
                    <strong>in_transit</strong>: what the documents say is in flight against the
                    <code>inventory_detail</code> rows at the warehouse that dispatched it — units lost in transit
                    and then written off leave a permanent, correct gap.
                    <strong>quantity</strong>: the whole availability invariant.
                    <strong>cart_hold / pending / approved</strong>: a hold bucket against the carts, invoices or
                    import that define it.
                    Re-check transfers with <code>php bin/console app:warehouse-ops:transfer-check</code>.
                </p>
            </div>
            <div class="table-scroll-region"><div class="wide-table-wrap"><table class="admin-grid-table">
                <thead>
                    <tr>
                        {% set nextDir = currentSort == 'occurredAt' and currentDir == 'asc' ? 'desc' : 'asc' %}
                        <th class="is-sortable{% if currentSort == 'occurredAt' %} is-sorted-{{ currentDir }}{% endif %}"><a href="{{ path('admin_bundle_warehouse_ops_discrepancies', {sort: 'occurredAt', dir: nextDir, limit: limit, page: 1, filters: filters}) }}">Found</a></th>
                        {% set nextDir = currentSort == 'product' and currentDir == 'asc' ? 'desc' : 'asc' %}
                        <th class="is-sortable{% if currentSort == 'product' %} is-sorted-{{ currentDir }}{% endif %}"><a href="{{ path('admin_bundle_warehouse_ops_discrepancies', {sort: 'product', dir: nextDir, limit: limit, page: 1, filters: filters}) }}">Product</a></th>
                        {% set nextDir = currentSort == 'warehouse' and currentDir == 'asc' ? 'desc' : 'asc' %}
                        <th class="is-sortable{% if currentSort == 'warehouse' %} is-sorted-{{ currentDir }}{% endif %}"><a href="{{ path('admin_bundle_warehouse_ops_discrepancies', {sort: 'warehouse', dir: nextDir, limit: limit, page: 1, filters: filters}) }}">Warehouse</a></th>
                        {% set nextDir = currentSort == 'bucket' and currentDir == 'asc' ? 'desc' : 'asc' %}
                        <th class="is-sortable{% if currentSort == 'bucket' %} is-sorted-{{ currentDir }}{% endif %}"><a href="{{ path('admin_bundle_warehouse_ops_discrepancies', {sort: 'bucket', dir: nextDir, limit: limit, page: 1, filters: filters}) }}">Check</a></th>
                        <th>Stored</th>
                        <th>Actual</th>
                        <th>Difference</th>
                        {% set nextDir = currentSort == 'source' and currentDir == 'asc' ? 'desc' : 'asc' %}
                        <th class="is-sortable{% if currentSort == 'source' %} is-sorted-{{ currentDir }}{% endif %}"><a href="{{ path('admin_bundle_warehouse_ops_discrepancies', {sort: 'source', dir: nextDir, limit: limit, page: 1, filters: filters}) }}">Found by</a></th>
                        <th>Actions</th>
                    </tr>
                    <tr class="filter-row">
                        <th></th>
                        <th><input type="text" name="filters[product]" form="discrepancy-filters" value="{{ filters.product }}" placeholder="SKU or name" aria-label="Filter product"></th>
                        <th>
                            <select name="filters[warehouse]" form="discrepancy-filters" aria-label="Filter warehouse" onchange="this.form.submit()">
                                <option value="">All</option>
                                {% for w in warehouses %}<option value="{{ w.id }}"{{ filters.warehouse == w.id ~ '' ? ' selected' : '' }}>{{ w.name }}</option>{% endfor %}
                            </select>
                        </th>
                        <th>
                            <select name="filters[bucket]" form="discrepancy-filters" aria-label="Filter check" onchange="this.form.submit()">
                                <option value="">All</option>
                                {% for b in buckets %}<option value="{{ b }}"{{ filters.bucket == b ? ' selected' : '' }}>{{ b }}</option>{% endfor %}
                            </select>
                        </th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th>
                            <select name="filters[source]" form="discrepancy-filters" aria-label="Filter source" onchange="this.form.submit()">
                                <option value="">All</option>
                                {% for s in sources %}<option value="{{ s }}"{{ filters.source == s ? ' selected' : '' }}>{{ s }}</option>{% endfor %}
                            </select>
                        </th>
                        <th>
                            <button class="button" type="submit">Filter</button>
                            <a class="button" href="{{ path('admin_bundle_warehouse_ops_discrepancies') }}">Reset</a>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        {% set difference = row.recomputedQuantity - row.cachedQuantity %}
                        <tr class="data-item-row">
                            <td data-label="Found">{{ row.occurredAt|date('Y-m-d H:i') }}</td>
                            <td data-label="Product">{{ row.product.sku ?: '#' ~ row.product.id }}<br><small>{{ row.product.name }}</small></td>
                            <td data-label="Warehouse">{{ row.warehouse.name }}</td>
                            <td data-label="Check">{{ row.bucket }}</td>
                            <td data-label="Stored">{{ row.cachedQuantity }}</td>
                            <td data-label="Actual">{{ row.recomputedQuantity }}</td>
                            <td data-label="Difference">{{ difference > 0 ? '+' : '' }}{{ difference }}
                                <small>{{ difference < 0 ? 'short' : 'over' }}</small>
                            </td>
                            <td data-label="Found by">{{ row.source }}</td>
                            <td data-label="Actions" class="row-actions">
                                <a class="table-action" href="{{ path('admin_bundle_inventory_depth_stock_by_product', {id: row.product.id}) }}">Stock</a>
                                {% if row.source == transferSource %}
                                    {# Only where a transfer is what found it: filtered to the side of the
                                       document this warehouse is on, so the link lands on the transfers that
                                       could actually explain the row rather than on every transfer it touched. #}
                                    {% if row.bucket == 'transfer_in' %}
                                        <a class="table-action" href="{{ path('admin_bundle_warehouse_ops_transfers', {filters: {to: row.warehouse.id}}) }}">Transfers in</a>
                                    {% else %}
                                        <a class="table-action" href="{{ path('admin_bundle_warehouse_ops_transfers', {filters: {from: row.warehouse.id}}) }}">Transfers out</a>
                                    {% endif %}
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="9" class="empty-table-cell">
                            <strong>Nothing has drifted.</strong>
                            <span>No check has found a disagreement — or none has run yet. This table is written only by the recalc and check commands.</span>
                        </td></tr>
                    {% endfor %}
                </tbody>
            </table></div></div>
            {# A real submit button, so the filter row applies with JavaScript off. #}
            <button type="submit" hidden aria-hidden="true" tabindex="-1"></button>
            <div class="table-footer">
                {% include 'admin/_table_count.html.twig' with {count: rows|length, total: total, currentPage: page, perPage: limit, label: 'findings'} only %}
                <label class="per-page-label">Per page
                    <select name="limit" form="discrepancy-filters" onchange="this.form.submit()">
                        {% for option in [20, 100, 200, 500] %}<option value="{{ option }}"{{ limit == option ? ' selected' : '' }}>{{ option }}</option>{% endfor %}
                    </select>
                </label>
                {% include 'admin/_pagination.html.twig' with {
                    routeName: 'admin_bundle_warehouse_ops_discrepancies',
                    routeQuery: {filters: filters, limit: limit, sort: currentSort, dir: currentDir},
                    currentPage: page, pageCount: pages
                } only %}
            </div>
        </form>
    </section>
{% endblock %}
