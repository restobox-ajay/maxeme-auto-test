{% extends 'admin/_main/layout.html.twig' %}
{% block title %}Transfers | Admin{% endblock %}
{% block admin_body %}
    {% include '@WarehouseOps/_nav.html.twig' with {
        current: 'transfers',
        heading: 'Transfer Orders',
        lead: 'Stock moving between warehouses as a tracked document rather than two unrelated adjustments. Dispatch puts it in transit at the source; receipt puts it on the shelf at the destination. In between it is sellable at neither end.'
    } only %}

    <section class="panel">
        <h2>New transfer</h2>
        <form method="post" action="{{ path('admin_bundle_warehouse_ops_transfer_create') }}" class="form-grid inline-form-grid">
            {{ csrf_field() }}
            <label>From
                <select name="from_warehouse_id" required>
                    {% for w in warehouses %}<option value="{{ w.id }}">{{ w.name }}</option>{% endfor %}
                </select>
            </label>
            <label>To
                <select name="to_warehouse_id" required>
                    {% for w in warehouses %}<option value="{{ w.id }}">{{ w.name }}</option>{% endfor %}
                </select>
            </label>
            <label>Notes <input type="text" name="notes" maxlength="255"></label>
            <div class="form-actions"><button class="button primary" type="submit">Create draft</button></div>
        </form>
    </section>

    <section class="table-card no-paginate">
        <form method="get" id="transfer-filters">
            <input type="hidden" name="page" value="1">
            <div class="table-scroll-region"><div class="wide-table-wrap"><table class="admin-grid-table">
                <thead>
                    <tr><th>Number</th><th>From</th><th>To</th><th>Status</th><th>In transit</th><th>Dispatched</th><th>Received</th><th>Actions</th></tr>
                    <tr class="filter-row">
                        <th><input type="text" name="filters[number]" form="transfer-filters" value="{{ filters.number }}" placeholder="TR-" aria-label="Filter number"></th>
                        <th>
                            <select name="filters[from]" form="transfer-filters" aria-label="Filter source warehouse" onchange="this.form.submit()">
                                <option value="">All</option>
                                {% for w in warehouses %}<option value="{{ w.id }}"{{ filters.from == w.id ~ '' ? ' selected' : '' }}>{{ w.name }}</option>{% endfor %}
                            </select>
                        </th>
                        <th>
                            <select name="filters[to]" form="transfer-filters" aria-label="Filter destination warehouse" onchange="this.form.submit()">
                                <option value="">All</option>
                                {% for w in warehouses %}<option value="{{ w.id }}"{{ filters.to == w.id ~ '' ? ' selected' : '' }}>{{ w.name }}</option>{% endfor %}
                            </select>
                        </th>
                        <th>
                            <select name="filters[status]" form="transfer-filters" aria-label="Filter status" onchange="this.form.submit()">
                                <option value="">All</option>
                                {% for s in statuses %}<option value="{{ s }}"{{ filters.status == s ? ' selected' : '' }}>{{ s }}</option>{% endfor %}
                            </select>
                        </th>
                        <th colspan="3"></th>
                        <th>
                            <button class="button" type="submit">Filter</button>
                            <a class="button" href="{{ path('admin_bundle_warehouse_ops_transfers') }}">Reset</a>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr class="data-item-row">
                            <td data-label="Number"><a href="{{ path('admin_bundle_warehouse_ops_transfer', {id: row.id}) }}">{{ row.number }}</a></td>
                            <td data-label="From">{{ row.fromWarehouse.name }}</td>
                            <td data-label="To">{{ row.toWarehouse.name }}</td>
                            <td data-label="Status">{{ row.status }}</td>
                            <td data-label="In transit">{{ row.inTransitUnits }}</td>
                            <td data-label="Dispatched">{{ row.dispatchedAt ? row.dispatchedAt|date('Y-m-d H:i') : '—' }}</td>
                            <td data-label="Received">{{ row.receivedAt ? row.receivedAt|date('Y-m-d H:i') : '—' }}</td>
                            <td data-label="Actions" class="row-actions">
                                <a class="table-action" href="{{ path('admin_bundle_warehouse_ops_transfer', {id: row.id}) }}">View</a>
                                {% if row.isEditable %}
                                    {# Editing a transfer is editing its lines, which is the detail screen —
                                       so Edit lands on the line form rather than on a second one here. #}
                                    <a class="table-action" href="{{ path('admin_bundle_warehouse_ops_transfer', {id: row.id}) }}#line-form">Edit</a>
                                    {# transfer_cancel has existed since #552 with no way to reach it from
                                       this list. Both of these post to forms emitted below the table:
                                       a <form> inside the filter <form> is invalid HTML (#613). #}
                                    <button type="submit" class="table-action" form="cancel-transfer-{{ row.id }}">Cancel</button>
                                {% endif %}
                                {% if row.status in ['draft', 'cancelled'] %}
                                    <button type="submit" class="table-action danger" form="delete-transfer-{{ row.id }}">Delete</button>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="8" class="empty-table-cell">
                            <strong>No transfers yet.</strong>
                            <span>Create a draft above, add lines to it, then dispatch it.</span>
                        </td></tr>
                    {% endfor %}
                </tbody>
            </table></div></div>
            {# A real submit button, so the filter row applies with JavaScript off. #}
            <button type="submit" hidden aria-hidden="true" tabindex="-1"></button>
            <div class="table-footer">
                {% include 'admin/_table_count.html.twig' with {count: rows|length, total: total, currentPage: page, perPage: limit, label: 'transfers'} only %}
                <label class="per-page-label">Per page
                    <select name="limit" form="transfer-filters" onchange="this.form.submit()">
                        {% for option in [20, 100, 200, 500] %}<option value="{{ option }}"{{ limit == option ? ' selected' : '' }}>{{ option }}</option>{% endfor %}
                    </select>
                </label>
                {% include 'admin/_pagination.html.twig' with {
                    routeName: 'admin_bundle_warehouse_ops_transfers',
                    routeQuery: {filters: filters, limit: limit, sort: currentSort, dir: currentDir},
                    currentPage: page, pageCount: pages
                } only %}
            </div>
        </form>
        {# The row buttons' forms, outside the filter form and referenced by id. POST rather than a
           link on both: a destructive or state-changing action a crawler or a prefetch can follow is
           one that happens without anybody pressing it. Neither needs JavaScript — the confirm is an
           onsubmit courtesy that simply does not run with scripting off (#613). #}
        {% for row in rows %}
            {% if row.isEditable %}
                <form method="post" id="cancel-transfer-{{ row.id }}" hidden
                      action="{{ path('admin_bundle_warehouse_ops_transfer_cancel', {id: row.id}) }}"
                      onsubmit="return confirm('Cancel draft {{ row.number|e('js') }}?')">
                    {{ csrf_field() }}
                </form>
            {% endif %}
            {% if row.status in ['draft', 'cancelled'] %}
                <form method="post" id="delete-transfer-{{ row.id }}" hidden
                      action="{{ path('admin_bundle_warehouse_ops_transfer_delete', {id: row.id}) }}"
                      onsubmit="return confirm('Delete {{ row.number|e('js') }} and its lines?')">
                    {{ csrf_field() }}
                </form>
            {% endif %}
        {% endfor %}
    </section>
{% endblock %}
