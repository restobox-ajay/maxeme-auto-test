{% extends 'admin/_main/layout.html.twig' %}
{% block title %}Stock | Admin{% endblock %}
{% block admin_body %}
    {% include '@WarehouseOps/_nav.html.twig' with {
        current: 'stock',
        heading: 'Stock',
        lead: 'Where is it — every product, warehouse and bin, one table. Filter on any column; each filter narrows the choices in the others.'
    } only %}

    {% for notice in notices %}
        <div class="flash flash-error">{{ notice }}</div>
    {% endfor %}

    <section class="table-card no-paginate">
        <form method="get" id="stock-filters">
            <input type="hidden" name="page" value="1">
            <input type="hidden" name="sort" value="{{ currentSort }}">
            <input type="hidden" name="dir" value="{{ currentDir }}">
            <div class="table-scroll-region"><div class="wide-table-wrap"><table class="admin-grid-table">
                <thead>
                    <tr>
                        <th></th>
                        <th class="is-sortable{% if currentSort == 'product' %} is-sorted-{{ currentDir }}{% endif %}">
                            <a href="{{ path('admin_bundle_warehouse_ops_stock', {filters: filters, limit: limit, page: 1, sort: 'product', dir: currentSort == 'product' and currentDir == 'asc' ? 'desc' : 'asc'}) }}">Product</a>
                        </th>
                        <th>Warehouse</th>
                        <th class="is-sortable{% if currentSort == 'bin' %} is-sorted-{{ currentDir }}{% endif %}">
                            <a href="{{ path('admin_bundle_warehouse_ops_stock', {filters: filters, limit: limit, page: 1, sort: 'bin', dir: currentSort == 'bin' and currentDir == 'asc' ? 'desc' : 'asc'}) }}">Bin</a>
                        </th>
                        <th>Lot</th>
                        <th class="is-sortable{% if currentSort == 'expiry' %} is-sorted-{{ currentDir }}{% endif %}">
                            <a href="{{ path('admin_bundle_warehouse_ops_stock', {filters: filters, limit: limit, page: 1, sort: 'expiry', dir: currentSort == 'expiry' and currentDir == 'asc' ? 'desc' : 'asc'}) }}">Expiry</a>
                        </th>
                        <th>Serial</th>
                        <th class="is-sortable{% if currentSort == 'status' %} is-sorted-{{ currentDir }}{% endif %}">
                            <a href="{{ path('admin_bundle_warehouse_ops_stock', {filters: filters, limit: limit, page: 1, sort: 'status', dir: currentSort == 'status' and currentDir == 'asc' ? 'desc' : 'asc'}) }}">Status</a>
                        </th>
                        <th class="is-sortable{% if currentSort == 'quantity' %} is-sorted-{{ currentDir }}{% endif %}">
                            <a href="{{ path('admin_bundle_warehouse_ops_stock', {filters: filters, limit: limit, page: 1, sort: 'quantity', dir: currentSort == 'quantity' and currentDir == 'asc' ? 'desc' : 'asc'}) }}">Quantity</a>
                        </th>
                        <th>Actions</th>
                    </tr>
                    <tr class="filter-row">
                        <th></th>
                        <th><input type="text" name="filters[product]" form="stock-filters" value="{{ filters.product }}" placeholder="SKU or name" aria-label="Filter product"></th>
                        <th>
                            <select name="filters[warehouse]" form="stock-filters" aria-label="Filter warehouse" onchange="this.form.submit()">
                                <option value="">All</option>
                                {% for o in warehouseOptions %}
                                    <option value="{{ o.id }}"{{ filters.warehouse == o.id ~ '' ? ' selected' : '' }}>{{ o.name }} ({{ o.count }})</option>
                                {% endfor %}
                            </select>
                        </th>
                        <th>
                            {% if binOptions is null %}
                                <input type="text" name="filters[bin]" form="stock-filters" value="{{ filters.bin }}" placeholder="Bin code" aria-label="Filter bin">
                                <p class="muted">Only the first {{ 200 }} are listed; type to narrow.</p>
                            {% else %}
                                <select name="filters[bin]" form="stock-filters" aria-label="Filter bin" onchange="this.form.submit()">
                                    <option value="">All</option>
                                    {% for o in binOptions %}
                                        <option value="{{ o.code }}"{{ filters.bin == o.code ? ' selected' : '' }}>{{ o.code }} ({{ o.count }})</option>
                                    {% endfor %}
                                </select>
                            {% endif %}
                        </th>
                        <th>
                            {% if lotOptions is null %}
                                <input type="text" name="filters[lot]" form="stock-filters" value="{{ filters.lot }}" placeholder="Lot code" aria-label="Filter lot">
                                <p class="muted">Only the first {{ 200 }} are listed; type to narrow.</p>
                            {% else %}
                                <select name="filters[lot]" form="stock-filters" aria-label="Filter lot" onchange="this.form.submit()">
                                    <option value="">All</option>
                                    {% for o in lotOptions %}
                                        <option value="{{ o.code }}"{{ filters.lot == o.code ? ' selected' : '' }}>{{ o.code }} ({{ o.count }})</option>
                                    {% endfor %}
                                </select>
                            {% endif %}
                        </th>
                        <th><input type="date" name="filters[expiry]" form="stock-filters" value="{{ filters.expiry }}" aria-label="Filter expiry on or before" title="Expires on or before"></th>
                        <th><input type="text" name="filters[serial]" form="stock-filters" value="{{ filters.serial }}" placeholder="Serial" aria-label="Filter serial"></th>
                        <th>
                            <select name="filters[status]" form="stock-filters" aria-label="Filter status" onchange="this.form.submit()">
                                <option value="">All</option>
                                {% for o in statusOptions %}
                                    <option value="{{ o.status }}"{{ filters.status == o.status ? ' selected' : '' }}>{{ o.status }} ({{ o.count }})</option>
                                {% endfor %}
                            </select>
                        </th>
                        <th></th>
                        <th>
                            <button class="button" type="submit">Show</button>
                            <a class="button" href="{{ path('admin_bundle_warehouse_ops_stock') }}">Reset</a>
                        </th>
                    </tr>
                </thead>
                <tbody>
                {% for row in rows %}
                    {% set expiry = row.lot ? row.lot.expiry : row.expiry %}
                    <tr class="data-item-row">
                        <td data-label="">
                            {% if row.status == availableStatus %}
                                <input type="checkbox" name="rows[]" value="{{ row.id }}" form="stock-move-selection" aria-label="Select this row to move">
                            {% else %}
                                <span title="{{ row.status }}: not movable">—</span>
                            {% endif %}
                        </td>
                        <td data-label="Product"><a href="{{ path('admin_bundle_inventory_depth_stock_by_product', {id: row.product.id}) }}">{{ row.product.sku ?: row.product.name }}</a></td>
                        <td data-label="Warehouse">{{ row.warehouse.name }}</td>
                        <td data-label="Bin">{{ row.location ? row.location.code : '—' }}</td>
                        <td data-label="Lot">{{ row.lot ? row.lot.code : '—' }}</td>
                        <td data-label="Expiry">{{ expiry ? expiry|date('Y-m-d') : '—' }}</td>
                        <td data-label="Serial">{{ row.serial ?: '—' }}</td>
                        <td data-label="Status">{{ row.status }}</td>
                        <td data-label="Quantity"><strong>{{ row.quantity|qty }}</strong></td>
                        <td data-label="Actions">
                            <a class="table-action" href="{{ path('admin_bundle_inventory_depth_adjust', {product: row.product.id, warehouse: row.warehouse.id}) }}">Adjust</a>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="10" class="empty-table-cell">
                        <strong>No stock matches.</strong>
                        <span>Clear a filter to widen the search.</span>
                    </td></tr>
                {% endfor %}
                </tbody>
            </table></div></div>
            {# A real submit button, so the filter row applies with JavaScript off. #}
            <button type="submit" hidden aria-hidden="true" tabindex="-1"></button>
            <div class="table-footer">
                {% include 'admin/_table_count.html.twig' with {count: rows|length, total: total, currentPage: page, perPage: limit, label: 'stock rows'} only %}
                <button class="button primary" type="submit" form="stock-move-selection">Move selected</button>
                <label class="per-page-label">
                    Per page
                    <select name="limit" form="stock-filters" onchange="this.form.submit()">
                        {% for option in [20, 100, 200, 500] %}
                            <option value="{{ option }}"{{ limit == option ? ' selected' : '' }}>{{ option }}</option>
                        {% endfor %}
                    </select>
                </label>
                {% include 'admin/_pagination.html.twig' with {
                    routeName: 'admin_bundle_warehouse_ops_stock',
                    routeQuery: {filters: filters, limit: limit, sort: currentSort, dir: currentDir},
                    currentPage: page,
                    pageCount: pages
                } only %}
            </div>
        </form>

        {# A <form> nested inside the filter form above would be invalid HTML (#613's fix in
           transfers.html.twig is the same shape) — the row checkboxes attach here via form="…"
           instead. #}
        <form method="post" id="stock-move-selection" action="{{ path('admin_bundle_warehouse_ops_move') }}">
            {{ csrf_field() }}
        </form>
    </section>
{% endblock %}
