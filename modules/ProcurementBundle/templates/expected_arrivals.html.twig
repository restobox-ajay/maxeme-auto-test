{% extends 'admin/_main/layout.html.twig' %}
{% block title %}Expected Arrivals | Admin{% endblock %}
{% block admin_body %}
    {% include '@Procurement/_nav.html.twig' with {
        current: 'expected',
        heading: 'Expected Arrivals',
        lead: 'What is due in, by date, per warehouse. Orders with no expected date sort last rather than being dropped — "we do not know when this is coming" is exactly the row worth chasing.'
    } only %}

    {# no-paginate: this list is deliberately unpaginated (it is a short chase list), so the client
       side must not offer a Per page control the controller would ignore. #}
    <section class="table-card no-paginate">
        <form method="get" id="expected-filters">
            <div class="table-scroll-region"><div class="wide-table-wrap"><table class="admin-grid-table">
                <thead>
                    <tr><th>Expected</th><th>PO</th><th>Vendor</th><th>Warehouse</th><th>Outstanding</th><th>Status</th><th>Action</th></tr>
                    <tr class="filter-row">
                        <th><input type="date" name="filters[through]" form="expected-filters" value="{{ filters.through }}" aria-label="Due on or before"></th>
                        <th></th>
                        <th></th>
                        <th>
                            <select name="filters[warehouse]" form="expected-filters" aria-label="Filter warehouse" onchange="this.form.submit()">
                                <option value="">All</option>
                                {% for warehouse in warehouses %}
                                    <option value="{{ warehouse.id }}"{{ filters.warehouse == warehouse.id ? ' selected' : '' }}>{{ warehouse.name }}</option>
                                {% endfor %}
                            </select>
                        </th>
                        <th></th>
                        <th></th>
                        <th>
                            <button class="button" type="submit">Filter</button>
                            <a class="button" href="{{ path('admin_bundle_procurement_expected_arrivals') }}">Reset</a>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% for order in rows %}
                        <tr class="data-item-row">
                            <td data-label="Expected">{{ order.expectedDate ?? 'unknown' }}</td>
                            <td data-label="PO"><a href="{{ path('admin_bundle_procurement_purchase_order', {id: order.id}) }}">{{ order.poNumber }}</a></td>
                            <td data-label="Vendor">{{ order.vendorName }}</td>
                            <td data-label="Warehouse">{{ order.warehouse.name }}</td>
                            <td data-label="Outstanding">{{ order.quantityOutstanding|qty }}</td>
                            <td data-label="Status">{% include 'admin/_partials/document_status.html.twig' with {status: order.status, loud: false} only %}</td>
                            <td data-label="Action"><a class="table-action" href="{{ path('admin_bundle_procurement_receive', {po: order.id}) }}">Receive</a></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" class="empty-table-cell">
                            <strong>Nothing is expected in.</strong>
                            <span>Issued purchase orders with units still outstanding appear here.</span>
                        </td></tr>
                    {% endfor %}
                </tbody>
            </table></div></div>
            {# A real submit button, so the filter row applies with JavaScript off. #}
            <button type="submit" hidden aria-hidden="true" tabindex="-1"></button>
            <div class="table-footer">
                {% include 'admin/_table_count.html.twig' with {count: rows|length, total: rows|length, currentPage: 1, perPage: max(1, rows|length), label: 'orders due in'} only %}
            </div>
        </form>
    </section>
{% endblock %}
