{% extends 'admin/_main/layout.html.twig' %}
{% block title %}{{ mode }} Custom Menu Item | Admin{% endblock %}
{% block admin_body %}
    {% set isCreate = mode == 'Create' %}

    <section class="panel compact-panel">
        <div class="panel-title-row">
            <div>
                <p class="eyebrow">Apps › Configuration › Admin Menu</p>
                <h1>{{ mode }} Custom Menu Item</h1>
            </div>
            <div class="panel-actions">
                <a class="button back-button" href="{{ path('admin_bundle_admin_menu_config') }}">Back</a>
            </div>
        </div>
    </section>

    <section class="panel admin-create-form-panel">
        <form method="post" class="form-grid" id="admin-custom-menu-item-form">
            {{ csrf_field() }}

            <label class="span-2">
                Label <span class="req">*</span>
                <input type="text" name="label" value="{{ formData.label ?? (item ? item.label : '') }}" placeholder="e.g. Warehouse Map" required>
            </label>

            <label class="span-2">
                URL <span class="req">*</span>
                <input type="text" name="url" value="{{ formData.url ?? (item ? item.url : '') }}" placeholder="/admin/some-page or https://example.com/doc" required>
                <span class="field-hint">Relative (e.g. "/admin/some-page") or absolute (e.g. "https://example.com/doc").</span>
            </label>

            <label class="span-2">
                Parent
                <select name="parent">
                    <option value="" {{ (formData.parent ?? (item ? item.parentKey : null)) is null or (formData.parent ?? '') == '' ? 'selected' : '' }}>Top level</option>
                    {% for option in parentOptions %}
                        <option value="{{ option.key }}" {{ (formData.parent ?? (item ? item.parentKey : null)) == option.key ? 'selected' : '' }}>{{ option.label }}</option>
                    {% endfor %}
                </select>
                <span class="field-hint">Where this link sits in the sidebar. Leave as "Top level" for a standalone entry.</span>
            </label>

            <div class="form-actions">
                <button type="submit" class="button primary">{{ isCreate ? 'Save Menu Item' : 'Update Menu Item' }}</button>
            </div>
        </form>
    </section>
{% endblock %}
