{% extends 'admin/_main/layout.html.twig' %}
{% block title %}{{ connection ? 'Edit ' ~ connection.name : 'New WooCommerce connection' }} | Admin{% endblock %}
{% block admin_body %}
    <section class="panel compact-panel">
        <div class="panel-title-row">
            <div>
                <p class="eyebrow">Connectors ▸ WooCommerce</p>
                <h1>{{ connection ? 'Editing: ' ~ connection.name : 'New connection' }}</h1>
            </div>
        </div>
    </section>

    <section class="panel">
        <form method="post" action="{{ path('admin_bundle_woocommerce_connection_save') }}">
            {{ csrf_field() }}
            <input type="hidden" name="id" value="{{ connection ? connection.id : 0 }}">

            <div class="form-grid">
                <label>Name <input type="text" name="name" required maxlength="120" value="{{ connection ? connection.name : '' }}"></label>
                <label>Slug <input type="text" name="slug" required maxlength="60" value="{{ connection ? connection.slug : '' }}">
                    <small>Short, unique, url-safe. Used to derive SKUs for this connection's Woo items when Woo sends none.</small>
                </label>
                <label class="span-2">Store URL <input type="text" name="store_url" required maxlength="255" value="{{ connection ? connection.storeUrl : '' }}" placeholder="https://store.example.com"></label>
                <label>Consumer key <input type="text" name="consumer_key" maxlength="255" value="{{ connection ? connection.consumerKey : '' }}"></label>
                <label>Consumer secret
                    <input type="password" name="consumer_secret" maxlength="255" placeholder="{{ connection ? 'Leave blank to keep the current value' : '' }}">
                </label>
                <label class="span-2">Webhook secret
                    <input type="text" name="webhook_secret" required maxlength="255" value="{{ connection ? connection.webhookSecret : '' }}">
                    <small>Verifies X-WC-Webhook-Signature on every incoming order — an order that doesn't verify is rejected, not held.</small>
                </label>
                {% if connection %}
                    <div class="span-2">
                        <p class="lead">
                            In WooCommerce, register <strong>two</strong> webhooks pointing at
                            <code>{{ url('webhook_woocommerce_order', {slug: connection.slug}) }}</code>,
                            with this same webhook secret: topic <code>Order created</code> and topic
                            <code>Order updated</code>. Both deliver the same payload shape, so both are handled
                            here — <code>Order created</code> is what imports and invoices a new order, and
                            <code>Order updated</code> is what this connection needs to notice a full refund
                            later and raise a credit note for it. A connection with only <code>Order created</code>
                            registered will never see a refund on an order it already invoiced.
                        </p>
                    </div>
                {% endif %}
                <label>Default warehouse
                    <select name="default_warehouse_id">
                        <option value="0">&mdash; none &mdash;</option>
                        {% for w in warehouses %}
                            <option value="{{ w.id }}"{{ connection and connection.defaultWarehouse and connection.defaultWarehouse.id == w.id ? ' selected' : '' }}>{{ w.name }}</option>
                        {% endfor %}
                    </select>
                    <small>Every order from this connection fulfills from here — not resolved per order.</small>
                </label>
                <label>Default price list
                    <select name="default_price_list_id">
                        <option value="0">&mdash; none &mdash;</option>
                        {% for p in priceLists %}
                            <option value="{{ p.id }}"{{ connection and connection.defaultPriceList and connection.defaultPriceList.id == p.id ? ' selected' : '' }}>{{ p.name }}</option>
                        {% endfor %}
                    </select>
                    <small>Used for a Woo customer tier with no specific mapping below.</small>
                </label>
                <label>Available-to-sell buffer
                    <input type="number" name="availability_buffer" value="{{ connection ? connection.availabilityBuffer : 0 }}">
                    <small>Added to Available before it is sent to Woo. Negative holds back a safety margin.</small>
                </label>
                <label class="checkbox-label">
                    <input type="checkbox" name="active" value="1"{{ (not connection) or connection.active ? ' checked' : '' }}>
                    Active — accepts orders and pushes stock
                </label>
            </div>

            <div class="form-actions">
                <button class="button primary" type="submit">Save</button>
                <a class="button back-button" href="{{ path('admin_bundle_woocommerce_connections') }}">Back</a>
            </div>
        </form>
    </section>
{% endblock %}
