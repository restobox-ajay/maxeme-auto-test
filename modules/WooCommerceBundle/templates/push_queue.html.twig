{% extends 'admin/_main/layout.html.twig' %}
{% block title %}WooCommerce Push Queue | Admin{% endblock %}
{% block admin_body %}
    {% include '@WooCommerce/_nav.html.twig' with {
        current: 'push_queue',
        heading: 'Push Queue',
        lead: 'Every product whose Available-to-sell quantity changed and is waiting to be pushed out. Drained automatically on a short interval — this page is for seeing it happen and forcing it when it does not.'
    } only %}

    <section class="panel compact-panel">
        <div class="panel-actions">
            <form method="post" action="{{ path('admin_bundle_woocommerce_push_queue_push_all') }}">
                {{ csrf_field() }}
                <button class="button primary" type="submit">Push queue now</button>
            </form>
        </div>
    </section>

    <section class="table-card no-paginate">
        <form method="get" id="push-queue-filters" action="{{ path('admin_bundle_woocommerce_push_queue') }}">
            <div class="table-header">
                <div class="table-tools">
                    <select name="filters[connection_id]" onchange="this.form.submit()">
                        <option value="0">All stores</option>
                        {% for connection in connections %}
                            <option value="{{ connection.id }}"{{ filters.connection_id == connection.id ? ' selected' : '' }}>{{ connection.name }}</option>
                        {% endfor %}
                    </select>
                    <select name="filters[status]" onchange="this.form.submit()">
                        <option value=""{{ filters.status == '' ? ' selected' : '' }}>All</option>
                        <option value="Pending"{{ filters.status == 'Pending' ? ' selected' : '' }}>Pending</option>
                        <option value="Pushed"{{ filters.status == 'Pushed' ? ' selected' : '' }}>Pushed</option>
                        <option value="Failed"{{ filters.status == 'Failed' ? ' selected' : '' }}>Failed</option>
                    </select>
                    <button class="button" type="submit">Filter</button>
                    <a class="button" href="{{ path('admin_bundle_woocommerce_push_queue') }}">Clear</a>
                </div>
            </div>
            <div class="table-scroll-region"><div class="wide-table-wrap"><table>
                <thead>
                    <tr>
                        <th>Store</th>
                        <th>Product</th>
                        <th>Status</th>
                        <th>Attempts</th>
                        <th>Requested</th>
                        <th>Last pushed</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in items %}
                        <tr>
                            <td data-label="Store">{{ item.connection.name }}</td>
                            <td data-label="Product">{{ item.product.sku }} &mdash; {{ item.product.name }}</td>
                            <td data-label="Status">
                                {% if item.status == 'Failed' %}
                                    <span class="badge danger" title="{{ item.errorMessage }}">Failed</span>
                                {% elseif item.status == 'Pushed' %}
                                    <span class="badge success">Pushed</span>
                                {% else %}
                                    <span class="badge warn">Pending</span>
                                {% endif %}
                            </td>
                            <td data-label="Attempts">{{ item.attempts }}</td>
                            <td data-label="Requested">{{ item.requestedAt|date('Y-m-d H:i') }}</td>
                            <td data-label="Last pushed">{{ item.pushedAt ? item.pushedAt|date('Y-m-d H:i') : '—' }}</td>
                            <td data-label="Actions"><button class="table-action" type="submit" form="push-item-{{ item.id }}">Push now</button></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" class="empty-table-cell"><span>Nothing is queued right now.</span></td></tr>
                    {% endfor %}
                </tbody>
            </table></div></div>
            <div class="table-footer">
                {% include 'admin/_table_count.html.twig' with { count: items|length, label: 'items' } only %}
            </div>
        </form>
        {% for item in items %}
            {# POST rather than a link, sitting after the outer filter form's own closing tag — a
               <form> nested inside another <form> is invalid HTML and the inner one gets silently
               dropped/reparented. #}
            <form method="post" id="push-item-{{ item.id }}" hidden action="{{ path('admin_bundle_woocommerce_push_queue_push_one', {id: item.id}) }}">
                {{ csrf_field() }}
            </form>
        {% endfor %}
    </section>
{% endblock %}
