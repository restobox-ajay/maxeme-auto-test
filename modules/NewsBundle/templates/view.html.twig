{% extends 'customer/_main/layout.html.twig' %}
{% block title %}{{ post.title }} | {{ site_name() }}{% endblock %}
{% block customer_body %}
    <section class="catalog-page-head" aria-label="News post heading">
        <div>
            <h1>{{ post.title }}</h1>
            <nav class="breadcrumbs" aria-label="Breadcrumb">
                <a href="{{ path('customer_home') }}">Home</a>
                <span>/</span>
                <span>{{ post.title }}</span>
            </nav>
        </div>
    </section>

    <section class="panel">
        <p class="lead">Posted on {{ post.publishedAt|date('F j, Y') }}</p>
        <div class="news-post-content">{{ post.content|raw }}</div>
    </section>
{% endblock %}
