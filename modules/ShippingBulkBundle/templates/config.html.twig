{% extends 'admin/_main/layout.html.twig' %}
{% block title %}Bulk Delivery — Shipping Bundle | Admin{% endblock %}
{% block admin_body %}
    <section class="panel compact-panel">
        <div class="panel-title-row">
            <div>
                <p class="eyebrow">Apps › Shipping</p>
                <h1>Bulk Delivery</h1>
            </div>
            <div class="panel-actions">
                <a class="button back-button" href="{{ path('admin_dashboard') }}">Back</a>
            </div>
        </div>
    </section>

    <section class="panel">
        <h2>Rate Table</h2>
        <p>Rates are applied per order, not per item. The province of the shipping address determines the rate.</p>
        <table class="admin-grid-table data-table" style="max-width:480px;margin-top:1rem">
            <thead>
                <tr>
                    <th>Province</th>
                    <th>Rate</th>
                    <th>Delivery</th>
                </tr>
            </thead>
            <tbody>
                {% for province, amount in rates %}
                <tr>
                    <td>{{ province }}</td>
                    <td>${{ amount|amount }}</td>
                    <td>{{ deliveryDays }} days</td>
                </tr>
                {% endfor %}
                <tr>
                    <td><em>All other provinces</em></td>
                    <td>${{ rateDefault|amount }}</td>
                    <td>{{ deliveryDays }} days</td>
                </tr>
            </tbody>
        </table>
        <p style="margin-top:1rem;color:var(--text-muted,#6b7280);font-size:0.875rem">
            Rates are set in code (<code>BulkShippingCalculator</code>). Contact your developer to adjust them.
        </p>
    </section>

    <section class="panel">
        <h2>Eligibility</h2>
        <p>Bulk Delivery appears as an option only when at least one cart item has <code>shippingClass = "bulk"</code>.</p>
    </section>
{% endblock %}
