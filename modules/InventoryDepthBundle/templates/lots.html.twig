{% extends 'admin/_main/layout.html.twig' %}
{% block title %}Lots | Admin{% endblock %}
{% block admin_body %}
    {% include '@InventoryDepth/_nav.html.twig' with {
        current: 'lots',
        heading: 'Lots',
        lead: 'Batches, with the expiry date each one carries. Expiry is the LAST USABLE DAY — stock dated the 30th is sellable through the 30th and unsellable from the 1st.'
    } only %}

    {% if duplicateGroups is not empty %}
        {# Reported, never merged (#590). Two runs sharing a batch code with different dates really are
           two lots, so nothing here can decide which pairs are mistakes — it names them and stops. #}
        <section class="panel">
            <h2>Lot codes used more than once on the same product</h2>
            <p class="lead">Compare the expiry dates against the units, then retire whichever row is wrong.</p>
            <div class="table-scroll-region"><div class="wide-table-wrap"><table class="admin-grid-table">
                <thead>
                    <tr><th>Product</th><th>Code</th><th>The rows sharing it</th></tr>
                </thead>
                <tbody>
                {% for group in duplicateGroups %}
                    <tr class="data-item-row is-oversold">
                        <td data-label="Product">
                            <a href="{{ path('admin_bundle_inventory_depth_stock_by_product', {id: group.product.id}) }}">{{ group.product.sku ?: group.product.name }}</a>
                        </td>
                        <td data-label="Code">{{ group.code }}</td>
                        <td data-label="The rows sharing it">
                            {% for lot in group.lots %}
                                <a href="{{ path('admin_bundle_inventory_depth_lots', {edit: lot.id}) }}#lot-form">row {{ lot.id }}</a>
                                ({{ lot.expiry ? lot.expiry|date('Y-m-d') : 'no expiry' }}){{ not loop.last ? ', ' : '' }}
                            {% endfor %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table></div></div>
        </section>
    {% endif %}

    <section class="panel" id="lot-form">
        <h2>{{ editing ? 'Edit lot ' ~ editing.label : 'Add a lot' }}</h2>
        <p class="lead">To correct a date, edit that lot's row rather than adding a new one.</p>
        <form method="post" action="{{ path('admin_bundle_inventory_depth_lot_save') }}" class="form-grid">
            {{ csrf_field() }}
            <input type="hidden" name="id" value="{{ editing ? editing.id : 0 }}">
            {% if editing %}
                {# The product is not editable. Detail rows, movements and the availability sum all hang off
                   (product, lot), so moving a lot to another product would silently reassign every one of them. #}
                <label>Product
                    <input type="text" value="{{ editing.product.sku ?: editing.product.name }}" disabled>
                    <small>A lot's product cannot be changed — the stock rows hang off it. Add a new lot instead.</small>
                </label>
            {% else %}
                {# The shared three-tier picker, not a database id (#8). It is core's partial and
                   not ProcurementBundle's: this bundle must keep working with purchasing deleted,
                   and a deleted module takes its Twig namespace and its routes with it — the same
                   reason ReorderController guards its one link out to a purchase order. #}
                <label>Product
                    {{ include('admin/_partials/product_field.html.twig', {
                        field: 'product_id',
                        products: productOptions,
                        remote: productsRemote,
                        selected: null,
                        required: true,
                        label: 'Product this lot belongs to',
                    }, with_context = false) }}
                    <small>A lot belongs to one product and cannot be moved later — the stock rows hang off the pair.</small>
                </label>
            {% endif %}
            <label>Lot code <input type="text" name="code" maxlength="64" required value="{{ editing ? editing.code : '' }}"></label>
            <label>Expiry (last usable day) <input type="date" name="expiry" value="{{ editing and editing.expiry ? editing.expiry|date('Y-m-d') : '' }}"></label>
            <label>Received <input type="date" name="received_at" value="{{ editing and editing.receivedAt ? editing.receivedAt|date('Y-m-d') : '' }}"></label>
            <label>Source <input type="text" name="source" maxlength="160" placeholder="Vendor or shipment" value="{{ editing ? editing.source : '' }}"></label>
            <label>Status
                <select name="status">
                    <option value="available"{{ (not editing or editing.status == 'available') ? ' selected' : '' }}>Available</option>
                    <option value="on_hold"{{ editing and editing.status == 'on_hold' ? ' selected' : '' }}>On Hold</option>
                    <option value="recalled"{{ editing and editing.status == 'recalled' ? ' selected' : '' }}>Recalled</option>
                </select>
                <small>On Hold or Recalled: this lot stops being offered on the Order/Invoice line lot picker, and a save naming it directly is measured as having nothing available. See <a href="{{ path('admin_bundle_inventory_depth_lot_trace') }}">Trace a lot</a> to search by code and see where it currently is and who it was sold to.</small>
            </label>
            <div class="form-actions span-2">
                <button class="button primary" type="submit">{{ editing ? 'Save changes to row ' ~ editing.id : 'Add lot' }}</button>
                {% if editing %}<a class="button" href="{{ path('admin_bundle_inventory_depth_lots') }}">Cancel</a>{% endif %}
            </div>
        </form>
    </section>

    <section class="table-card no-paginate">
        <form method="get" id="lots-filters">
            <input type="hidden" name="page" value="1">
            <div class="table-scroll-region"><div class="wide-table-wrap"><table class="admin-grid-table">
                <thead>
                    <tr>
                        <th class="is-sortable{% if currentSort == 'code' %} is-sorted-{{ currentDir }}{% endif %}">
                            <a href="{{ path('admin_bundle_inventory_depth_lots', {filters: filters, limit: limit, page: 1, sort: 'code', dir: currentSort == 'code' and currentDir == 'asc' ? 'desc' : 'asc'}) }}">Lot</a>
                        </th>
                        <th class="is-sortable{% if currentSort == 'product' %} is-sorted-{{ currentDir }}{% endif %}">
                            <a href="{{ path('admin_bundle_inventory_depth_lots', {filters: filters, limit: limit, page: 1, sort: 'product', dir: currentSort == 'product' and currentDir == 'asc' ? 'desc' : 'asc'}) }}">Product</a>
                        </th>
                        <th class="is-sortable{% if currentSort == 'expiry' %} is-sorted-{{ currentDir }}{% endif %}">
                            <a href="{{ path('admin_bundle_inventory_depth_lots', {filters: filters, limit: limit, page: 1, sort: 'expiry', dir: currentSort == 'expiry' and currentDir == 'asc' ? 'desc' : 'asc'}) }}">Expiry</a>
                        </th>
                        <th class="is-sortable{% if currentSort == 'received' %} is-sorted-{{ currentDir }}{% endif %}">
                            <a href="{{ path('admin_bundle_inventory_depth_lots', {filters: filters, limit: limit, page: 1, sort: 'received', dir: currentSort == 'received' and currentDir == 'asc' ? 'desc' : 'asc'}) }}">Received</a>
                        </th>
                        <th>Source</th>
                        <th>State</th>
                        <th>Status</th>
                        <th>Row</th>
                    </tr>
                    <tr class="filter-row">
                        <th><input type="text" name="filters[code]" form="lots-filters" value="{{ filters.code }}" placeholder="Lot code" aria-label="Filter lot code"></th>
                        <th><input type="text" name="filters[product]" form="lots-filters" value="{{ filters.product }}" placeholder="SKU or name" aria-label="Filter product"></th>
                        <th>
                            {# The expiring-soon view is this list with a window, not a separate screen — so the
                               window is a GET param and a copied URL reproduces it. #}
                            <select name="filters[expiringWithin]" form="lots-filters" aria-label="Filter expiry window" onchange="this.form.submit()">
                                <option value="">Any date</option>
                                {% for days in [0, 7, 30, 60, 90, 180] %}
                                    <option value="{{ days }}"{{ filters.expiringWithin == days ~ '' ? ' selected' : '' }}>
                                        {{ days == 0 ? 'Last usable day today or past' : 'Within ' ~ days ~ ' days' }}
                                    </option>
                                {% endfor %}
                            </select>
                        </th>
                        <th></th>
                        <th><input type="text" name="filters[source]" form="lots-filters" value="{{ filters.source }}" placeholder="Source" aria-label="Filter source"></th>
                        <th></th>
                        <th>
                            <select name="filters[status]" form="lots-filters" aria-label="Filter status" onchange="this.form.submit()">
                                <option value="">Any status</option>
                                <option value="available"{{ filters.status == 'available' ? ' selected' : '' }}>Available</option>
                                <option value="on_hold"{{ filters.status == 'on_hold' ? ' selected' : '' }}>On Hold</option>
                                <option value="recalled"{{ filters.status == 'recalled' ? ' selected' : '' }}>Recalled</option>
                            </select>
                        </th>
                        <th>
                            <button class="button" type="submit">Filter</button>
                            <a class="button" href="{{ path('admin_bundle_inventory_depth_lots') }}">Reset</a>
                        </th>
                    </tr>
                </thead>
                <tbody>
                {% for row in rows %}
                    {% set expired = row.expiry and row.expiry|date('Y-m-d') < today|date('Y-m-d') %}
                    <tr class="data-item-row{{ (expired or row.status != 'available') ? ' is-oversold' : '' }}">
                        <td data-label="Lot">{{ row.label }}</td>
                        <td data-label="Product"><a href="{{ path('admin_bundle_inventory_depth_stock_by_product', {id: row.product.id}) }}">{{ row.product.sku ?: row.product.name }}</a></td>
                        <td data-label="Expiry">{{ row.expiry ? row.expiry|date('Y-m-d') : 'Does not expire' }}</td>
                        <td data-label="Received">{{ row.receivedAt ? row.receivedAt|date('Y-m-d') : '—' }}</td>
                        <td data-label="Source">{{ row.source ?: '—' }}</td>
                        <td data-label="State">{{ expired ? 'Past its last usable day' : 'In date' }}</td>
                        <td data-label="Status">
                            {% if row.status == 'recalled' %}<span class="badge danger">Recalled</span>
                            {% elseif row.status == 'on_hold' %}<span class="badge warn">On Hold</span>
                            {% else %}<span class="badge success">Available</span>
                            {% endif %}
                        </td>
                        <td data-label="Row">
                            <a class="table-action" href="{{ path('admin_bundle_inventory_depth_stock_by_product', {id: row.product.id}) }}">View stock</a>
                            <a class="table-action" href="{{ path('admin_bundle_inventory_depth_lot_trace_view', {id: row.id}) }}">Trace</a>
                            {# A plain link, no JavaScript: it reloads this page with the form filled from this row,
                               and the hidden id then names the row the save updates (#590). #}
                            <a class="table-action" href="{{ path('admin_bundle_inventory_depth_lots', {filters: filters, limit: limit, page: page, sort: currentSort, dir: currentDir, edit: row.id}) }}#lot-form">Edit {{ row.id }}</a>
                            {# POST, never a link, and its form is emitted below outside the filter form —
                               a <form> inside a <form> is invalid HTML and every parser drops the inner
                               one, which would leave this button submitting the filters instead (#613). #}
                            <button type="submit" class="table-action danger" form="delete-lot-{{ row.id }}">Delete</button>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="8" class="empty-table-cell"><strong>No lots match.</strong></td></tr>
                {% endfor %}
                </tbody>
            </table></div></div>
            {# A real submit button, so the filter row applies with JavaScript off. #}
            <button type="submit" hidden aria-hidden="true" tabindex="-1"></button>
            <div class="table-footer">
                {% include 'admin/_table_count.html.twig' with {count: rows|length, total: total, currentPage: page, perPage: limit, label: 'lots'} only %}
                <label class="per-page-label">Per page
                    <select name="limit" form="lots-filters" onchange="this.form.submit()">
                        {% for option in [20, 100, 200, 500] %}<option value="{{ option }}"{{ limit == option ? ' selected' : '' }}>{{ option }}</option>{% endfor %}
                    </select>
                </label>
                {% include 'admin/_pagination.html.twig' with {
                    routeName: 'admin_bundle_inventory_depth_lots',
                    routeQuery: {filters: filters, limit: limit, sort: currentSort, dir: currentDir},
                    currentPage: page, pageCount: pages
                } only %}
            </div>
        </form>
        {% for row in rows %}
            {# One Delete form per row, outside the filter form. The confirm is an onsubmit courtesy:
               with JavaScript off it never runs and the button still posts. #}
            <form method="post" id="delete-lot-{{ row.id }}" hidden
                  action="{{ path('admin_bundle_inventory_depth_lot_delete', {id: row.id}) }}"
                  onsubmit="return confirm('Delete lot {{ row.label|e('js') }}? It is refused if any stock, movement or document still names it.')">
                {{ csrf_field() }}
            </form>
        {% endfor %}
        <p class="lead">A lot does not stop being sellable on its expiry date until the expiry sweep next runs.</p>
    </section>
{% endblock %}
