{% extends 'admin/_main/layout.html.twig' %}
{% block title %}Bins | Admin{% endblock %}
{% block admin_body %}
    {# Two form panels sit above the table, so the shared list-page clamp (content-frame = 100vh,
       table-card = whatever is left) leaves the table 2px tall. Let the page grow and give the
       table its own capped scroll region instead. #}
    <style>
        .site-admin .content-frame:has(> .table-card) { height: auto; padding-bottom: 1rem; }
        .site-admin .content-frame > .table-card:has(.table-scroll-region) { flex: 0 0 auto; }
        .site-admin .content-frame > .table-card .table-scroll-region { max-height: 75vh; }
    </style>
    {% include '@InventoryDepth/_nav.html.twig' with {
        current: 'bins',
        heading: 'Bins',
        lead: 'Named places inside a warehouse. Sort key is pick-path traversal order — it is the tiebreak the automatic source picker uses after expiry, so it is a real operational number.'
    } only %}

    <section class="panel">
        <h2>Create a range</h2>
        <p class="lead">Nobody types 200 bins one at a time. Codes that already exist are skipped, so re-running a range to extend it is safe.</p>
        <form method="post" action="{{ path('admin_bundle_inventory_depth_bin_bulk') }}" class="form-grid">
            {{ csrf_field() }}
            <label>Warehouse
                <select name="warehouse_id" required>
                    {% for w in warehouses %}<option value="{{ w.id }}">{{ w.name }}</option>{% endfor %}
                </select>
            </label>
            <label>Code prefix <input type="text" name="prefix" maxlength="16" placeholder="A"></label>
            <label>Aisles <input type="number" name="aisles" min="1" max="100" value="1"></label>
            <label>Racks per aisle <input type="number" name="racks" min="1" max="100" value="1"></label>
            <label>Shelves per rack <input type="number" name="shelves" min="1" max="100" value="1"></label>
            <label>Type
                <select name="type">{% for t in types %}<option value="{{ t }}">{{ t }}</option>{% endfor %}</select>
            </label>
            <div class="form-actions span-2"><button class="button primary" type="submit">Create range</button></div>
        </form>
    </section>

    <section class="panel" id="bin-form">
        <h2>{{ editing ? 'Edit bin ' ~ editing.code : 'Add one bin' }}</h2>
        <p class="lead"><strong>A bin holding stock cannot be closed.</strong></p>
        <form method="post" action="{{ path('admin_bundle_inventory_depth_bin_save') }}" class="form-grid">
            {{ csrf_field() }}
            <input type="hidden" name="id" value="{{ editing ? editing.id : 0 }}">
            {% if editing %}
                {# Not editable. Moving a bin between warehouses would move every detail row standing in it
                   without a single movement being written. #}
                <label>Warehouse
                    <input type="text" value="{{ editing.warehouse.name }}" disabled>
                    <small>A bin cannot change warehouse — the stock standing in it would move with no movement recorded.</small>
                </label>
            {% else %}
                <label>Warehouse
                    <select name="warehouse_id" required>
                        {% for w in warehouses %}<option value="{{ w.id }}">{{ w.name }}</option>{% endfor %}
                    </select>
                </label>
            {% endif %}
            <label>Code <input type="text" name="code" maxlength="64" required value="{{ editing ? editing.code : '' }}"></label>
            <label>Type
                <select name="type">
                    {% for t in types %}<option value="{{ t }}"{{ editing and editing.type == t ? ' selected' : '' }}>{{ t }}</option>{% endfor %}
                </select>
            </label>
            <label>Sort key <input type="number" name="sort_key" value="{{ editing ? editing.sortKey : 0 }}"></label>
            <label>Status
                <select name="status">
                    <option value="Active"{{ editing is null or editing.status == 'Active' ? ' selected' : '' }}>Active</option>
                    <option value="Inactive"{{ editing and editing.status == 'Inactive' ? ' selected' : '' }}>Inactive</option>
                </select>
                {% if editing and units[editing.id]|default(0) > 0 %}
                    <small>Holds {{ units[editing.id] }} unit(s) — it can be renamed or re-sorted, but it cannot be set Inactive until they are moved out.</small>
                {% endif %}
            </label>
            <div class="form-actions span-2">
                <button class="button primary" type="submit">{{ editing ? 'Save changes to row ' ~ editing.id : 'Add bin' }}</button>
                {% if editing %}<a class="button" href="{{ path('admin_bundle_inventory_depth_bins') }}">Cancel</a>{% endif %}
            </div>
        </form>
    </section>

    <section class="table-card no-paginate">
        <form method="get" id="bins-filters">
            <input type="hidden" name="page" value="1">
            <div class="table-scroll-region"><div class="wide-table-wrap"><table class="admin-grid-table">
                <thead>
                    <tr>
                        <th class="is-sortable{% if currentSort == 'code' %} is-sorted-{{ currentDir }}{% endif %}">
                            <a href="{{ path('admin_bundle_inventory_depth_bins', {filters: filters, limit: limit, page: 1, sort: 'code', dir: currentSort == 'code' and currentDir == 'asc' ? 'desc' : 'asc'}) }}">Code</a>
                        </th>
                        <th class="is-sortable{% if currentSort == 'warehouse' %} is-sorted-{{ currentDir }}{% endif %}">
                            <a href="{{ path('admin_bundle_inventory_depth_bins', {filters: filters, limit: limit, page: 1, sort: 'warehouse', dir: currentSort == 'warehouse' and currentDir == 'asc' ? 'desc' : 'asc'}) }}">Warehouse</a>
                        </th>
                        <th class="is-sortable{% if currentSort == 'type' %} is-sorted-{{ currentDir }}{% endif %}">
                            <a href="{{ path('admin_bundle_inventory_depth_bins', {filters: filters, limit: limit, page: 1, sort: 'type', dir: currentSort == 'type' and currentDir == 'asc' ? 'desc' : 'asc'}) }}">Type</a>
                        </th>
                        <th class="is-sortable{% if currentSort == 'sortKey' %} is-sorted-{{ currentDir }}{% endif %}">
                            <a href="{{ path('admin_bundle_inventory_depth_bins', {filters: filters, limit: limit, page: 1, sort: 'sortKey', dir: currentSort == 'sortKey' and currentDir == 'asc' ? 'desc' : 'asc'}) }}">Sort key</a>
                        </th>
                        <th>Status</th>
                        <th>Contents</th>
                    </tr>
                    <tr class="filter-row">
                        <th><input type="text" name="filters[code]" form="bins-filters" value="{{ filters.code }}" placeholder="Code" aria-label="Filter code"></th>
                        <th>
                            <select name="filters[warehouse]" form="bins-filters" aria-label="Filter warehouse" onchange="this.form.submit()">
                                <option value="">All</option>
                                {% for w in warehouses %}<option value="{{ w.id }}"{{ filters.warehouse == w.id ~ '' ? ' selected' : '' }}>{{ w.name }}</option>{% endfor %}
                            </select>
                        </th>
                        <th>
                            <select name="filters[type]" form="bins-filters" aria-label="Filter type" onchange="this.form.submit()">
                                <option value="">All</option>
                                {% for t in types %}<option value="{{ t }}"{{ filters.type == t ? ' selected' : '' }}>{{ t }}</option>{% endfor %}
                            </select>
                        </th>
                        <th></th>
                        <th>
                            <select name="filters[status]" form="bins-filters" aria-label="Filter status" onchange="this.form.submit()">
                                <option value="">All</option>
                                <option value="Active"{{ filters.status == 'Active' ? ' selected' : '' }}>Active</option>
                                <option value="Inactive"{{ filters.status == 'Inactive' ? ' selected' : '' }}>Inactive</option>
                            </select>
                        </th>
                        <th>
                            <button class="button" type="submit">Filter</button>
                            <a class="button" href="{{ path('admin_bundle_inventory_depth_bins') }}">Reset</a>
                        </th>
                    </tr>
                </thead>
                <tbody>
                {% for row in rows %}
                    <tr class="data-item-row">
                        <td data-label="Code">{{ row.code }}</td>
                        <td data-label="Warehouse">{{ row.warehouse.name }}</td>
                        <td data-label="Type">{{ row.type }}</td>
                        <td data-label="Sort key">{{ row.sortKey }}</td>
                        <td data-label="Status">{{ row.status }}</td>
                        <td data-label="Contents">
                            {% set held = units[row.id]|default(0) %}
                            <strong>{{ held }}</strong> unit(s){{ held > 0 ? ' — cannot be closed' : '' }}<br>
                            <a class="table-action" href="{{ path('admin_bundle_inventory_depth_stock_by_location', {filters: {bin: row.code}}) }}">View</a>
                            <a class="table-action" href="{{ path('admin_bundle_inventory_depth_cycle_count', {bin: row.id}) }}">Count</a>
                            {# A plain link, no JavaScript: it reloads this page with the form filled from this row,
                               and the hidden id then names the row the save updates (#590). #}
                            <a class="table-action" href="{{ path('admin_bundle_inventory_depth_bins', {filters: filters, limit: limit, page: page, sort: currentSort, dir: currentDir, edit: row.id}) }}#bin-form">Edit {{ row.id }}</a>
                            {# POST, never a link: a delete a crawler or a prefetch can follow is a delete
                               that happens without anybody pressing it (#613). The form itself is emitted
                               below, OUTSIDE the filter form, and referenced by id — a <form> inside a
                               <form> is invalid HTML and every parser silently drops the inner one. #}
                            <button type="submit" class="table-action danger" form="delete-bin-{{ row.id }}">Delete</button>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="empty-table-cell"><strong>No bins yet.</strong><span>Create a range above.</span></td></tr>
                {% endfor %}
                </tbody>
            </table></div></div>
            {# A real submit button, so the filter row applies with JavaScript off. #}
            <button type="submit" hidden aria-hidden="true" tabindex="-1"></button>
            <div class="table-footer">
                {% include 'admin/_table_count.html.twig' with {count: rows|length, total: total, currentPage: page, perPage: limit, label: 'bins'} only %}
                <label class="per-page-label">Per page
                    <select name="limit" form="bins-filters" onchange="this.form.submit()">
                        {% for option in [20, 100, 200, 500] %}<option value="{{ option }}"{{ limit == option ? ' selected' : '' }}>{{ option }}</option>{% endfor %}
                    </select>
                </label>
                {% include 'admin/_pagination.html.twig' with {
                    routeName: 'admin_bundle_inventory_depth_bins',
                    routeQuery: {filters: filters, limit: limit, sort: currentSort, dir: currentDir},
                    currentPage: page, pageCount: pages
                } only %}
            </div>
        </form>
        {% for row in rows %}
            {# One Delete form per row, outside the filter form for the reason the button says. The
               onsubmit confirm is a courtesy: with JavaScript off it never runs and the button still
               posts, which is the whole point of it being a form rather than a js- hook. #}
            <form method="post" id="delete-bin-{{ row.id }}" hidden
                  action="{{ path('admin_bundle_inventory_depth_bin_delete', {id: row.id}) }}"
                  onsubmit="return confirm('Delete bin {{ row.code|e('js') }}? It is refused if anything still points at it.')">
                {{ csrf_field() }}
            </form>
        {% endfor %}
    </section>
{% endblock %}
