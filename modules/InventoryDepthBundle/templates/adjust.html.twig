{% extends 'admin/_main/layout.html.twig' %}
{% block title %}Stock Adjustment | Admin{% endblock %}
{% block admin_body %}
    <style>
        .adj-search { position: relative; }
        .adj-results { position: absolute; z-index: 60; left: 0; right: 0; top: 100%; max-height: 320px; overflow: auto; background: #fff; border: 1px solid var(--line); border-radius: 8px; box-shadow: 0 8px 24px rgba(0,0,0,.1); }
        .adj-results[hidden] { display: none; }
        .adj-results button { display: flex; justify-content: space-between; gap: 12px; width: 100%; padding: 7px 10px; border: 0; background: none; text-align: left; cursor: pointer; font: inherit; }
        .adj-results button:hover, .adj-results button.is-active { background: var(--mx-primary-soft, #eef4fb); }
        .adj-results .muted-line { white-space: nowrap; }
        .adj-explain { display: block; margin-top: 6px; }
    </style>

    {% include '@InventoryDepth/_nav.html.twig' with {
        current: 'adjust',
        heading: 'Stock Adjustment',
        lead: 'Say what happened and the movement follows from it. Every submission writes one movement group, so the reason, the actor and the date are on the record.'
    } only %}

    {# One form (Maxeme mockups 41ebdc0, cc1f585): product, quantity, reference, note, when, location,
       then the reason with its explanation, and below it what that reason needs to know about the goods
       (the write-off to reverse, the held or tracked stock to take, a batch or serials). Changing the
       product or the reason reloads the form, keeping what was typed. #}
    <section class="panel" style="max-width: 920px">
        <h2>Record a stock adjustment</h2>
        <form method="post" action="{{ path('admin_bundle_inventory_depth_adjust_submit') }}" class="form-grid" id="adjust-form"
              data-reload-url="{{ path('admin_bundle_inventory_depth_adjust') }}">
            {{ csrf_field() }}
            <input type="hidden" name="product_id" id="adjust-product-id" value="{{ product ? product.id }}">

            <label class="span-2 adj-search">
                Product
                <input type="text" id="adjust-product-search" value="{{ product ? (product.sku ?: product.name) ~ ' — ' ~ product.name }}" placeholder="Search by SKU, name, category or vendor…" autocomplete="off" aria-label="Search products">
                <div class="adj-results" id="adjust-product-results" role="listbox" hidden></div>
            </label>

            <label>
                Quantity
                {# Always positive. The reason expresses the direction. #}
                <input type="number" name="quantity" min="1" step="1" value="{{ carry.quantity ?: 1 }}" required>
            </label>
            <label>
                Reference
                <input type="text" name="reference" maxlength="160" value="{{ carry.reference }}" placeholder="Count sheet, incident number, supplier claim">
            </label>
            <label>
                Note
                <input type="text" name="note" maxlength="255" value="{{ carry.note }}" placeholder="Anything the next reader should know">
            </label>
            <label>
                When
                {# Stock found on Friday and entered on Monday belongs on Friday. #}
                <input type="date" name="occurred_at" value="{{ carry.occurred_at ?: today }}" max="{{ today }}">
            </label>
            <label class="span-2">
                Location
                <select name="warehouse_id" required>
                    {% for w in warehouses %}
                        <option value="{{ w.id }}"{{ warehouseId == w.id ? ' selected' : '' }}>{{ w.name }}</option>
                    {% endfor %}
                </select>
            </label>

            <label class="span-2">
                Reason
                <select name="reason" id="adjust-reason" required>
                    <option value="">Choose a reason…</option>
                    {% for r in reasons %}
                        <option value="{{ r.code }}"{{ reason and reason.code == r.code ? ' selected' : '' }}>{{ r.label }}</option>
                    {% endfor %}
                </select>
                {% if reason %}
                    <span class="adj-explain"><span class="badge info">{{ reason.bucketEffect }}</span> <span class="muted-line">{{ reason.help }}</span></span>
                {% endif %}
            </label>

            {% if product and reason %}
            {% if reason.reversal %}
                {# Reversing ties to the ORIGINAL ENTRY, the way Dynamics ties a reversal to the item
                   ledger entry it undoes. Bin, lot and serial all come back from that entry, so
                   nothing is retyped — and "remaining" is what stops the same units being put back
                   twice. #}
                {% if reversible is empty %}
                    <p class="span-2">Nothing has been written off for this product that still has units left to put back. If stock has turned up that was never written off, record it as <strong>Stock found</strong> instead — that is the difference between the two reasons.</p>
                {% else %}
                    <div class="span-2">
                        <table class="wide-price-table">
                            <thead>
                                <tr><th></th><th>When</th><th>Wrote off</th><th>From</th><th>Written off</th><th>Already reversed</th><th>Can still come back</th></tr>
                            </thead>
                            <tbody>
                            {% for candidate in reversible %}
                                {% set m = candidate.movement %}
                                <tr>
                                    <td><input type="radio" name="original_movement_id" value="{{ m.id }}"{{ loop.first ? ' checked' : '' }} required></td>
                                    <td>{{ m.group.occurredAt|date('Y-m-d') }}</td>
                                    <td>{{ m.toDetail.status|replace({'_': ' '}) }}</td>
                                    <td>
                                        {{ m.fromDetail.warehouse.name }} /
                                        {{ m.fromDetail.location ? m.fromDetail.location.code : '(no bin)' }}
                                        {% if m.fromDetail.lot %} / {{ m.fromDetail.lot.label }}{% endif %}
                                        {% if m.fromDetail.serial %} / S/N {{ m.fromDetail.serial }}{% endif %}
                                    </td>
                                    <td>{{ m.quantity }}</td>
                                    <td>{{ candidate.reversed }}</td>
                                    <td><strong>{{ candidate.remaining }}</strong></td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                        <p class="lead">The quantity below cannot exceed what is left on the entry you pick. If more has turned up than that, the rest was never written off — record it as stock found.</p>
                    </div>
                {% endif %}

            {% elseif reason.inbound %}

                <label>
                    Bin
                    <select name="location_id">
                        <option value="0">Unspecified</option>
                        {% for b in bins %}
                            <option value="{{ b.id }}">{{ b.warehouse.name }} — {{ b.code }}</option>
                        {% endfor %}
                    </select>
                </label>

                {% if asksInboundLot %}
                    {# PICK-OR-CREATE, not a dropdown of existing lots only: a found box carries a
                       batch code that may never have been in this system. Code and expiry are shown
                       together everywhere, because vendors reuse batch codes across production runs
                       and the code alone does not identify a batch. #}
                    <label>
                        Batch — pick one
                        <select name="lot_id">
                            <option value="0">…or type a new one below</option>
                            {% for l in lots %}
                                <option value="{{ l.id }}">{{ l.label }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <label>
                        …or a new batch code
                        <input type="text" name="new_lot_code" maxlength="64" placeholder="Printed on the box">
                    </label>
                    <label>
                        New batch expiry{{ expiryRequired ? ' (required)' : '' }}
                        <input type="date" name="new_lot_expiry">
                    </label>
                    <p class="lead span-2">
                        Leave both blank if the box carries no code you can read. The row is then stamped with the
                        placeholder and flagged on the
                        <a href="{{ path('admin_bundle_inventory_depth_tracking_worklist') }}">tracking worklist</a>
                        for somebody to complete — tracking never blocks a movement.
                    </p>
                {% endif %}

                {% if asksInboundSerials %}
                    {# One row per unit, because a serial identifies one unit and a serial row is
                       therefore quantity 1. The row count IS the quantity. #}
                    <div class="span-2">
                        <p class="section-label">Serial numbers — one per unit</p>
                        {% for i in 1..rowCount %}
                            <input type="text" name="serials[]" maxlength="120" placeholder="Unit {{ i }}" aria-label="Serial for unit {{ i }}">
                        {% endfor %}
                        <p class="lead">
                            Fill in exactly as many as the quantity below. Leave them all blank to record the units as
                            not yet identified — they are then flagged on the
                            <a href="{{ path('admin_bundle_inventory_depth_tracking_worklist') }}">tracking worklist</a>.
                            <a href="{{ path('admin_bundle_inventory_depth_adjust', {product: product.id, reason: reason.code, warehouse: warehouseId, rows: rowCount + 10}) }}">Add ten more rows</a>.
                        </p>
                    </div>
                {% endif %}

                {% if asksInboundExpiry %}
                    {# Expiry is its own Yes/No, independent of lot, serial and direction (#795) — this
                       product carries no batch for the date to ride on, so it lives on the row itself. #}
                    <label>
                        Expiry (required)
                        <input type="date" name="new_detail_expiry" required>
                    </label>
                {% endif %}

                {% if stampsSentinel %}
                    <p class="lead span-2">
                        This product carries {{ policy.mode == 'lot' ? 'batch codes' : 'serial numbers' }}, and policy
                        “{{ policy.name }}” does not capture them on the way in. The row is stamped with the placeholder
                        and flagged on the
                        <a href="{{ path('admin_bundle_inventory_depth_tracking_worklist') }}">tracking worklist</a>
                        so somebody can put a real identity on it later.
                    </p>
                {% endif %}

            {% elseif asksNamedSource %}
                {# The operator names which rows the stock comes off: either because the policy
                   tracks identity outbound, or because a hold is always against particular goods. #}
                {% if sourceRows is empty %}
                    <p class="span-2">There is no {{ reason.fromStatus|replace({'_': ' '}) }} stock of this product to take.</p>
                {% elseif asksSerialSources %}
                    <div class="span-2">
                        <p class="section-label">Which units — one row per unit</p>
                        {% for i in 1..rowCount %}
                            <select name="source_detail_ids[]">
                                <option value="0">Unit {{ i }} — not used</option>
                                {% for row in sourceRows %}
                                    <option value="{{ row.id }}">
                                        {% if row.serial %}S/N {{ row.serial }} — {% endif %}
                                        {{ row.warehouse.name }} / {{ row.location ? row.location.code : '(no bin)' }}
                                        {%- if row.lot %} / {{ row.lot.label }}{% endif %} ({{ row.quantity }})
                                    </option>
                                {% endfor %}
                            </select>
                        {% endfor %}
                        <p class="lead">
                            Choose exactly as many rows as the quantity below.
                            <a href="{{ path('admin_bundle_inventory_depth_adjust', {product: product.id, reason: reason.code, warehouse: warehouseId, rows: rowCount + 10}) }}">Add ten more rows</a>.
                        </p>
                    </div>
                {% else %}
                    <label class="span-2">
                        Which {{ reason.fromStatus|replace({'_': ' '}) }} stock
                        {# Earliest expiry first, then lowest bin sort key — so the row an operator
                           most likely means is the first one they see. #}
                        <select name="source_detail_id" required>
                            {% for row in sourceRows %}
                                {% set expiry = row.lot ? row.lot.expiry : row.expiry %}
                                {% set past = expiry and expiry|date('Y-m-d') <= today %}
                                <option value="{{ row.id }}">
                                    {{ row.warehouse.name }} / {{ row.location ? row.location.code : '(no bin)' }}
                                    {%- if row.lot %} / {{ row.lot.label }}{% elseif row.expiry %} / exp {{ row.expiry|date('Y-m-d') }}{% endif %}
                                    {%- if past %} — AT OR PAST EXPIRY{% endif %}
                                    {%- if row.serial %} / S/N {{ row.serial }}{% endif %}
                                    — {{ row.quantity }} unit(s)
                                </option>
                            {% endfor %}
                        </select>
                    </label>
                    {% if prefersExpiredLots %}
                        <p class="lead span-2">Batches at or past their last usable day are marked. That is what this reason is for — the nightly sweep would have caught them eventually, and this is a person catching them first.</p>
                    {% endif %}
                {% endif %}

            {% else %}
                {# Nothing to ask. The product's policy does not track identity outbound, so
                   AutomaticSourcePicker chooses: earliest expiry first, then lowest bin sort key. #}
                <p class="lead span-2">
                    This product does not carry a batch or serial on the way out, so the rows are chosen for you:
                    <strong>earliest expiry first, then lowest bin sort key</strong>. Nothing to pick.
                </p>
            {% endif %}

            {% elseif not product %}
                <p class="lead span-2">Search for the product and pick it from the list.</p>
            {% endif %}

            <div class="form-actions span-2">
                <button type="submit" class="button primary" {{ product and reason ? '' : 'disabled' }}>Record it</button>
            </div>
        </form>
    </section>

    <script>
        /* The product search (mockup cc1f585) and the reloads that keep what was typed. */
        (function () {
            var form = document.getElementById('adjust-form');
            var products = {{ productSearch|json_encode|raw }};
            var search = document.getElementById('adjust-product-search');
            var results = document.getElementById('adjust-product-results');
            var productId = document.getElementById('adjust-product-id');
            var active = -1;

            function reload() {
                var params = new URLSearchParams();
                if (productId.value) { params.set('product', productId.value); }
                ['reason', 'warehouse_id', 'quantity', 'reference', 'note', 'occurred_at'].forEach(function (name) {
                    var field = form.elements[name];
                    if (field && field.value) { params.set(name === 'warehouse_id' ? 'warehouse' : name, field.value); }
                });
                window.location.href = form.getAttribute('data-reload-url') + '?' + params.toString();
            }
            function find(query) {
                var words = query.toLowerCase().split(/\s+/).filter(Boolean);
                return products.filter(function (p) { return words.every(function (w) { return p.text.indexOf(w) !== -1; }); }).slice(0, 40);
            }
            function draw() {
                var found = find(search.value);
                results.innerHTML = '';
                if (!found.length) {
                    var none = document.createElement('div');
                    none.className = 'muted-line';
                    none.style.padding = '7px 10px';
                    none.textContent = 'No product matches.';
                    results.appendChild(none);
                }
                found.forEach(function (p, i) {
                    var row = document.createElement('button');
                    row.type = 'button';
                    row.setAttribute('data-id', p.id);
                    row.className = i === active ? 'is-active' : '';
                    var label = document.createElement('span'); label.textContent = p.label; row.appendChild(label);
                    var meta = document.createElement('span'); meta.className = 'muted-line'; meta.textContent = p.meta; row.appendChild(meta);
                    results.appendChild(row);
                });
                results.hidden = false;
            }
            function pick(id) { productId.value = id; results.hidden = true; reload(); }

            search.addEventListener('focus', function () { search.select(); draw(); });
            search.addEventListener('input', function () { active = -1; draw(); });
            search.addEventListener('keydown', function (event) {
                var rows = results.querySelectorAll('[data-id]');
                if (event.key === 'ArrowDown') { event.preventDefault(); active = Math.min(rows.length - 1, active + 1); draw(); }
                else if (event.key === 'ArrowUp') { event.preventDefault(); active = Math.max(0, active - 1); draw(); }
                else if (event.key === 'Enter') { event.preventDefault(); var row = rows[active >= 0 ? active : 0]; if (row) { pick(row.getAttribute('data-id')); } }
                else if (event.key === 'Escape') { results.hidden = true; }
            });
            results.addEventListener('mousedown', function (event) {
                var row = event.target.closest('[data-id]');
                if (row) { event.preventDefault(); pick(row.getAttribute('data-id')); }
            });
            document.addEventListener('click', function (event) { if (!event.target.closest('.adj-search')) { results.hidden = true; } });
            document.getElementById('adjust-reason').addEventListener('change', reload);
        })();
    </script>
{% endblock %}
