# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# Dedicated file-based SQLite, separate from the dev DB (var/data_dev.db) and
# gitignored the same way (/var/). File-based (not :memory:) because Codeception's
# functional suite boots one kernel/connection for the whole suite and relies on per-test
# transaction rollback for isolation — :memory: would mean every reconnect sees an empty DB.
# PHPUnit's DoctrineIntegrationTestCase deletes and recreates this file fresh per test; the
# Functional suite's _bootstrap.php does the same once per run. Schema comes from current
# entity metadata via SchemaTool in both cases, not migrations.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"


# From: address for outbound mail. Since #366 the From: resolvers refuse to fall back to a
# placeholder domain, so a configured value is required. MAILER_FROM rather than APP_EMAIL:
# app_email doubles as a recipient in several chains, so setting it here would rewire the tests
# that exercise recipient fallback.
MAILER_FROM=no-reply@wholesale.example
