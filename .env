# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://127.0.0.1:8000
###< symfony/routing ###

###> app/domains ###
ADMIN_HOST=admin.localhost
CUSTOMER_HOST=127.0.0.1
###< app/domains ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN="null://null"
# From: address on all outbound mail. Required: the From: resolvers refuse to fall back to a
# placeholder domain (#366). A store can override per-category with the sales_email /
# support_email / app_email settings; this is the installation-wide default.
MAILER_FROM=
###< symfony/mailer ###

###> stripe ###
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
###< stripe ###

###> database console (phpLiteAdmin) ###
# Minutes the raw SQL console stays reachable per switch-on. It also slides forward on activity, so
# active use keeps it open and idle time closes it. Empty falls back to 30.
DB_CONSOLE_WINDOW_MINUTES=30
# Comma-separated IPs/CIDRs allowed to reach the console at all, checked before anything else.
# Empty means no IP restriction beyond the per-session binding to whoever opened it.
DB_CONSOLE_ALLOWED_IPS=
###< database console (phpLiteAdmin) ###

###> maxeme GoHighLevel ###
# Webhook to GHL (config/packages/maxeme.yaml maxeme.ghl). Live site only: blank sends nothing.
GHL_API_TOKEN=
GHL_LOCATION_ID=
###< maxeme GoHighLevel ###

###> symfony/messenger ###
# Doctrine transport, same connection as the app's own DB: no new infrastructure, and the queue
# survives a restart. auto_setup=0 because messenger_messages is schema-managed like every other
# table here -- see the migration that creates it -- not created on first send.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> e2e per-agent test instances (dev only) ###
# Set this in .env.local to let e2e agents each work in their own SQLite database, selected per
# request with X-Test-Key + X-Test-DB (App\Doctrine\TestInstanceConnectionFactory).
#
# Empty here on purpose: the mechanism is OFF unless this is set to at least 16 characters, and
# the decorator that implements it only exists in config/services_dev.yaml, so it cannot be
# switched on in prod by setting a variable.
TEST_INSTANCE_KEY=
###< e2e per-agent test instances (dev only) ###

###> maxeme ###
# The legacy Maxeme Auto MySQL database, read only by `app:maxeme:import-legacy`. Set it in .env.local:
# LEGACY_DATABASE_URL="mysql://root@127.0.0.1:3306/maxemead_1?serverVersion=9.1.0&charset=utf8mb4"
LEGACY_DATABASE_URL=
###< maxeme ###
